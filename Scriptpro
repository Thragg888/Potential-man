local function performBlockCheck(killerModel)
    if not AB_Cfg.Enabled or not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killerModel or not killerModel.Parent then return end
    local kRoot = killerModel:FindFirstChild("HumanoidRootPart"); if not kRoot then return end

    local look = kRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-4 then return end
    flat = flat.Unit

    local checkPart = Instance.new("Part")
    checkPart.Anchored = true; checkPart.CanCollide = false; checkPart.CanTouch = false
    checkPart.CanQuery = false; checkPart.Massless = true; checkPart.CastShadow = false
    checkPart.Transparency = 1
    checkPart.Size = Vector3.new(BoxCfg.BoxWidth, BoxCfg.BoxHeight, BoxCfg.BoxLength)
    checkPart.CFrame = CFrame.lookAt(
        kRoot.Position + flat * (BoxCfg.BoxLength * 0.5),
        kRoot.Position + flat * (BoxCfg.BoxLength * 0.5 + 1))
    checkPart.Parent = Workspace

    local inBox = false
    if lp.Character then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { lp.Character }
        inBox = #Workspace:GetPartsInPart(checkPart, params) > 0
    end
    checkPart:Destroy()

    if inBox and AB_Cfg.WallCheck then
        local myRoot = getMyRoot()
        if myRoot then
            local delta = kRoot.Position - myRoot.Position
            RAY_LOS.FilterDescendantsInstances = { lp.Character, killerModel }
            if Workspace:Raycast(myRoot.Position, delta, RAY_LOS) then inBox = false end
        end
    end
    if inBox then fireBlock() end
end

local function performAnimBlockCheck(killer, attackType)
    if not AB_Cfg.Enabled or not AB_Cfg.AnimTrigger then return end
    if not isSurvivor() or hasHelplessEffect() then return end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local qh = killer:FindFirstChild("QueryHitbox"); if not qh then return end

    local custom = CUSTOM_HITBOXES[attackType]
    local boxSize = custom and custom.Size or Vector3.new(5.2, 6, 5.65)
    local boxOffset = custom and custom.Offset or CFrame.new(0, 0, -3.5)

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.MaxParts = 1

    for _ = 1, 12 do
        if hasHelplessEffect() or not lp.Character then return end
        local myHb = lp.Character:FindFirstChild("QueryHitbox")
        if not myHb then return end
        params.FilterDescendantsInstances = { myHb }

        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.CastShadow = false
        part.Material = Enum.Material.ForceField
        part.Size = boxSize * 2.2
        part.CFrame = qh.CFrame * boxOffset
        part.Transparency = 1
        part.Parent = Workspace
        local hits = Workspace:GetPartsInPart(part, params)
        part:Destroy()
        if #hits > 0 then fireBlock(); return end
        task.wait(0.02)
    end
end

local killerAttackConns = setmetatable({}, { __mode = "k" })
local function hookKillerForAttack(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerAttackConns[killer] then return end
    local function tryHook()
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        killerAttackConns[killer] = animator.AnimationPlayed:Connect(function(track)
            if not AB_Cfg.Enabled or not AB_Cfg.AnimTrigger then return end
            if not isSurvivor() or hasHelplessEffect() then return end
            local anim = track and track.Animation; if not anim then return end
            local id = tostring(anim.AnimationId):match("(%d+)")
            local atk = id and ATTACK_ANIM_MAP[id]
            if not atk then return end
            task.spawn(function() pcall(performAnimBlockCheck, killer, atk) end)
        end)
        return true
    end
    if tryHook() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function() if tryHook() then
        if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
    end end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
        end
    end)
end

