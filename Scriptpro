HB_PARAMS.MaxParts = 1

local RAY_LOS = RaycastParams.new()
RAY_LOS.FilterType = Enum.RaycastFilterType.Exclude
RAY_LOS.IgnoreWater = true

local function isInM1Hitbox(killer, attackType)
    local qh = killer:FindFirstChild("QueryHitbox")
    local myRoot = getMyRoot()
    if not qh or not myRoot then return false end

    local custom = attackType and CUSTOM_HITBOXES[attackType]
    local size = getM1HitboxSize(attackType)
    local offset = custom and custom.Offset or BASE_HITBOX_OFFSET
    local attackCF = qh.CFrame * offset

    local rel = attackCF:PointToObjectSpace(myRoot.Position)
    local half = size * 0.5
    if math.abs(rel.X) <= half.X
       and math.abs(rel.Y) <= half.Y
       and math.abs(rel.Z) <= half.Z then
        return true
    end

    local myHb = getMyHb()
    if myHb and myHb.CanQuery then
        HB_PART.Size = size
        HB_PART.CFrame = attackCF
        HB_PARAMS.FilterDescendantsInstances = { myHb }
        if #Workspace:GetPartsInPart(HB_PART, HB_PARAMS) > 0 then
            return true
        end
    end
    return false
end

local function hmtStart(killer, attackType)
    if not HMT.Enabled then return false end
    if HMT._active then return false end
    if not killer or not killer.Parent then return false end
    if not isSurvivor() or hasHelplessEffect() then return false end

    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if isInM1Hitbox(killer, attackType) then
        fireBlockNow()
        if HMT.Debug then print("[HMT] already in range — blocked") end
        return true
    end

    local kh = killer:FindFirstChild("HumanoidRootPart")
    local qh = killer:FindFirstChild("QueryHitbox")
    if not kh or not qh then return false end
    local dist = (kh.Position - hrp.Position).Magnitude
    if dist > HMT.TriggerRange then return false end

    local custom = attackType and CUSTOM_HITBOXES[attackType]
    local offset = custom and custom.Offset or BASE_HITBOX_OFFSET
    local targetPos = (qh.CFrame * offset).Position
    local flat = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    local travelDist = (flat - hrp.Position).Magnitude
    local expectedTime = travelDist / math.max(HMT.Speed, 1)
    if expectedTime > HMT.MaxTime then
        if HMT.Debug then
            print(string.format("[HMT] too far (%.1f st / %.2fs) — skip", travelDist, expectedTime))
        end
        return false
    end

    HMT._active = true
    HMT._savedCF  = hrp.CFrame
    HMT._savedVel = hrp.AssemblyLinearVelocity
    HMT._savedAng = hrp.AssemblyAngularVelocity

    local savedWalk = hum.WalkSpeed
    hum.WalkSpeed = 0

    HMT._thread = task.spawn(function()
        local start    = tick()
        local traveled = 0
        local lastPos  = hrp.Position
        local blocked  = false
        local savedCF  = HMT._savedCF
        local savedVel = HMT._savedVel
        local savedAng = HMT._savedAng

        local ok, err = pcall(function()
            while HMT._active and tick() - start < HMT.MaxTime do
                if not killer.Parent or not hrp.Parent or hasHelplessEffect() then break end

                if isInM1Hitbox(killer, attackType) then
                    fireBlockNow(); blocked = true
                    if HMT.Debug then
                        print(string.format("[HMT] reached in %.0fms", (tick() - start) * 1000))
                    end
                    break
                end

                local qh2 = killer:FindFirstChild("QueryHitbox")
                if not qh2 then break end
                local cust2 = attackType and CUSTOM_HITBOXES[attackType]
                local off2  = cust2 and cust2.Offset or BASE_HITBOX_OFFSET
                local tgt   = (qh2.CFrame * off2).Position

                local myPos = hrp.Position
                local flat2 = Vector3.new(tgt.X, myPos.Y, tgt.Z)
                local delta = flat2 - myPos
                if delta.Magnitude < 0.5 then break end

                local step = math.min(HMT.Speed * 0.03, delta.Magnitude)
                local newPos = myPos + delta.Unit * step

                if AB_Cfg.WallCheck then
                    local wp = RaycastParams.new()
                    wp.FilterType = Enum.RaycastFilterType.Exclude
                    wp.FilterDescendantsInstances = { lp.Character, killer }
                    if Workspace:Raycast(myPos, newPos - myPos, wp) then
                        if HMT.Debug then print("[HMT] wall in path — stop") end
                        break
                    end
                end

                hrp.CFrame = CFrame.lookAt(newPos, flat2)
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                traveled = traveled + (newPos - lastPos).Magnitude
                lastPos  = newPos
                if traveled > HMT.MaxTravel then break end

                task.wait(0.03)
            end

            if not blocked and hrp.Parent and killer.Parent
               and isInM1Hitbox(killer, attackType) then
                fireBlockNow(); blocked = true
            end

            if blocked then
                for _ = 1, HMT.HoldFrames do task.wait() end
            end
        end)

        if not ok and HMT.Debug then warn("[HMT] thread error:", err) end

        if HMT.SnapBack and hrp and hrp.Parent then
            pcall(function()
                hrp.CFrame = savedCF
                hrp.AssemblyLinearVelocity  = savedVel
                hrp.AssemblyAngularVelocity = savedAng
            end)
        end
        if hum and hum.Parent then pcall(function() hum.WalkSpeed = savedWalk end) end
        HMT._active    = false
        HMT._thread    = nil
        HMT._savedCF   = nil
        HMT._savedVel  = nil
        HMT._savedAng  = nil
    end)
    return true
end

-- =========================================================
-- tryBlock — reference-style poll (12× @20ms, *2.2 hitbox)
-- =========================================================
local SELF_PARAMS = OverlapParams.new()
SELF_PARAMS.MaxParts = 1
SELF_PARAMS.FilterType = Enum.RaycastFilterType.Include

local POLL_COUNT = 12
local POLL_RATE  = 0.02

local function getProbeParent()
    return Workspace:FindFirstChild("Hitboxes") or Workspace
end

local function tryBlock(killer, attackType)
    if not killer or not killer.Parent then return end
    if not isSurvivor() or hasHelplessEffect() then return end
    if not (AB_Cfg.Enabled or HMT.Enabled) then return end

    local lname = normalizeName(attackType)
    if not BLOCKABLE[lname] then return end

    local char = lp.Character
    local myHb = char and char:FindFirstChild("QueryHitbox")
    local qh   = killer:FindFirstChild("QueryHitbox")
    local kh   = killer:FindFirstChild("HumanoidRootPart")
    local mr   = getMyRoot()
    if not myHb or not qh or not kh or not mr then return end

    local dist = (kh.Position - mr.Position).Magnitude

    -- HMT priority if enabled + in range
    if HMT.Enabled and dist <= HMT.TriggerRange then
        if hmtStart(killer, attackType) then return end
    end

    if not AB_Cfg.Enabled then return end
    if dist > AB_Cfg.MaxDistance then
        if AB_Cfg.Debug then
            print(string.format("[AB] %s from %s — out of range (%.1f)", lname, killer.Name, dist))
        end
        return
    end
    if AB_Cfg.WallCheck then
        RAY_LOS.FilterDescendantsInstances = { lp.Character, killer }
        if Workspace:Raycast(mr.Position, kh.Position - mr.Position, RAY_LOS) then
            if AB_Cfg.Debug then print("[AB] wall in LOS — skip") end
            return
        end
    end

    local custom = CUSTOM_HITBOXES[lname] or CUSTOM_HITBOXES[normalizeName(killer.Name)]
    local size   = (custom and custom.Size or BASE_HITBOX_SIZE) * HITBOX_SCALE
    local offset = custom and custom.Offset or BASE_HITBOX_OFFSET

    SELF_PARAMS.FilterDescendantsInstances = { myHb }
    local parent = getProbeParent()

    for i = 1, POLL_COUNT do
        if not AB_Cfg.Enabled then break end
        if not char.Parent or not qh.Parent then break end

        local probe = Instance.new("Part")
        probe.Name = "SCPHubBlockProbe"
        probe.Anchored = true
        probe.CanCollide = false
        probe.CanTouch = false
        probe.CanQuery = false
        probe.CastShadow = false
        probe.Massless = true
        probe.Material = Enum.Material.ForceField
        probe.Size = size
        probe.CFrame = qh.CFrame * offset
        probe.Transparency = 1
        probe.Parent = parent
        Debris:AddItem(probe, 0.4)

        local hits = Workspace:GetPartsInPart(probe, SELF_PARAMS)
        if #hits > 0 then
            local fired = fireBlockNow()
            if fired and HDT_Auto then HDT_Auto() end
            if AB_Cfg.Debug then
                print(string.format("[AB] blocked %s from %s @ %dms", lname, killer.Name, i * 20))
            end
            return
        end

        task.wait(POLL_RATE)
    end

    if AB_Cfg.Debug then
        print(string.format("[AB] %s from %s — no hit", lname, killer.Name))
    end
end

