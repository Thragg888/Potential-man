-- Animation map
-- =========================================================
local ATTACK_ANIM_MAP  = {}
local NON_M1_ANIM_IDS  = {}

local function collectAnimEntries(v, out)
    if type(v) == "string" then
        local id = v:match("(%d+)"); if id then out[#out+1] = id end
    elseif type(v) == "number" then
        out[#out+1] = tostring(v)
    elseif type(v) == "table" then
        for _, x in pairs(v) do collectAnimEntries(x, out) end
    end
end

local function buildAttackAnimMap()
    local assets = ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
    local killers = assets:FindFirstChild("Killers"); if not killers then return end
    for _, km in ipairs(killers:GetChildren()) do
        local cfg = km:FindFirstChild("Config")
        if cfg and cfg:IsA("ModuleScript") then
            local ok, data = pcall(require, cfg)
            if ok and type(data) == "table" then
                local anims = data.Animations or (data.Config and data.Config.Animations)
                if type(anims) == "table" then
                    for abilityName, animValue in pairs(anims) do
                        local lname = normalizeName(abilityName)
                        local ids = {}
                        collectAnimEntries(animValue, ids)
                        if isM1Name(lname) then
                            for _, id in ipairs(ids) do ATTACK_ANIM_MAP[id] = lname end
                        else
                            for _, id in ipairs(ids) do NON_M1_ANIM_IDS[id] = lname end
                        end
                    end
                end
            end
        end
    end
end

buildAttackAnimMap()
task.spawn(function() while true do task.wait(30); pcall(buildAttackAnimMap) end end)

local function resolveM1Anim(track)
    if not track or not track.Animation then return nil end
    local anim = track.Animation
    local id = tostring(anim.AnimationId):match("(%d+)")
    if id and NON_M1_ANIM_IDS[id] then return nil end
    if id then
        local n = ATTACK_ANIM_MAP[id]
        if n then return n end
    end
    local animName = anim.Name
    if animName and isM1Name(animName) then return normalizeName(animName) end
    return nil
end

local function getActiveM1(model)
    if not model or not model.Parent then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok or not tracks then return nil end
    for _, track in ipairs(tracks) do
        if track.IsPlaying then
            local m1 = resolveM1Anim(track)
            if m1 then return m1 end
        end
    end
    return nil
end

