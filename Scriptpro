local BoxCfg = { Enabled = false, AppearMode = "M1", Color = Color3.fromRGB(255, 60, 60), Width = 12, Height = 8, Length = 30, Transparency = 0.3, M1Boxes = 1, M1Spread = 3, M1FadeTime = 1, Debug = false, Long = {} }
local BOX_FOLDER = nil

local function ensureBoxFolder() 
    if BOX_FOLDER and BOX_FOLDER.Parent then return BOX_FOLDER end 
    local f = Workspace:FindFirstChild("SCPHub_Boxes") 
    if not f then 
        f = Instance.new("Folder")
        f.Name = "SCPHub_Boxes"
        f.Parent = Workspace 
    end 
    BOX_FOLDER = f 
    return f 
end

local lastBoxSpawn = setmetatable({}, { __mode = "k" })

local function spawnM1Boxes(killer, attackType)
    if not killer or not killer.Parent then return end
    local qh = killer:FindFirstChild("QueryHitbox")
    if not qh then return end
    
    local now = tick()
    if lastBoxSpawn[killer] and now - lastBoxSpawn[killer] < 0.1 then return end
    lastBoxSpawn[killer] = now
    
    local folder = ensureBoxFolder()
    local count = math.max(1, math.floor(BoxCfg.M1Boxes))
    
    local custom = nil
    if attackType == "golemslash" then
        custom = { Size = Vector3.new(6, 2, 7), Offset = CFrame.new(0,0,-5.5) }
    end
    local visualSize = (custom and custom.Size or Vector3.new(5.2, 6, 5.65)) * 2.2
    local baseCF = qh.CFrame * (custom and custom.Offset or CFrame.new(0,0,-3.5))
    
    for i = 1, count do
        local p = Instance.new("Part")
        p.Name = "SCPHubM1Box"
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Massless = true
        p.Material = Enum.Material.Neon
        p.Color = BoxCfg.Color
        p.Transparency = 0.15
        p.Size = visualSize
        p.CFrame = baseCF * CFrame.new((i - (count + 1) / 2) * BoxCfg.M1Spread, 0, 0)
        p.Parent = folder
        
        TweenService:Create(p, TweenInfo.new(math.max(0.3, BoxCfg.M1FadeTime), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
        Debris:AddItem(p, BoxCfg.M1FadeTime + 0.1)
    end
end

local function hookKillerM1Box(killer)
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    
    animator.AnimationPlayed:Connect(function(track) 
        if not BoxCfg.Enabled or BoxCfg.AppearMode ~= "M1" then return end
        local anim = track.Animation
        if not anim then return end
        
        local animId = tostring(anim.AnimationId):match("(%d+)")
        local atkName = getAttackName(animId, anim.Name)
        
        -- FIX: ONLY spawn if it is an actual M1 attack, ignoring Walk, Run, Idle.
        if BlockableAttacks[atkName] then
            spawnM1Boxes(killer, atkName) 
        end
    end)
end

local function destroyLongBox(killer) 
    local d = BoxCfg.Long[killer]
    if not d then return end
    if d.part and d.part.Parent then pcall(function() d.part:Destroy() end) end
    if d.hl and d.hl.Parent then pcall(function() d.hl:Destroy() end) end
    if d.conn then pcall(function() d.conn:Disconnect() end) end
    BoxCfg.Long[killer] = nil 
end

local function createLongBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyLongBox(killer)
    
    local folder = ensureBoxFolder()
    local part = Instance.new("Part")
    part.Name = "SCPHubLong_" .. killer.Name
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = BoxCfg.Color
    part.Size = Vector3.new(BoxCfg.Width, BoxCfg.Height, BoxCfg.Length)
    part.Transparency = BoxCfg.Transparency
    
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if hrp then 
        part.CFrame = CFrame.lookAt(hrp.Position + hrp.CFrame.LookVector * (BoxCfg.Length * 0.5), hrp.Position + hrp.CFrame.LookVector * (BoxCfg.Length * 0.5 + 1))
    else 
        part.CFrame = killer:GetPivot() 
    end
    part.Parent = folder
    
    local hl = Instance.new("Highlight")
    hl.Name = "SCPHubLongBoxHL"
    hl.Adornee = part
    hl.FillColor = BoxCfg.Color
    hl.OutlineColor = BoxCfg.Color
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = part
    
    local data = { part = part, hl = hl, conn = nil }
    BoxCfg.Long[killer] = data
    
    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyLongBox(killer); return end
        local h = killer:FindFirstChild("HumanoidRootPart")
        if h then 
            part.CFrame = CFrame.lookAt(h.Position + h.CFrame.LookVector * (BoxCfg.Length * 0.5), h.Position + h.CFrame.LookVector * (BoxCfg.Length * 0.5 + 1)) 
        end
        part.Size = Vector3.new(BoxCfg.Width, BoxCfg.Height, BoxCfg.Length)
        part.Color = BoxCfg.Color
        local show = BoxCfg.Enabled and BoxCfg.AppearMode == "Always"
        part.Transparency = show and BoxCfg.Transparency or 1
        if hl and hl.Parent then 
            hl.FillColor = BoxCfg.Color
            hl.OutlineColor = BoxCfg.Color
            hl.OutlineTransparency = show and 0 or 1 
        end
    end)
end

local function ensureBoxes()
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if not kf then return end
    for _, k in ipairs(kf:GetChildren()) do 
        if k:IsA("Model") then 
            if BoxCfg.Enabled and BoxCfg.AppearMode == "Always" and not BoxCfg.Long[k] then 
                createLongBox(k) 
            elseif (not BoxCfg.Enabled or BoxCfg.AppearMode ~= "Always") and BoxCfg.Long[k] then 
                destroyLongBox(k) 
            end 
        end 
    end
end

