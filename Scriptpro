local function hasHelplessEffect()
    local char = lp.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.PlatformStand then return true end
    for _, attr in ipairs({ "Helpless", "Grabbed", "Incapacitated", "BeingCarried", "Held" }) do
        if char:GetAttribute(attr) then return true end
    end
    for _, folderName in ipairs({ "StatusEffects","Status","Effects","Statuses","Debuffs","Debuff" }) do
        local folder = char:FindFirstChild(folderName)
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                local n = v.Name:lower()
                if n:find("helpless",1,true) or n:find("grabbed",1,true)
                    or n:find("held",1,true) or n:find("carried",1,true)
                    or n:find("incap",1,true) then
                    return true
                end
            end
        end
    end
    for _, folderName in ipairs({ "SpeedMultipliers","ResistanceMultipliers" }) do
        local folder = char:FindFirstChild(folderName)
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                local n = v.Name:lower()
                if n:find("helpless",1,true) or n:find("grabbed",1,true)
                    or n:find("held",1,true) or n:find("carried",1,true) then
                    return true
                end
            end
        end
    end
    return false
end

