local function kAimFindNearestSurvivor()
    local myRoot = getMyRoot(); if not myRoot or not SurvivorsFolder then return nil end
    local best, bestDist = nil, KillerUtil.AimMaxRange or 500
    for _, s in ipairs(SurvivorsFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = s, d end
            end
        end
    end
    return best
end
local function kAimPickTargetPart(survivor)
    if not survivor then return nil end
    local aimPart = survivor:FindFirstChild(KillerUtil.AimPart or "Head")
    if aimPart and aimPart:IsA("BasePart") then return aimPart end
    return survivor:FindFirstChild("HumanoidRootPart")
end
RunService:BindToRenderStep("WindHubKillerAim", Enum.RenderPriority.Camera.Value + 3, function()
    if not KillerUtil.AimEnabled or not isKiller() then return end
    if tick() > KillerUtil._aimUntil then return end
    local survivor = kAimFindNearestSurvivor(); if not survivor then return end
    local aimPart = kAimPickTargetPart(survivor); if not aimPart then return end
    local myRoot = getMyRoot(); if not myRoot then return end
    local targetPos = aimPart.Position
    local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
    if KillerUtil.AimMode == "Camera" or KillerUtil.AimMode == "HRP+Camera" then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
    end
    if KillerUtil.AimMode == "HRP" or KillerUtil.AimMode == "HRP+Camera" then
        myRoot.CFrame = CFrame.new(myRoot.Position, flat)
    end
end)

