local ESP_CFG = {
    Killers   = { Enabled=false, TextEnabled=false, FillColor=Color3.fromRGB(255,40,40),
                  OutlineColor=Color3.new(1,1,1), FillTransparency=0.55, OutlineTransparency=0 },
    Survivors = { Enabled=false, TextEnabled=false, FillColor=Color3.fromRGB(40,255,90),
                  OutlineColor=Color3.new(1,1,1), FillTransparency=0.55, OutlineTransparency=0 },
}
local ESP_TRACK = setmetatable({}, { __mode = "k" })

local function espClear(m)
    local t = ESP_TRACK[m]; if not t then return end
    for _, o in pairs(t) do if o then pcall(function() o:Destroy() end) end end
    ESP_TRACK[m] = nil
end

local function espEnsure(m, cfg, isKiller, myHrp)
    if not m or not m.Parent then espClear(m); return end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then espClear(m); return end

    if not cfg.Enabled and not cfg.TextEnabled then
        if ESP_TRACK[m] then espClear(m) end
        return
    end

    local t = ESP_TRACK[m]; if not t then t = {}; ESP_TRACK[m] = t end
    if t.Chams and not t.Chams.Parent then t.Chams = nil end

    if cfg.Enabled then
        if not t.Chams then
            local h = Instance.new("Highlight")
            h.Adornee = m
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = m
            t.Chams = h
        end
        t.Chams.FillColor = cfg.FillColor
        t.Chams.OutlineColor = cfg.OutlineColor
        t.Chams.FillTransparency = cfg.FillTransparency
        t.Chams.OutlineTransparency = cfg.OutlineTransparency
    elseif t.Chams then
        pcall(function() t.Chams:Destroy() end); t.Chams = nil
    end

    if t.Billboard and not t.Billboard.Parent then t.Billboard = nil; t.Label = nil end
    local showText = cfg.TextEnabled and cfg.Enabled
    if showText then
        if not t.Billboard then
            local bb = Instance.new("BillboardGui")
            bb.Name = "SCPHub_ESPText"
            bb.Size = UDim2.new(0, 200, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.Parent = m
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextStrokeTransparency = 0
            lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
            lbl.Font = Enum.Font.FredokaOne
            lbl.TextScaled = true
            lbl.Parent = bb
            t.Billboard = bb
            t.Label = lbl
        end
        local hrp = m:FindFirstChild("HumanoidRootPart")
        local dist = 0
        if hrp and myHrp then
            dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
        end
        t.Label.Text = string.format("%s %s [%d]", isKiller and "[K]" or "[S]", m.Name, dist)
        t.Label.TextColor3 = cfg.FillColor
    elseif t.Billboard then
        pcall(function() t.Billboard:Destroy() end)
        t.Billboard = nil; t.Label = nil
    end
end

