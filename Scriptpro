    PulseAlpha   = 0.35,

    CircleColor  = Color3.fromRGB(80, 200, 255),
    CircleRadius = 12,
    CircleHeight = 0.35,
    CircleOffset = 3.45,

    boxes   = {},
    circles = {},
}

local OVERLAP = OverlapParams.new()
OVERLAP.FilterType = Enum.RaycastFilterType.Include
local function refreshOverlapFilter()
    OVERLAP.FilterDescendantsInstances = lp.Character and { lp.Character } or {}
end
lp.CharacterAdded:Connect(function() task.wait(0.1); refreshOverlapFilter() end)
refreshOverlapFilter()

local function destroyBox(killer)
    local data = FacingVisual.boxes[killer]
    if not data then return end
    if data.part and data.part.Parent then pcall(function() data.part:Destroy() end) end
    if data.conn then pcall(function() data.conn:Disconnect() end) end
    FacingVisual.boxes[killer] = nil
end

local function destroyCircle(killer)
    local data = FacingVisual.circles[killer]
    if not data then return end
    if data.adornment and data.adornment.Parent then pcall(function() data.adornment:Destroy() end) end
    FacingVisual.circles[killer] = nil
end

local function createCircle(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyCircle(killer)
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local adorn = Instance.new("CylinderHandleAdornment")
    adorn.Name        = "WindHubFacingCircle"
    adorn.Adornee     = hrp
    adorn.AlwaysOnTop = true
    adorn.ZIndex      = 2
    adorn.Radius      = FacingVisual.CircleRadius or 12
    adorn.Height      = FacingVisual.CircleHeight or 0.35
    adorn.Color3      = FacingVisual.CircleColor
    adorn.Transparency = 0.35
    adorn.Parent      = hrp
    FacingVisual.circles[killer] = { adornment = adorn }
end

local function applyBoxAppearance(data)
    if not data or not data.highlight or not data.highlight.Parent then return end
    local hl = data.highlight
    local showBox = FacingVisual.VisualEnabled
        and (FacingVisual.ShapeMode == "Box" or FacingVisual.ShapeMode == "Both")
    hl.OutlineColor        = FacingVisual.BoxColor
    hl.OutlineTransparency = showBox and (FacingVisual.BoxOutlineTransparency or 0) or 1
    if FacingVisual.BoxFillEnabled and showBox then
        hl.FillColor        = FacingVisual.BoxFillColor
        hl.FillTransparency = FacingVisual.BoxFillTransparency or 0.55
    else
        hl.FillTransparency = 1
    end
    if FacingVisual.PulseEnabled and showBox then
        local t = tick() * (FacingVisual.PulseSpeed or 2)
        local a = (math.sin(t) * 0.5 + 0.5) * (FacingVisual.PulseAlpha or 0.35)
        hl.FillColor        = FacingVisual.PulseColor
        hl.FillTransparency = 1 - a
    end
end

local function createBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyBox(killer)
    local part = Instance.new("Part")
    part.Name         = "WindHubDetectionBox"
    part.Anchored     = true
    part.CanCollide   = false
    part.CanQuery     = false
    part.CanTouch     = false
    part.Massless     = true
    part.CastShadow   = false
    part.Transparency = FacingVisual.BoxTransparency or 1
    local mat = Enum.Material.ForceField
    pcall(function() mat = Enum.Material[FacingVisual.BoxMaterial] or Enum.Material.ForceField end)
    part.Material = mat
    part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    part.Parent = killer

    local hl = Instance.new("Highlight")
    hl.Name = "WindHubDetectionHighlight"
    hl.FillTransparency = 1
    hl.OutlineColor = FacingVisual.BoxColor
    hl.OutlineTransparency = 1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = part

    local data = { part = part, highlight = hl, conn = nil }
    FacingVisual.boxes[killer] = data
    applyBoxAppearance(data)

    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyBox(killer); return end
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then return end
        flat = flat.Unit
        part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
        part.CFrame = CFrame.lookAt(
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5),
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5 + 1)
        )
        applyBoxAppearance(data)
    end)
end

local function ensureVisualsFor(killer)
    createBox(killer)
    if FacingVisual.ShapeMode == "Circle" or FacingVisual.ShapeMode == "Both" then
        createCircle(killer)
    else
        destroyCircle(killer)
    end
end

local function refreshVisualToggle()
    local showCircle = FacingVisual.VisualEnabled
        and (FacingVisual.ShapeMode == "Circle" or FacingVisual.ShapeMode == "Both")
    for _, data in pairs(FacingVisual.boxes) do applyBoxAppearance(data) end
    for _, data in pairs(FacingVisual.circles) do
        if data.adornment and data.adornment.Parent then
            data.adornment.Transparency = showCircle and 0.35 or 1
        end
    end
end

