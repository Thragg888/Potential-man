-- Killer hooks (block + box)
-- =========================================================
local killerBlockConns = setmetatable({}, { __mode = "k" })
local killerM1Conns    = setmetatable({}, { __mode = "k" })

local function hookKillerForBlock(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerBlockConns[killer] then return end

    local function setup()
        if killerBlockConns[killer] then return false end
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end

        local conn = animator.AnimationPlayed:Connect(function(track)
            if not AB_Cfg.Enabled then return end
            local anim = track and track.Animation
            if not anim then return end
            local animId = tostring(anim.AnimationId):match("(%d+)")
            if not animId then return end
            local atkName = ATTACK_ANIM_MAP[animId]
            if not atkName or not BLOCKABLE[atkName] then return end
            task.spawn(tryBlock, killer, atkName)
        end)
        killerBlockConns[killer] = conn

        -- clear on animator destroy so a re-hook can occur
        animator.Destroying:Once(function()
            if killerBlockConns[killer] == conn then
                pcall(function() conn:Disconnect() end)
                killerBlockConns[killer] = nil
            end
        end)
        return true
    end

    if setup() then return end

    local c1, c2
    c1 = killer.ChildAdded:Connect(function()
        if setup() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and setup() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
end

local function hookKillerForM1(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerM1Conns[killer] then return end

    local function setup()
        if killerM1Conns[killer] then return false end
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end

        local conn = animator.AnimationPlayed:Connect(function(track)
            if not BoxCfg.Enabled or BoxCfg.AppearMode ~= "M1" then return end
            local m1 = resolveM1Anim(track)
            if m1 then spawnM1Boxes(killer, "anim", m1) end
        end)
        killerM1Conns[killer] = conn

        animator.Destroying:Once(function()
            if killerM1Conns[killer] == conn then
                pcall(function() conn:Disconnect() end)
                killerM1Conns[killer] = nil
            end
        end)
        return true
    end

    if setup() then return end

    local c1, c2
    c1 = killer.ChildAdded:Connect(function()
        if setup() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and setup() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
end

