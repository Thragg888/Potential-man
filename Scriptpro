        -- Only skip if it EXISTS and has text (meaning "on cooldown").
        if not cooldown or cooldown.Text == "" then
            fireBlockNow()
        end
    end
end

-- =========================================================
-- MEOWSAKEN FACING CIRCLE VISUAL  (FIXED — renders as flat disk)
-- =========================================================
local facingVisualOn = false
local facingVisuals = {} 

local function updateFacingVisual(killer, visual)
    if not (killer and visual and visual.Parent) then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dot = math.clamp(customFacingDot or -0.3, -1, 1)
    local angle = math.acos(dot)              
    local frac = angle / math.pi              

    local minFrac = 0.20                      
    local radius = math.max(1, AB_Cfg.Range * (minFrac + (1 - minFrac) * frac))
    visual.Radius = radius
    visual.Height = 0.12

    local forwardDist = AB_Cfg.Range * (0.35 + 0.15 * frac)
    -- FIX #1: clamp Y so a bloated HRP (hitbox expander) doesn't sink the disk underground
    local yOffset = -(math.min(hrp.Size.Y, 3) / 2 + 0.05)
    -- FIX #2: CylinderHandleAdornment's axis is X. Rotate around Z (not X) so the cylinder
    -- axis points UP and renders as a flat disk on the floor — NOT a horizontal bar.
    visual.CFrame = CFrame.new(0, yOffset, -forwardDist) * CFrame.Angles(0, 0, math.rad(90))

    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local inRange, facing = false, false

    if myRoot and hrp then
        local dist = (hrp.Position - myRoot.Position).Magnitude
        inRange = dist <= AB_Cfg.Range
        if inRange then facing = isFacing(myRoot, hrp) end
    end

    -- FIX #3: color-coded states so you can visually verify the facing check
    if inRange and facing then
        visual.Color3 = Color3.fromRGB(0, 255, 0)      -- GREEN: block WILL fire
        visual.Transparency = 0.30
    elseif inRange then
        visual.Color3 = Color3.fromRGB(255, 0, 0)      -- RED: in range but facing fails
        visual.Transparency = 0.45
    else
        visual.Color3 = Color3.fromRGB(255, 255, 0)    -- YELLOW: out of range
        visual.Transparency = 0.80
    end
end

local function addFacingVisual(killer)
    if not killer or not killer:IsA("Model") then return end
    local existing = facingVisuals[killer]
    if existing and existing.Parent then return end
    facingVisuals[killer] = nil  -- clear stale entry

    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local visual = Instance.new("CylinderHandleAdornment")
    visual.Name = "FacingCheckVisual"
    visual.Adornee = hrp
    visual.AlwaysOnTop = true
    visual.ZIndex = 2
    visual.Transparency = 0.55
    visual.Color3 = Color3.fromRGB(255, 255, 0) 

    visual.Parent = hrp
    facingVisuals[killer] = visual

    updateFacingVisual(killer, visual)
end

local function removeFacingVisual(killer)
    local v = facingVisuals[killer]
    if v then
        pcall(function() v:Destroy() end)
        facingVisuals[killer] = nil
    end
end

-- FIX #4: RenderStepped loop now respects `facingVisualOn` so toggling off
