local ATTACK_ANIM_MAP = {}
local function buildAttackAnimMap()
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local killers = assets and assets:FindFirstChild("Killers")
    if not killers then return end
    for _, km in ipairs(killers:GetChildren()) do
        local cfg = km:FindFirstChild("Config")
        if cfg and cfg:IsA("ModuleScript") then
            local ok, data = pcall(require, cfg)
            if ok and type(data) == "table" then
                local anims = data.Animations or (data.Config and data.Config.Animations)
                if type(anims) == "table" then
                    for abilityName, animValue in pairs(anims) do
                        local lname = string.lower(abilityName)
                        local ids = {}
                        local function collect(v)
                            if type(v) == "string" then local id = v:match("(%d+)"); if id then table.insert(ids, id) end
                            elseif type(v) == "number" then table.insert(ids, tostring(v))
                            elseif type(v) == "table" then for _, x in pairs(v) do collect(x) end end
                        end
                        collect(animValue)
                        for _, id in ipairs(ids) do ATTACK_ANIM_MAP[id] = lname end
                    end
                end
            end
        end
    end
end
buildAttackAnimMap()
task.spawn(function() while true do task.wait(30); pcall(buildAttackAnimMap) end end)

local function getAttackName(animId, animName)
    local mapped = ATTACK_ANIM_MAP[tostring(animId)]
    if mapped then return mapped end
    return string.lower(animName or "")
end

