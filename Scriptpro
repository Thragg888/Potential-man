local function pressSkillKey() 
    local now = tick()
    if now - SKILL_UI.lastPress < 0.05 then return end
    SKILL_UI.lastPress = now
    pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game); task.wait(0.03); VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end) 
end

local function handleSkillCheck()
    local ui = findSkillCheckUI()
    if not ui then return false end
    if AUTOGEN.SkillCheckSpamMode then pressSkillKey(); return true end
    local needle, zone
    for _, d in ipairs(ui:GetDescendants()) do 
        local n = d.Name:lower()
        if not needle and (n:find("needle") or n:find("pointer") or n:find("marker")) then needle = d end
        if not zone and (n:find("zone") or n:find("target") or n:find("success") or n:find("hit")) then zone = d end 
    end
    if needle and zone then 
        if needle.Rotation ~= nil and zone.Rotation ~= nil then 
            local nr = needle.Rotation % 360
            local zr = zone.Rotation % 360
            local zs = (zone.Size and math.abs(zone.Size.X.Scale * 360)) or 30
            local diff = math.abs((nr - zr + 180) % 360 - 180)
            if diff <= math.max(zs / 2, 8) then pressSkillKey() end
            return true 
        end
        if needle.AbsolutePosition and zone.AbsolutePosition then 
            local np = needle.AbsolutePosition.X + needle.AbsoluteSize.X / 2
            local zp = zone.AbsolutePosition.X
            local zw = zone.AbsoluteSize.X
            if np >= zp and np <= zp + zw then pressSkillKey() end
            return true 
        end 
    end
    local btn = ui:FindFirstChildWhichIsA("TextButton", true) or ui:FindFirstChildWhichIsA("ImageButton", true)
    if btn and firesignalF then pcall(firesignalF, btn.MouseButton1Click); return true end
    pressSkillKey()
    return true
end

local function autogenLoop()
    if AUTOGEN._thread then pcall(task.cancel, AUTOGEN._thread); AUTOGEN._thread = nil end
    if not AUTOGEN.Enabled then return end
    AUTOGEN._thread = task.spawn(function()
        while AUTOGEN.Enabled do
            pcall(function()
                if AUTOGEN.SkillCheckEnabled and handleSkillCheck() then return end
                
                -- ANTI-CHEAT FIX: Only fire if the puzzle UI is active
                if not isPuzzleActive() then return end
                
                local map = getIngameMap()
                local mr = getMyRoot()
                if not map or not mr then return end
                
                local pos = mr.Position
                local gens = {}
                pcall(function() gens = map:QueryDescendants("Model#Generator:has(#Main)") end)
                
                for _, obj in ipairs(gens) do 
                    local main = obj:FindFirstChild("Main")
                    local prog = obj:FindFirstChild("Progress")
                    if main and main:IsA("BasePart") and (main.Position - pos).Magnitude <= AUTOGEN.MaxDistance and (not prog or prog.Value ~= 100) then 
                        
