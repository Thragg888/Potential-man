            local name = lp.Character:GetAttribute("CharacterName") or lp.Character.Name
            local skin = lp.Character:GetAttribute("SkinName") or ""
            if AbilityHook._registered == 0 or name ~= AbilityHook._lastName or skin ~= AbilityHook._lastSkin then
                AbilityHook._lastName = name; AbilityHook._lastSkin = skin
                loadCharacterAnims(); bindAnimWatch()
            end
        end
    end
end)

local autoRotRestored = true
pcall(RunService.UnbindFromRenderStep, RunService, "SCPHubAim")
RunService:BindToRenderStep("SCPHubAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not Camera then Camera = Workspace.CurrentCamera end
    if not Camera then
        if not autoRotRestored then restoreAutoRotate(); autoRotRestored = true end
        return
    end
    local aimActive = AIM.Enabled or (tick() < (AIM._aimUntil or 0))
    if not isPlayingSurvivor() or not aimActive or not AIM.CachedTargetHRP or not AIM.CachedTargetHRP.Parent then
        if not autoRotRestored then restoreAutoRotate(); autoRotRestored = true end
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local mr = getMyRoot()
    if not mr then
        if not autoRotRestored then restoreAutoRotate(); autoRotRestored = true end
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end
    if AIM.CurrentAbility and AIM.CachedTargetHRP.Parent then
        local killer = AIM.CachedTargetHRP.Parent
        local ov = STUN_BY_ABILITY[AIM.CurrentAbility]
        if ov then
            if ov.AimPart and ov.AimPart ~= "HumanoidRootPart" then
                local p = killer:FindFirstChild(ov.AimPart)
                if p and p:IsA("BasePart") then targetPos = p.Position end
            end
            if ov.Ballistic then targetPos = ballisticAim(targetPos, 80, workspace.Gravity) end
        end
    end
    local smooth = AIM.Smooth or 1
    local alpha = (smooth >= 0.999) and 1 or (1 - math.exp(-dt * math.clamp(smooth * 30, 2, 60)))
    local mode = AIM.AimMode
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(safeLookAt(Camera.CFrame.Position, targetPos), alpha)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        disableAutoRotate(); autoRotRestored = false
        local flat = Vector3.new(targetPos.X, mr.Position.Y, targetPos.Z)
        local delta = flat - mr.Position
        if delta.Magnitude > 0.05 then
            mr.CFrame = mr.CFrame:Lerp(safeLookAt(mr.Position, flat), alpha)
        end
    elseif not autoRotRestored then
        restoreAutoRotate(); autoRotRestored = true
    end
    if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
end)

