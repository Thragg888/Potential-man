local function isSurvivor() return getMyRole() == "Survivors" end

local function hasHelplessEffect()
    local char = lp.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    if char:GetAttribute("Helpless") then return true end
    if char:GetAttribute("Grabbed") then return true end
    if char:GetAttribute("Incapacitated") then return true end
    if char:GetAttribute("BeingCarried") then return true end
    if hum.PlatformStand then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.AssemblyLinearVelocity.Magnitude < 2 then return true end
    end
    return false
end

