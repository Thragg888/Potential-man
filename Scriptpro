local function getMyRoot()
    local c = lp.Character
    if c == cachedChar then return cachedRoot end
    cachedChar = c
    cachedRoot = c and c:FindFirstChild("HumanoidRootPart") or nil
    cachedHb   = c and c:FindFirstChild("QueryHitbox") or nil
    return cachedRoot
