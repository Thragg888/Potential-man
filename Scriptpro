                local back = -look
                local half = math.rad(AntiBS.Angle/2)
                local apex = hrp.Position + back * AntiBS.Range - Vector3.new(0,0.8,0)
                local lv = (CFrame.new(Vector3.zero, look) * CFrame.Angles(0,  half, 0)).LookVector
                local rv = (CFrame.new(Vector3.zero, look) * CFrame.Angles(0, -half, 0)).LookVector
                local ext = AntiBS.Range * 90 / math.max(AntiBS.Angle, 10)
                local lp2, rp2 = apex + lv*ext, apex + rv*ext
                local y = Color3.fromRGB(255,255,0)
                abLine("FrameCenterToLeft",  apex, lp2, y)
