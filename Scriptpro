local function hasLineOfSight(targetPart)
    if not wallCheckEnabled then return true end
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetPart then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = { myChar }
    local km = targetPart:FindFirstAncestorOfClass("Model")
    if km then table.insert(exclude, km) end
    rp.FilterDescendantsInstances = exclude
    rp.IgnoreWater = true
    return Workspace:Raycast(myRoot.Position, targetPart.Position - myRoot.Position, rp) == nil
end

