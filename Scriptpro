local ESP_TRACK = setmetatable({}, { __mode = "k" })

local function espHRP(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) end
local function espClear(m)
    local t = ESP_TRACK[m]; if not t then return end
    for _, o in pairs(t) do if o then pcall(function() o:Destroy() end) end end
    ESP_TRACK[m] = nil
end
local function espEnsure(m, cfg)
    if not m or not m.Parent then espClear(m); return end
    local hrp = espHRP(m); if not hrp then espClear(m); return end
    local t = ESP_TRACK[m]; if not t then t = {}; ESP_TRACK[m] = t end
    if t.Box and not t.Box.Parent then t.Box = nil end
    if t.Chams and not t.Chams.Parent then t.Chams = nil end
    if t.BB and not t.BB.Parent then t.BB = nil end
    if cfg.Box then
        if not t.Box then
            t.Box = Instance.new("BoxHandleAdornment")
            t.Box.Adornee = hrp; t.Box.AlwaysOnTop = true; t.Box.ZIndex = 1
            t.Box.Size = Vector3.new(2.2, 5.5, 2.2); t.Box.Transparency = 0.4
            t.Box.Parent = hrp
        end
        t.Box.Color3 = cfg.OutlineColor
    elseif t.Box then pcall(function() t.Box:Destroy() end); t.Box = nil end
    if cfg.Chams then
        if not t.Chams then
            t.Chams = Instance.new("Highlight")
            t.Chams.Adornee = m; t.Chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            t.Chams.Parent = m
        end
        t.Chams.FillColor = cfg.FillColor
        t.Chams.OutlineColor = cfg.OutlineColor
        t.Chams.FillTransparency = cfg.FillTransparency
        t.Chams.OutlineTransparency = cfg.OutlineTransparency
    elseif t.Chams then pcall(function() t.Chams:Destroy() end); t.Chams = nil end
    if cfg.Name or cfg.Distance then
        if not t.BB then
            local head = m:FindFirstChild("Head") or hrp
            t.BB = Instance.new("BillboardGui")
            t.BB.Adornee = head; t.BB.Size = UDim2.new(0,200,0,50)
            t.BB.StudsOffset = Vector3.new(0,3,0); t.BB.AlwaysOnTop = true
            t.BB.MaxDistance = cfg.MaxDistance; t.BB.Parent = head
            local l = Instance.new("TextLabel")
            l.Name = "L"; l.BackgroundTransparency = 1
            l.Size = UDim2.new(1,0,1,0); l.Font = Enum.Font.SourceSansBold
            l.TextScaled = true; l.TextStrokeTransparency = 0.3
            l.TextStrokeColor3 = Color3.new(0,0,0); l.Text = ""; l.Parent = t.BB
        end
        local l = t.BB:FindFirstChild("L")
        if l then
            local mr = getMyRoot()
            local dist = mr and (hrp.Position - mr.Position).Magnitude or 0
            local parts = {}
            if cfg.Name then table.insert(parts, m.Name) end
            if cfg.Distance then table.insert(parts, "["..math.floor(dist).." studs]") end
            l.Text = table.concat(parts, "\n"); l.TextColor3 = cfg.TextColor
        end
    elseif t.BB then pcall(function() t.BB:Destroy() end); t.BB = nil end
end

