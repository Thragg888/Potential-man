-- Reject sounds whose Name looks like a non-M1 ability.
-- Catches "Behead-Hit", "Behead_Hit", "Gashing Wound", etc.
local function soundNameIsBlocked(sound)
    local n = normalizeName(sound.Name)
    if n == "" then return false end
    for _, kw in ipairs(M1_BLOCKLIST) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

