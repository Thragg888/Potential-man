local espMedkitActive, espBloxyActive, espGeneratorsActive = false, false, false
local medkitHighlights, bloxyHighlights = {}, {}
local generatorProgConns = {}

local function clearList(list)
    for _, h in ipairs(list) do if h and h.Parent then h:Destroy() end end
    return {}
end

local function createHighlight(model, color, list)
    if not model or not model:FindFirstChild("HumanoidRootPart") then return end
    local h = Instance.new("Highlight")
    h.Adornee = model; h.FillColor = color; h.OutlineColor = color
    h.FillTransparency = 0.65; h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
    table.insert(list, h)
end

local function applyItemHighlight(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    local name = item.Name
    local isMed = (name == "Medkit"    and espMedkitActive)
    local isBlx = (name == "BloxyCola" and espBloxyActive)
    if not (isMed or isBlx) then return end
    local target = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not target or target:FindFirstChild("ItemHighlight") then return end
    local h = Instance.new("Highlight")
    h.Name = "ItemHighlight"; h.Adornee = item
    h.FillTransparency = 0.5; h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if isMed then
        h.FillColor = Color3.fromRGB(255,105,180); h.OutlineColor = Color3.fromRGB(255,105,180)
        table.insert(medkitHighlights, h)
    else
        h.FillColor = Color3.fromRGB(0,150,255); h.OutlineColor = Color3.fromRGB(0,150,255)
        table.insert(bloxyHighlights, h)
    end
    h.Parent = target
end

local function scanItems(name)
    if name == "Medkit" then medkitHighlights = clearList(medkitHighlights)
    else bloxyHighlights = clearList(bloxyHighlights) end
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item.Name == name then applyItemHighlight(item) end
    end
end

local function espAttachGenerator(obj)
    if not obj or not obj.Parent then return end
    local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not root then return end
    local h = Instance.new("Highlight")
    h.Name = "esp_g"; h.FillColor = Color3.fromRGB(255,255,0)
    h.OutlineColor = Color3.fromRGB(255,255,0)
    h.FillTransparency = 0.6; h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = obj; h.Parent = obj
    local bb = Instance.new("BillboardGui")
    bb.Name = "esp_g_bb"; bb.Adornee = root
    bb.Size = UDim2.new(0,100,0,20); bb.StudsOffset = Vector3.new(0,3.8,0)
    bb.AlwaysOnTop = true; bb.Parent = obj
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(255,255,0); lbl.TextStrokeTransparency = 0.5
    lbl.TextSize = 15; lbl.Font = Enum.Font.SourceSansBold; lbl.Parent = bb
    local prog = obj:FindFirstChild("Progress")
    if prog and prog:IsA("NumberValue") then
        lbl.Text = "Generator (" .. math.floor(prog.Value) .. "%)"
        generatorProgConns[obj] = prog.Changed:Connect(function()
            if lbl.Parent then lbl.Text = "Generator (" .. math.floor(prog.Value) .. "%)" end
        end)
    end
end

local function espDoGenerators(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if on then espAttachGenerator(obj)
            else
                local h = obj:FindFirstChild("esp_g");    if h then h:Destroy() end
                local b = obj:FindFirstChild("esp_g_bb"); if b then b:Destroy() end
                if generatorProgConns[obj] then generatorProgConns[obj]:Disconnect(); generatorProgConns[obj] = nil end
            end
        end
    end
end

