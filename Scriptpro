        if track.TimePosition > TRIGGER_WINDOW then return end
        local now = tick()
        if now - (AbilityHook._lastFire or 0) < (AbilityHook.Cooldown or 1) then return end
        AbilityHook._lastFire = now
        AimFor((info.Lock or 1) * (AIM.LockTime or 1), info.Ability)
    end)
