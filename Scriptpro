local CHANCE_KILLER_NAMES = {
    ["jason"]=true, ["c00lkidd"]=true, ["johndoe"]=true, ["1x1x1x1"]=true,
    ["noli"]=true, ["slasher"]=true, ["nosferatu"]=true, ["azure"]=true,
