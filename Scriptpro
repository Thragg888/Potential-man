local function chanceMatchesAbility(btn)
    local blobs = {}
    pcall(function()
        table.insert(blobs, string.lower(tostring(btn.Name or "")))
        if btn:IsA("TextButton") or btn:IsA("TextLabel") then table.insert(blobs, string.lower(tostring(btn.Text or ""))) end
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                table.insert(blobs, string.lower(tostring(d.Text or "")))
                table.insert(blobs, string.lower(tostring(d.Name or "")))
            end
