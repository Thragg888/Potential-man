-- ==========================================
-- KILLER STATE + FLICK DETECTION
-- ==========================================
RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    local folder = getKillersFolder()
    if not folder then return end
    for _, k in ipairs(folder:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp then
            local st = killerState[k] or { prevPos = hrp.Position, prevLook = hrp.CFrame.LookVector, vel = Vector3.new(), angVel = 0, rawAngVel = 0 }
            st.vel = (hrp.Position - st.prevPos) / math.max(dt, 1e-6)
            st.prevPos = hrp.Position

            local prevLook = st.prevLook or hrp.CFrame.LookVector
            local currLook = hrp.CFrame.LookVector
            local dot      = math.clamp(prevLook:Dot(currLook), -1, 1)
            local angle    = math.acos(dot)
            local crossY   = prevLook:Cross(currLook).Y
            local sign     = (crossY >= 0) and 1 or -1
            local rawAngVel = (angle / math.max(dt, 1e-6)) * sign
            st.rawAngVel = rawAngVel
            st.angVel = (st.angVel or 0) * 0.78 + rawAngVel * 0.22
            st.prevLook = currLook

            if flickProtectionEnabled then
                local degPerSec = math.abs(rawAngVel) * (180 / math.pi)
                if degPerSec > flickDegPerSecThreshold then
                    flickData[k] = { lastFlickTick = tick() }
                end
            end

            killerState[k] = st
        end
    end
end)

