local ESP_CFG = {
    Killers   = { Enabled=false, TextEnabled=false, FillColor=Color3.fromRGB(255,40,40),
                  OutlineColor=Color3.new(1,1,1), FillTransparency=0.55, OutlineTransparency=0 },
