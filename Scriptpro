local function startDrag(target)
    if not target or not target.Parent then return end
    if hasHelplessEffect() then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (target.Position - hrp.Position).Magnitude <= HDT.StopDistance + 0.5 then return end
    HDT._dragId += 1
    local myId = HDT._dragId
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    HDT._dragging = true
    local saved = { walk=hum.WalkSpeed, auto=hum.AutoRotate }
    hum.WalkSpeed = 0; hum.AutoRotate = false
    local fin = false
    local function cleanup()
        if fin then return end
        fin = true
        if HDT._dragId ~= myId then return end
        HDT._dragging = false
        HDT._cooldownUntil = tick() + (HDT.Cooldown or 27)
        if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = saved.walk
                hum.AutoRotate = saved.auto
            end)
        end
    end
    HDT._conn = RunService.Heartbeat:Connect(function(dt)
        if hasHelplessEffect() then cleanup(); return end
        if HDT._dragId ~= myId or not HDT._dragging then cleanup(); return end
        if not (char and char.Parent and target and target.Parent) then cleanup(); return end
        local mp = hrp.Position
        local flat = Vector3.new(target.Position.X, mp.Y, target.Position.Z)
        local delta = flat - mp
        local dist = delta.Magnitude
        if dist <= HDT.StopDistance then cleanup(); return end
        local step = math.min(HDT.Speed * dt, dist - HDT.StopDistance)
        hrp.CFrame = CFrame.lookAt(mp + delta.Unit * step, flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.delay(HDT.DragDuration, function()
        if HDT._dragId == myId and HDT._dragging then cleanup() end
    end)
end
HDT_Trigger = function(force)
    if not force and not HDT.Enabled then return end
    if hasHelplessEffect() then return end
    if tick() < HDT._cooldownUntil or HDT._dragging then return end
    if tick() - HDT._lastFire < 0.15 then return end
    local target = nearestKillerPart(); if not target then return end
    local mr = getMyRoot()
    if mr then
        local d = (target.Position - mr.Position).Magnitude
        if d <= HDT.StopDistance + 0.5 or d > HDT.MaxRange then return end
    end
    HDT._lastFire = tick()
    startDrag(target)
end

