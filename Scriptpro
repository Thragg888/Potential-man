    for _, obj in ipairs(gens) do
        local prog = obj:FindFirstChild("Progress")
        local main = obj:FindFirstChild("Main")
        if prog and prog.Value ~= 100 and main
           and (main.Position - pos).Magnitude <= AUTOGEN.MaxDistance then
            local remotes = obj:FindFirstChild("Remotes")
            local re = remotes and remotes:FindFirstChildOfClass("RemoteEvent")
            if re then pcall(function() re:FireServer() end) end
        end
    end
end
local function autogenLoop()
    if AUTOGEN._thread then pcall(task.cancel, AUTOGEN._thread); AUTOGEN._thread = nil end
    if not AUTOGEN.Enabled then return end
    AUTOGEN._thread = task.spawn(function()
        while AUTOGEN.Enabled do
            pcall(autogenFireOnce)
            local t = os.clock() + math.max(AUTOGEN.Interval, 0.1)
            while AUTOGEN.Enabled and os.clock() < t do RunService.Heartbeat:Wait() end
        end
        AUTOGEN._thread = nil
    end)
end

