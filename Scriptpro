-- Block firing
local lastBlockFire = 0
local CFG = { AutoBlockEnabled = false, WallCheck = true, SoundTrigger = true, AnimTrigger = true }
local BLOCK_METHOD = nil

local function trySignalBlock()
    if not firesignalF then return false end
    if not MainUI or not MainUI:FindFirstChild("AbilityContainer") then return false end
    local btn = MainUI.AbilityContainer:FindFirstChild("Block")
    if not btn or not btn:IsA("GuiButton") then return false end
    return pcall(firesignalF, btn.MouseButton1Click)
end
local function tryRemoteBlock()
    if not RemoteEvent then return false end
    local ok = pcall(function() RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF }) end)
    if ok then return true end
    return pcall(function() RemoteEvent:FireServer("UseActorAbility", "Block") end)
end
local function fireBlock()
    if hasHelplessEffect() then return false end
    local now = tick()
    if now - lastBlockFire < 0.01 then return false end
    lastBlockFire = now
    local fired
    if BLOCK_METHOD == "signal" then
        fired = trySignalBlock()
        if not fired then BLOCK_METHOD = "remote"; fired = tryRemoteBlock() end
    elseif BLOCK_METHOD == "remote" then
        fired = tryRemoteBlock()
        if not fired then BLOCK_METHOD = "signal"; fired = trySignalBlock() end
    else
        fired = trySignalBlock()
        if fired then BLOCK_METHOD = "signal"
        else fired = tryRemoteBlock(); if fired then BLOCK_METHOD = "remote" end end
    end
    return fired
end

