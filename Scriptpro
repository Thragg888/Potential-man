        blob = blob:gsub("%s+", " ")
        for _, kw in ipairs(CHANCE_ABILITY_KEYWORDS) do
            if blob:find(kw, 1, true) then
                if kw == "shot" or kw == "gun" or kw == "shoot" then
                    if blob:find("oneshot", 1, true) or blob:find("one shot", 1, true)
                        or blob:find("flint", 1, true) or blob:find("chance", 1, true)
                        or blob:find("pistol", 1, true) or blob:find("revolver", 1, true) then
                        return true
                    end
