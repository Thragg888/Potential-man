local ESP_CFG = {
    Killers   = { Enabled = true, Box = true, Chams = true, Name = true, Distance = true, Tracer = false,
                  FillColor = Color3.fromRGB(255, 40, 40), OutlineColor = Color3.fromRGB(255, 255, 255),
                  TextColor = Color3.fromRGB(255, 200, 200), TracerColor = Color3.fromRGB(255, 60, 60),
                  MaxDistance = 1500 },
    Survivors = { Enabled = true, Box = true, Chams = true, Name = true, Distance = true, Tracer = false,
                  FillColor = Color3.fromRGB(40, 255, 90), OutlineColor = Color3.fromRGB(255, 255, 255),
                  TextColor = Color3.fromRGB(200, 255, 200), TracerColor = Color3.fromRGB(60, 255, 100),
                  MaxDistance = 1500 },
    Generators = { Enabled = false },
    Items      = { Enabled = false },
}
local ESP_TRACK = setmetatable({}, { __mode = "k" })
local function espGetHRP(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) end
local function espTrackTable(model)
    local t = ESP_TRACK[model]; if not t then t = {}; ESP_TRACK[model] = t end
    return t
end
local function espClearTrackedModel(model)
    local t = ESP_TRACK[model]; if not t then return end
    for k, obj in pairs(t) do
        if obj then pcall(function() obj:Destroy() end) end
        t[k] = nil
    end
    ESP_TRACK[model] = nil
end
local function espClearAll()
    for m in pairs(ESP_TRACK) do espClearTrackedModel(m) end
end
local function espMakeBox(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return nil end
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "WindHubESPBox"; box.Adornee = hrp
    box.AlwaysOnTop = true; box.ZIndex = 1
    box.Size = Vector3.new(2.2, 5.5, 2.2)
    box.Color3 = cfg.OutlineColor; box.Transparency = 0.4
    box.Parent = hrp
    return box
end
local function espMakeChams(model, cfg)
    local hl = Instance.new("Highlight")
    hl.Name = "WindHubESPChams"; hl.Adornee = model
    hl.FillColor = cfg.FillColor; hl.OutlineColor = cfg.OutlineColor
    hl.FillTransparency = 0.55; hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    return hl
end
local function espMakeBillboard(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return nil end
    local head = model:FindFirstChild("Head") or hrp
    local bb = Instance.new("BillboardGui")
    bb.Name = "WindHubESPBillboard"; bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 50); bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true; bb.MaxDistance = cfg.MaxDistance or 1500
    bb.Parent = head
    local label = Instance.new("TextLabel")
    label.Name = "ESPLabel"; label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0); label.Font = Enum.Font.SourceSansBold
    label.TextScaled = true; label.TextColor3 = cfg.TextColor
    label.TextStrokeTransparency = 0.3; label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Text = ""; label.Parent = bb
    return bb
end
local function espMakeTracer(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return nil end
    local ad = Instance.new("LineHandleAdornment")
    ad.Name = "WindHubESPTracer"; ad.Adornee = hrp
    ad.AlwaysOnTop = true; ad.ZIndex = 0; ad.Thickness = 2
    ad.Color3 = cfg.TracerColor; ad.Transparency = 0.3; ad.Length = 0
    ad.Parent = hrp
    return ad
end
local function espUpdateTracer(model, cfg, tracer)
    if not tracer or not tracer.Parent then return end
    local hrp = espGetHRP(model); if not hrp then return end
    local origin = hrp.Position
    local target = Camera.CFrame.Position + Camera.CFrame.LookVector * 1
    local dist = (target - origin).Magnitude
    tracer.Length = dist
    tracer.CFrame = CFrame.lookAt(origin, target) * CFrame.new(0, 0, -dist * 0.5)
    tracer.Color3 = cfg.TracerColor
end
local function espEnsureForModel(model, cfg)
    if not model or not model.Parent then espClearTrackedModel(model); return end
    local hrp = espGetHRP(model)
    if not hrp then espClearTrackedModel(model); return end
    local t = espTrackTable(model)
    if t.Box and not t.Box.Parent then t.Box = nil end
    if t.Chams and not t.Chams.Parent then t.Chams = nil end
    if t.BB and not t.BB.Parent then t.BB = nil end
    if t.Tracer and not t.Tracer.Parent then t.Tracer = nil end

    if cfg.Box then
        if not t.Box then t.Box = espMakeBox(model, cfg) end
        if t.Box then t.Box.Color3 = cfg.OutlineColor end
    elseif t.Box then pcall(function() t.Box:Destroy() end); t.Box = nil end
    if cfg.Chams then
        if not t.Chams then t.Chams = espMakeChams(model, cfg) end
        if t.Chams then
            t.Chams.FillColor = cfg.FillColor
            t.Chams.OutlineColor = cfg.OutlineColor
        end
    elseif t.Chams then pcall(function() t.Chams:Destroy() end); t.Chams = nil end
    if cfg.Name or cfg.Distance then
        if not t.BB then t.BB = espMakeBillboard(model, cfg) end
        if t.BB then
            local myRoot = getMyRoot()
            local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
            local label = t.BB:FindFirstChild("ESPLabel")
            if label then
                local parts = {}
                if cfg.Name then table.insert(parts, model.Name) end
                if cfg.Distance then table.insert(parts, "[" .. math.floor(dist) .. " studs]") end
                label.Text = table.concat(parts, "\n")
                label.TextColor3 = cfg.TextColor
            end
            t.BB.MaxDistance = cfg.MaxDistance or 1500
        end
    elseif t.BB then pcall(function() t.BB:Destroy() end); t.BB = nil end
    if cfg.Tracer then
        if not t.Tracer then t.Tracer = espMakeTracer(model, cfg) end
        if t.Tracer then espUpdateTracer(model, cfg, t.Tracer) end
    elseif t.Tracer then pcall(function() t.Tracer:Destroy() end); t.Tracer = nil end
end
local function espScanCategory(folder, cfg, excludeSelf)
    if not folder then return end
    local seen = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and not (excludeSelf and m == lp.Character) then
            seen[m] = true
            local ok = pcall(espEnsureForModel, m, cfg)
            if not ok then espClearTrackedModel(m) end
        end
    end
    for m in pairs(ESP_TRACK) do
        if not seen[m] or not m.Parent then espClearTrackedModel(m) end
    end
end
