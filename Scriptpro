local hookedSounds = setmetatable({}, { __mode = "k" })
local hookedAnims = setmetatable({}, { __mode = "k" })

local function onSoundTrigger(sound)
    if not AB_Cfg.Enabled or not AB_Cfg.SoundTrigger then return end
    local soundName = string.lower(sound.Name)
    if isM1Name(soundName) then
        local killer = sound:FindFirstAncestorOfClass("Model")
        if killer then
            task.spawn(function() tryBlockWithHitbox(killer, soundName) end)
        end
    end
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    sound.Played:Connect(function() onSoundTrigger(sound) end)
end

local function onAnimTrigger(track, killer)
    if not AB_Cfg.Enabled or not AB_Cfg.AnimTrigger then return end
    local anim = track.Animation
    if not anim then return end
    
    local animId = tostring(anim.AnimationId):match("(%d+)")
    local atkName = getAttackName(animId, anim.Name)
    
    if BlockableAttacks[atkName] then
        task.spawn(function() tryBlockWithHitbox(killer, atkName) end)
    end
end

local function hookKiller(killer)
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator and not hookedAnims[animator] then
        hookedAnims[animator] = true
        animator.AnimationPlayed:Connect(function(track) onAnimTrigger(track, killer) end)
    end
end

