        V.AutoTrickThread = task.spawn(function()
            while V.AutoTrick do
                RunService.Heartbeat:Wait()
                if not V.AutoTrick then break end
                local c = lp.Character
                if not c or not veeIsVee() then continue end
                if not veeIsSkating() then continue end
                local hasWall, wallInst
