-- Punch / Block
-- =========================================================
local lastBlockFire = 0
local lastPunchFire = 0
local PUNCH_COOLDOWN = 0.08

local function firePunch()
    if not RemoteEvent then return end
    local now = tick()
    if now - lastPunchFire < PUNCH_COOLDOWN then return end
    lastPunchFire = now
    if CFG.AutoAimOnPunch and AIM and AIM.AimFor then
        pcall(function() AIM.AimFor(CFG.AutoAimPunchDur, "Punch") end)
    end
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { PUNCH_BUF }) end)
end

local function fireBlock(triggerKiller)
    if not RemoteEvent then return end
    local now = tick()
    if now - lastBlockFire < (CFG.BlockCooldown or 0.05) then return end
    lastBlockFire = now
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF }) end)
    if triggerKiller and FacingVisual and FacingVisual.FlashBlock then
        pcall(function() FacingVisual.FlashBlock(triggerKiller) end)
    end
    if HDT and HDT.Enabled and HDT.AutoTrigger then
        pcall(function() HDT.TriggerFromAutoBlock() end)
    end
    if CFG.PunchAfterBlock then
        task.delay(CFG.PunchDelay, function()
            if HDT and HDT._dragging then
                local waited = 0
                while HDT._dragging and waited < 1.0 do task.wait(0.05); waited += 0.05 end
            end
            pcall(firePunch)
        end)
    end
end

