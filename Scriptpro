-- (fix 1 + fix 3) framerate-independent smoothing + delayed ability clear
RunService:BindToRenderStep("ViltrumiteAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    local aimActive = AIM.Enabled or (tick() < (AIM._aimUntil or 0))

    if not isPlayingSurvivor()
        or not aimActive
        or not AIM.CachedTargetHRP
        or not AIM.CachedTargetHRP.Parent then
        restoreAutoRotate()
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local myRoot = getMyRoot()
    if not myRoot then
        restoreAutoRotate()
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end
    if AIM.CurrentAbility and AIM.CachedTargetHRP.Parent then
        local killer = AIM.CachedTargetHRP.Parent
        local ov = STUN_BY_ABILITY[AIM.CurrentAbility]
        if ov then
            if ov.AimPart and ov.AimPart ~= "HumanoidRootPart" then
                local p = killer:FindFirstChild(ov.AimPart)
                if p and p:IsA("BasePart") then targetPos = p.Position end
            end
            if ov.Ballistic then targetPos = ballisticAim(targetPos, 80, workspace.Gravity) end
        end
    end

    -- framerate-independent alpha
    local speed = math.clamp((AIM.Smooth or 0.35) * 30, 2, 60)
    local alpha = 1 - math.exp(-dt * speed)

    local mode = AIM.AimMode
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), alpha)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        disableAutoRotate()
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        local delta = flat - myRoot.Position
        if delta.Magnitude > 0.05 then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, flat), alpha)
        end
    else
        restoreAutoRotate()
    end

    if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
end)

-- =========================================================
-- SILENT AIM — hardened (for Dusekkar + Jane Doe)
-- =========================================================
SilentAim = {
    Enabled            = false,
    Dusekkar           = false,
    JaneDoe            = false,
    Prediction         = 0.15,
    WallCheck          = true,
    MaxRange           = 300,
    _installed         = false,
    _hookedGetMousePos = false,
    _original          = nil,
    _hookRef           = nil,
    _hookApi           = nil,
    _status            = "idle",
}

local saVelCache = setmetatable({}, { __mode = "k" })
local function saSmoothVel(hrp)
    if not hrp then return Vector3.zero end
    local now = tick()
    local raw = hrp.AssemblyLinearVelocity
    if raw.Magnitude > 200 then raw = Vector3.zero end
    local entry = saVelCache[hrp]
    if not entry then
        saVelCache[hrp] = { t = now, v = raw }
        return raw
    end
    local dt = math.max(now - entry.t, 0.001)
    entry.v = entry.v:Lerp(raw, math.clamp(1 - math.exp(-dt * 12), 0, 1))
    entry.t = now
    return entry.v
end

local function saPredictTargetPos(hrp)
    if not hrp then return nil end
    local v = saSmoothVel(hrp)
    local lead = (SilentAim.Prediction or 0.15) + (getPing() * 0.5)
    return hrp.Position + v * math.clamp(lead, 0, 0.75)
end

local function saGetNearestKillerHRP()
    local myRoot = getMyRoot()
    if not myRoot or not KillersFolder then return nil end
    local best, bestDist = nil, SilentAim.MaxRange or 300
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d <= bestDist then
                    if not SilentAim.WallCheck then
                        best, bestDist = hrp, d
                    elseif d < bestDist - 0.01 then
                        RAY_LOS.FilterDescendantsInstances = { lp.Character, k }
                        local delta = hrp.Position - myRoot.Position
                        if not workspace:Raycast(myRoot.Position, delta, RAY_LOS) then
                            best, bestDist = hrp, d
                        end
                    end
                end
            end
        end
    end
    return best
end

local function saNormalizeName(s)
    if not s then return nil end
    return (string.gsub(string.lower(tostring(s)), "%s+", ""))
end

local function saResolveTarget()
    if not SilentAim.Enabled then return nil end
    local c = lp.Character
    if not c then return nil end
    local name = saNormalizeName(c:GetAttribute("CharacterName") or c.Name)
    if not name then return nil end
    if name == "dusekkar" then
        if not SilentAim.Dusekkar then return nil end
    elseif name == "janedoe" then
        if not SilentAim.JaneDoe then return nil end
    else
        return nil
    end
    local hrp = saGetNearestKillerHRP()
    if not hrp then return nil end
    return saPredictTargetPos(hrp)
end

local function saHookApi()
    if SilentAim._hookApi then return SilentAim._hookApi end
    local cands = {
        rawget(_G, "hookfunction"),
        rawget(_G, "replacefunc"),
        rawget(_G, "hookfunc"),
        rawget(_G, "replaceFunction"),
    }
    for _, fn in ipairs(cands) do
        if type(fn) == "function" then
            SilentAim._hookApi = fn
            return fn
        end
    end
    return nil
end

local function saFindGetMousePos()
    local keys = { "GetMousePos", "GetMousePosition", "GetPosition", "Get", "getMousePos", "get" }
    local function tryModule(node)
        if not node or not node:IsA("ModuleScript") then return nil end
        local ok, mod = pcall(require, node)
        if not ok or mod == nil then return nil end
        if type(mod) == "function" then return mod end
        if type(mod) == "table" then
            for _, k in ipairs(keys) do
                if type(mod[k]) == "function" then return mod[k] end
            end
            for _, sub in ipairs({ "Main", "Default", "API", "Functions" }) do
                local s = mod[sub]
                if type(s) == "table" then
                    for _, k in ipairs(keys) do
                        if type(s[k]) == "function" then return s[k] end
                    end
                end
            end
        end
        return nil
    end

    local paths = {
        { "Systems", "Player", "Miscellaneous", "GetPlayerMousePosition" },
        { "Systems", "Player", "Miscellaneous", "GetMousePosition" },
        { "Systems", "Player", "Miscellaneous", "GetMousePos" },
        { "Systems", "Player", "GetPlayerMousePosition" },
        { "Systems", "Player", "GetMousePosition" },
        { "Systems", "Player", "GetMousePos" },
        { "Systems", "GetPlayerMousePosition" },
        { "Modules", "GetMousePos" },
        { "Shared", "GetMousePos" },
    }
    for _, path in ipairs(paths) do
        local node, ok = ReplicatedStorage, true
        for _, seg in ipairs(path) do
            node = node and node:FindFirstChild(seg)
            if not node then ok = false; break end
        end
        if ok and node then
            local fn = tryModule(node)
            if fn then return fn end
        end
    end

    local namesToMatch = {
        "getplayermouseposition", "getmouseposition", "getmousepos",
        "mouseposition", "mousepos", "getplayerpos",
    }
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") then
            local n = string.lower(d.Name)
            for _, pat in ipairs(namesToMatch) do
                if n:find(pat, 1, true) then
                    local fn = tryModule(d)
                    if fn then return fn end
                    break
                end
            end
        end
    end
    return nil
end

local function saInstallHook()
    if SilentAim._installed then return true end
    local hookFn = saHookApi()
    if type(hookFn) ~= "function" then
        SilentAim._status = "hook API unavailable"
        return false
    end
    local original = saFindGetMousePos()
    if type(original) ~= "function" then
        SilentAim._status = "GetMousePos module not found"
        return false
    end
    local function detour(...)
        local ok, target = pcall(saResolveTarget)
        if ok and target then
            SilentAim._status = "redirecting"
            return target
        end
        SilentAim._status = "passthrough"
        return original(...)
    end
    local ok, ret = pcall(hookFn, original, detour)
    if not ok then
        SilentAim._status = "hook failed: " .. tostring(ret)
        return false
    end
    SilentAim._original          = ret or original
    SilentAim._hookRef           = detour
    SilentAim._installed         = true
    SilentAim._hookedGetMousePos = true
    SilentAim._status            = "installed"
    return true
end

local function saUninstallHook()
