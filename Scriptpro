-- ==========================================
-- SOUND HOOK
-- ==========================================
local function extractNumericSoundId(sound)
    if not sound or not sound.SoundId then return nil end
    local sid = tostring(sound.SoundId)
    return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
end

local function getSoundWorldPosition(sound)
    local p = sound and sound.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p.Position, p end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position, p.Parent end
    return nil
end

local function getCharacterFromDescendant(inst)
    if not inst then return nil end
    local model = inst:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return model end
    return nil
end

local function _attemptForSound(sound, idParam, mode)
    if not autoBlockAudioOn then return end
    if isHelpless() then return end
    if not sound or not sound:IsA("Sound") or not sound.IsPlaying then return end
    local now = tick()
    local hook = soundHooks[sound]
    local id = idParam or (hook and hook.id) or extractNumericSoundId(sound)
    if not id or not autoBlockTriggerSounds[id] then return end
    if soundBlockedUntil[sound] and now < soundBlockedUntil[sound] then return end
    if now - lastLocalBlockTime < LOCAL_BLOCK_COOLDOWN then return end

    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local hrp = hook and hook.hrp
    if not hrp then
        local _, part = getSoundWorldPosition(sound)
        if not part then return end
        local char = getCharacterFromDescendant(part)
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
    end

    if not isInBlockZone(myRoot, hrp) then return end
    if not hasLineOfSight(hrp) then return end

    local killerModel = hrp.Parent
    if killerModel and isKillerFlicking(killerModel, myRoot, hrp) then return end

    if blockdelay and blockdelay > 0 then task.wait(blockdelay) end

    if mode == "Block"  and autoblockToggles["Block"]  then
        if cachedCooldown and cachedCooldown.Text ~= "" then return end
        fireRemoteBlock()
    end
    if mode == "Charge" and autoblockToggles["Charge"] then fireRemoteCharge() end
    if mode == "Clone"  and autoblockToggles["Clone"]  then fireRemoteClone()  end

    lastLocalBlockTime = now
    soundBlockedUntil[sound] = now + 1.0
end

local function hookSound(sound)
    if not sound or not sound:IsA("Sound") or soundHooks[sound] then return end
    local preId = extractNumericSoundId(sound)
    soundHooks[sound] = { id = preId }
    local function fire()
        if antiFlickOn then return end
        if autoblockToggles["Block"]  then _attemptForSound(sound, preId, "Block")  end
        if autoblockToggles["Charge"] then _attemptForSound(sound, preId, "Charge") end
        if autoblockToggles["Clone"]  then _attemptForSound(sound, preId, "Clone")  end
    end
    sound.Played:Connect(fire)
    sound:GetPropertyChangedSignal("IsPlaying"):Connect(function() if sound.IsPlaying then fire() end end)
    if sound.IsPlaying then fire() end
end

