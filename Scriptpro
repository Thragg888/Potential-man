-- Generators ESP
local function scanGenerators()
    local map = workspace:FindFirstChild("Map")
    map = map and map:FindFirstChild("Ingame")
    map = map and map:FindFirstChild("Map")
    if not map then return end
    local seen = {}
    for _, g in ipairs(map:GetChildren()) do
        if g.Name == "Generator" and g:IsA("Model") then
            seen[g] = true
            local has = false
            for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
                if obj:IsA("Highlight") and obj:IsDescendantOf(g) then has = true; break end
            end
            if not has then
                local hl = Instance.new("Highlight")
                hl.Name = "WindHubESPGen"
                hl.Adornee = g
                hl.FillColor = Color3.fromRGB(255, 220, 40)
                hl.OutlineColor = Color3.fromRGB(255, 220, 40)
                hl.FillTransparency = 0.6
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = g
                CollectionService:AddTag(hl, ESP_TAG)
            end
        end
    end
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsA("Highlight") and obj.Name == "WindHubESPGen" then
            local g = obj:FindFirstAncestorOfClass("Model")
            if not g or not seen[g] then pcall(function() obj:Destroy() end) end
        end
    end
end

-- Items ESP — scan BOTH InGame folder and workspace for dropped tools
local ITEM_NAMES = { Medkit = Color3.fromRGB(255, 105, 180), BloxyCola = Color3.fromRGB(0, 150, 255) }
local function scanItems()
    local seen = {}
    local function tryAdd(container, item)
        if not item:IsA("Tool") then return end
        local c = ITEM_NAMES[item.Name]
        if not c then return end
        local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
        if not handle then return end
        seen[item] = true
        -- check existing
        for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
            if obj:IsA("Highlight") and obj.Name == "WindHubESPItem" and obj.Adornee == handle then
                obj.FillColor = c; obj.OutlineColor = c
                return
            end
        end
        local hl = Instance.new("Highlight")
        hl.Name = "WindHubESPItem"
        hl.Adornee = handle
        hl.FillColor = c
        hl.OutlineColor = c
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = handle
        CollectionService:AddTag(hl, ESP_TAG)
    end
    -- 1. InGame/Map folder
    local map = workspace:FindFirstChild("Map")
    local ingame = map and map:FindFirstChild("Ingame")
    if ingame then
        for _, d in ipairs(ingame:GetDescendants()) do tryAdd(ingame, d) end
    end
    -- 2. workspace direct
    for _, d in ipairs(workspace:GetChildren()) do tryAdd(workspace, d) end
    -- cleanup
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsA("Highlight") and obj.Name == "WindHubESPItem" then
            local itm = obj:FindFirstAncestorOfClass("Tool") or obj.Adornee and obj.Adornee.Parent
            if not itm or not seen[itm] then pcall(function() obj:Destroy() end) end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if ESP_CFG.Generators.Enabled then scanGenerators()
        else
            for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
                if obj.Name == "WindHubESPGen" then pcall(function() obj:Destroy() end) end
            end
        end
        if ESP_CFG.Items.Enabled then scanItems()
        else
            for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
                if obj.Name == "WindHubESPItem" then pcall(function() obj:Destroy() end) end
            end
        end
    end
end)

