local function veeIsVee()
    local c = lp.Character; if not c then return false end
    local name = c:GetAttribute("CharacterName") or c.Name
    return name == "Veeronica"
end
local function veeKillers()
    if KillersFolder then return KillersFolder end
    local p = workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end
local function veeWallCheck()
    local mr = getMyRoot()
    local myChar = lp.Character
    if not mr or not myChar then return false, nil end
    local height = 5
    local okBB, _, sizeBB = pcall(function() return myChar:GetBoundingBox() end)
    if okBB and sizeBB then height = math.max(sizeBB.Y, 3) end
    local R = math.clamp(V.WallTrickRadius or 5, 1, 10)
    local boxSize = Vector3.new(R * 2, height, R * 2)
    local center = mr.Position
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = { myChar }
    local pf = workspace:FindFirstChild("Players")
    if pf then table.insert(exclude, pf) end
    params.FilterDescendantsInstances = exclude
    local parts = workspace:GetPartBoundsInBox(CFrame.new(center), boxSize, params)
    local nearestInst, nearestDist = nil, math.huge
    for _, p in ipairs(parts) do
        if p:IsA("BasePart") and p.CanCollide then
            local minHoriz = math.min(p.Size.X, p.Size.Z)
            if minHoriz > 0.05 and p.Size.Y >= minHoriz * 0.5 then
                local d = (p.Position - center).Magnitude
                if d < nearestDist then nearestDist = d; nearestInst = p end
            end
        end
    end
    if nearestInst then return true, nearestInst end
    return false, nil
end
local function veeFireStamButton()
    if not PlayerGui then return false end
    local targets = {}
    local main = PlayerGui:FindFirstChild("MainUI")
    if main then
        for _, n in ipairs({ "SprintingButton", "StaminaButton", "SprintButton" }) do
            local b = main:FindFirstChild(n)
            if b and b:IsA("GuiButton") then table.insert(targets, b) end
        end
        local ac = main:FindFirstChild("AbilityContainer")
        if ac then
            for _, n in ipairs({ "Sprint", "Stamina", "Sk8", "Skate" }) do
                local b = ac:FindFirstChild(n)
                if b and b:IsA("GuiButton") then table.insert(targets, b) end
            end
        end
    end
    for _, b in ipairs(targets) do
        if firesignalF and pcall(firesignalF, b.MouseButton1Click) then return true end
    end
    return false
end
local function veePressJump()
    return pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, false)
        task.wait(0.03)
        VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, false)
    end)
end
local function veeDoTrickInput()
    local fired = false
    if V.WallTrickMode == "Button" or V.WallTrickMode == "Both" then
        fired = veeFireStamButton()
    end
    if V.WallTrickMode == "Key" or V.WallTrickMode == "Both" or not fired then
        pcall(veePressJump)
    end
end
local function veeIsSkating()
    if not V.WallTrickRequireSkate then return true end
    local c = lp.Character; if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
    return hrp:FindFirstChild("SkatePointer") ~= nil
end
local function veeAutoTrickStart()
    if V.AutoTrickThread then pcall(task.cancel, V.AutoTrickThread); V.AutoTrickThread = nil end
    if not V.AutoTrick then return end
    V.AutoTrickThread = task.spawn(function()
        while V.AutoTrick do
            RunService.Heartbeat:Wait()
            if not V.AutoTrick then break end
            local c = lp.Character
            if not c or not veeIsVee() then continue end
            if not veeIsSkating() then continue end
            local hasWall, wallInst = veeWallCheck()
            if not hasWall then V.WallTrickLastWall = nil; continue end
            if wallInst and V.WallTrickLastWall == wallInst then continue end
            if os.clock() - (V.WallTrickLast or 0) >= (V.WallTrickCooldown or 0.15) then
                V.WallTrickLast = os.clock()
                V.WallTrickLastWall = wallInst
                pcall(veeDoTrickInput)
            end
        end
    end)
end
local function veeSkateCtrl(v)
    veeModules()
    local val = v and 6.5 or 0.65
    if VModule then VModule.Sk8TurnControl = val end
end
local veeARInstalled = false
local function veeInstallAR()
    if veeARInstalled or not hookmetamethod or not getnamecallmethod then return end
    veeARInstalled = true
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if not V.AntiRebound then return old(self, ...) end
        if getnamecallmethod() == "FireServer" and self == RemoteEvent then
            local a = {...}
            local first = tostring(a[1] or "")
            if veeIsVee() and first == lp.Name .. "SkateRebound" then return end
        end
        return old(self, ...)
    end)
end
local veeUSk8 = false
local function veeInstallUSk8()
    if veeUSk8 then return end
    veeUSk8 = true
    RunService.Heartbeat:Connect(function()
        if not V.UnlimitedSk8 or not Sprinting then return end
        local c = lp.Character; if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        if hrp:FindFirstChild("SkatePointer") then Sprinting.Stamina = Sprinting.MaxStamina end
    end)
end
local function veeFarmStart()
    if V.AutoFarmSk8Started then return end
    V.AutoFarmSk8Started = true
    task.spawn(function()
        while true do
            if V.AutoFarmSk8 and RemoteEvent then
                pcall(function() RemoteEvent:FireServer(lp.Name .. "SkateTrick", {}) end)
                task.wait(0.5)
            else
                task.wait(0.1)
            end
        end
    end)
end
local function veeAutoPhase(v)
    if V.AutoPhaseThread then pcall(task.cancel, V.AutoPhaseThread); V.AutoPhaseThread = nil end
    if not v then return end
    local Network
    pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end)
    V.AutoPhaseThread = task.spawn(function()
        while task.wait(0.5) do
            if not V.AutoPhase then break end
            if not Network then pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end) end
            local kf = veeKillers()
            if Network and veeIsVee() and kf then
                for _, k in ipairs(kf:GetChildren()) do
                    if not V.AutoPhase then break end
                    local h = k:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        pcall(function()
                            Network:FireServerConnection(lp.Name .. "SkatePhase", "REMOTE_EVENT", k)
                        end)
                        task.wait(3.6)
                    end
                end
            end
        end
    end)
end

