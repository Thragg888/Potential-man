local ESP_TRACK = setmetatable({}, { __mode = "k" })
local function espHRP(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) end
local function espClear(m)
    local t = ESP_TRACK[m]; if not t then return end
    for _, o in pairs(t) do if o then pcall(function() o:Destroy() end) end end
    ESP_TRACK[m] = nil
end
local function espEnsure(m, cfg)
    if not m or not m.Parent then espClear(m); return end
    local hrp = espHRP(m); if not hrp then espClear(m); return end
    local t = ESP_TRACK[m]; if not t then t = {}; ESP_TRACK[m] = t end
    if t.Box and not t.Box.Parent then t.Box = nil end
    if t.Chams and not t.Chams.Parent then t.Chams = nil end
    if t.BB and not t.BB.Parent then t.BB = nil end
    if cfg.Box then
        if not t.Box then
            t.Box = Instance.new("BoxHandleAdornment")
            t.Box.Adornee = hrp; t.Box.AlwaysOnTop = true; t.Box.ZIndex = 1
            t.Box.Size = Vector3.new(2.2, 5.5, 2.2); t.Box.Transparency = 0.4
            t.Box.Parent = hrp
        end
