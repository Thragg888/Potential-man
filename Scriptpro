function UI:SetOpen(open)
    self.Open = open
    if open then
        self.Panel.Visible = true
        self.Panel.Size = UDim2.fromOffset(0, PANEL_H)
        TweenService:Create(self.Panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.fromOffset(PANEL_W, PANEL_H) }):Play()
    else
        TweenService:Create(self.Panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Size = UDim2.fromOffset(0, PANEL_H) }):Play()
        task.delay(0.22, function()
            if not self.Open then self.Panel.Visible = false end
        end)
    end
end

