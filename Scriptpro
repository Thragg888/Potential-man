RunService:BindToRenderStep("ChanceAimbot", Enum.RenderPriority.Camera.Value + 2, function()
    if not ChanceAimbot.Enabled or not ChanceAimbot._isLocking then return end
    local now = os.clock()
    if now > ChanceAimbot._lockUntil then
        ChanceAimbot._isLocking = false; ChanceAimbot._currentTarget = nil; return
    end
    local root = ChanceAimbot._currentTarget
