local HB_PART = Instance.new("Part")
HB_PART.Name = "SCPHub_HBQuery"
HB_PART.Anchored = true
HB_PART.CanCollide = false
HB_PART.CanTouch = false
HB_PART.CanQuery = false
HB_PART.Massless = true
HB_PART.Transparency = 1
HB_PART.Size = M1_HITBOX_SIZE * 2.2
HB_PART.Parent = Workspace

local HB_PARAMS = OverlapParams.new()
HB_PARAMS.FilterType = Enum.RaycastFilterType.Include
HB_PARAMS.MaxParts = 1

local RAY_LOS = RaycastParams.new()
RAY_LOS.FilterType = Enum.RaycastFilterType.Exclude
RAY_LOS.IgnoreWater = true

local function isInM1Hitbox(killer, attackType)
    local qh = killer:FindFirstChild("QueryHitbox")
    if not qh then return false end
    local myHb = getMyHb()
    if not myHb then return false end

    local custom = CUSTOM_HITBOXES[attackType]
    HB_PART.Size = (custom and custom.Size or M1_HITBOX_SIZE) * 2.2
    HB_PART.CFrame = qh.CFrame * (custom and custom.Offset or M1_HITBOX_OFFSET)

    HB_PARAMS.FilterDescendantsInstances = { myHb }
    return #Workspace:GetPartsInPart(HB_PART, HB_PARAMS) > 0
end

local function tryBlockFromAttack(killer, attackType)
    if not AB_Cfg.Enabled then return end
    if not killer or not killer.Parent then return end
    if not isSurvivor() then return end
    if hasHelplessEffect() then return end

    local mr = getMyRoot()
    local kh = killer:FindFirstChild("HumanoidRootPart")
    if not mr or not kh then return end

    if (kh.Position - mr.Position).Magnitude > AB_Cfg.MaxDistance then return end
    if not isInM1Hitbox(killer, attackType) then return end

    if AB_Cfg.WallCheck then
        RAY_LOS.FilterDescendantsInstances = { lp.Character, killer }
        if Workspace:Raycast(mr.Position, kh.Position - mr.Position, RAY_LOS) then return end
    end

    fireBlock()
end

local killerAttackConns = setmetatable({}, { __mode = "k" })
local function hookKillerForAttack(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerAttackConns[killer] then return end
    local function tryHook()
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        killerAttackConns[killer] = animator.AnimationPlayed:Connect(function(track)
            if not AB_Cfg.Enabled or not AB_Cfg.AnimTrigger then return end
            local anim = track and track.Animation; if not anim then return end
            local id = tostring(anim.AnimationId):match("(%d+)")
            -- Non-M1 anim ID: hard refuse
            if id and NON_M1_ANIM_IDS[id] then return end
            local attackType = id and ATTACK_ANIM_MAP[id]
            if not attackType then return end
            task.spawn(tryBlockFromAttack, killer, attackType)
        end)
        return true
    end
    if tryHook() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function() if tryHook() then
        if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
    end end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
        end
    end)
end

