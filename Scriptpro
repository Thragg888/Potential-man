local SKILL_UI = { ui = nil, lastScan = 0, lastPress = 0 }

local function findSkillCheckUI()
    if SKILL_UI.ui and SKILL_UI.ui.Parent and SKILL_UI.ui.Visible then return SKILL_UI.ui end
    SKILL_UI.ui = nil
    local now = tick()
    if now - SKILL_UI.lastScan < 0.04 then return nil end
