local function applyBlindnessTo(inst) if inst.Name == "BlindnessBlur" and inst:IsA("BlurEffect") then if Misc_DisableBlindness then pcall(function() inst.Enabled = false end); blindnessWasHidden[inst] = true elseif blindnessWasHidden[inst] then pcall(function() inst.Enabled = true end); blindnessWasHidden[inst] = nil end end end
Lighting.ChildAdded:Connect(applyBlindnessTo)
PlayerGui.DescendantAdded:Connect(applyInjuryTo)
local function reapplyMisc() for _, v in ipairs(Lighting:GetDescendants()) do applyBlindnessTo(v) end; for _, v in ipairs(PlayerGui:GetDescendants()) do applyInjuryTo(v) end end

