local BoxCfg = {
    Enabled = false, AppearMode = "M1",
    Color = Color3.fromRGB(255, 60, 60),
    Width = 12, Height = 8, Length = 30,
    Transparency = 0,
    M1Boxes = 1, M1Spread = 3,
    M1FadeTime = 1,
    Long = {},
}

local function ensureHitboxesFolder()
    if HitboxesFolder and HitboxesFolder.Parent then return HitboxesFolder end
    local h = Workspace:FindFirstChild("Hitboxes")
    if not h then h = Instance.new("Folder"); h.Name = "Hitboxes"; h.Parent = Workspace end
    HitboxesFolder = h
    return h
end

local function spawnM1Boxes(killer)
    if not killer or not killer.Parent then return end
    local qh = killer:FindFirstChild("QueryHitbox"); if not qh then return end
    local parent = ensureHitboxesFolder()
    local count = math.max(1, math.floor(BoxCfg.M1Boxes))
    local baseCF = qh.CFrame * M1_HITBOX_OFFSET
    local fadeTime = math.max(0.3, BoxCfg.M1FadeTime)
    for i = 1, count do
        local p = Instance.new("Part")
        p.Name = "SCPHubM1Box"
        p.Anchored = true
        p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
        p.CastShadow = false; p.Massless = true
        p.Material = Enum.Material.ForceField
        p.Color = BoxCfg.Color
        p.Transparency = 0.1
        p.Size = M1_HITBOX_SIZE * 2.2
        p.CFrame = baseCF * CFrame.new((i - (count + 1) / 2) * BoxCfg.M1Spread, 0, 0)
        p.Parent = parent
        TweenService:Create(p, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Transparency = 1 }):Play()
        Debris:AddItem(p, fadeTime + 0.1)
    end
end

local function destroyLongBox(killer)
    local d = BoxCfg.Long[killer]; if not d then return end
    if d.part and d.part.Parent then pcall(function() d.part:Destroy() end) end
    if d.hl and d.hl.Parent then pcall(function() d.hl:Destroy() end) end
    if d.conn then pcall(function() d.conn:Disconnect() end) end
    BoxCfg.Long[killer] = nil
end
local function applyLongBoxAppearance(data)
    local part, hl = data.part, data.hl
    if not part or not part.Parent then return end
    local show = BoxCfg.Enabled and BoxCfg.AppearMode == "Always"
    part.Color = BoxCfg.Color
    part.Transparency = show and BoxCfg.Transparency or 1
    part.Material = Enum.Material.Neon
    if hl and hl.Parent then
        hl.OutlineColor = BoxCfg.Color
        hl.OutlineTransparency = show and 0 or 1
        hl.FillTransparency = 1
    end
end
local function refreshAllLongBoxes()
    local dead = {}
    for killer, data in pairs(BoxCfg.Long) do
        if not killer.Parent or not data.part or not data.part.Parent then
            table.insert(dead, killer)
        else
            applyLongBoxAppearance(data)
        end
    end
    for _, killer in ipairs(dead) do destroyLongBox(killer) end
end
local function createLongBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyLongBox(killer)
    local part = Instance.new("Part")
    part.Name = "SCPHubLongBox"
    part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
    part.Massless = true; part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Size = Vector3.new(BoxCfg.Width, BoxCfg.Height, BoxCfg.Length)
    part.Parent = killer
    local hl = Instance.new("Highlight")
    hl.Name = "SCPHubLongBoxHL"; hl.FillTransparency = 1
    hl.OutlineColor = BoxCfg.Color; hl.OutlineTransparency = 1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = part; hl.Parent = part
    local data = { part = part, hl = hl, conn = nil }
    BoxCfg.Long[killer] = data
    applyLongBoxAppearance(data)
    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyLongBox(killer); return end
        local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then return end
        flat = flat.Unit
        part.Size = Vector3.new(BoxCfg.Width, BoxCfg.Height, BoxCfg.Length)
        part.CFrame = CFrame.lookAt(
            hrp.Position + flat * (BoxCfg.Length * 0.5),
            hrp.Position + flat * (BoxCfg.Length * 0.5 + 1))
        applyLongBoxAppearance(data)
    end)
end
local function ensureBoxes()
    if not KillersFolder then return end
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            if BoxCfg.Enabled and BoxCfg.AppearMode == "Always" and not BoxCfg.Long[k] then
                createLongBox(k)
            elseif (not BoxCfg.Enabled or BoxCfg.AppearMode ~= "Always") and BoxCfg.Long[k] then
                destroyLongBox(k)
            end
        end
    end
end

local killerM1Conns = setmetatable({}, { __mode = "k" })
local function hookKillerForM1(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerM1Conns[killer] then return end
    local function tryHook()
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        killerM1Conns[killer] = animator.AnimationPlayed:Connect(function(track)
            if not BoxCfg.Enabled then return end
            if BoxCfg.AppearMode ~= "M1" then return end
            local anim = track and track.Animation; if not anim then return end
            local id = tostring(anim.AnimationId):match("(%d+)")
            -- Non-M1 anim ID: hard refuse, even if the same asset is used elsewhere
            if id and NON_M1_ANIM_IDS[id] then return end
            if not id or not ATTACK_ANIM_MAP[id] then return end
            spawnM1Boxes(killer)
        end)
        return true
    end
    if tryHook() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function() if tryHook() then
        if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
    end end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
        end
    end)
end

