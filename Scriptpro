local function tryBlock(killer)
    if not AB_Cfg.Enabled then return end
    if not isSurvivor() or hasHelplessEffect() then return end
    
    local myRoot = getMyRoot()
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    if not myRoot or not killerRoot then return end

    local dist = (myRoot.Position - killerRoot.Position).Magnitude
    if dist <= AB_Cfg.Range and isFacing(myRoot, killerRoot) then
        local gui = PlayerGui:FindFirstChild("MainUI")
