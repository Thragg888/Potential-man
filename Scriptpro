function UI:AddTab(name)
    if not self.Content then return nil end
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 28)
    tabBtn.BackgroundColor3 = COL.bg
    tabBtn.BorderSizePixel = 0
    tabBtn.AutoButtonColor = false
    tabBtn.Font = Enum.Font.GothamMedium
    tabBtn.TextSize = 12
    tabBtn.TextColor3 = COL.textDim
    tabBtn.Text = name
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.LayoutOrder = #self.Tabs + 1
    tabBtn.ZIndex = 93
    tabBtn.Parent = self.Sidebar
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0,6); tc.Parent = tabBtn
    local tp = Instance.new("UIPadding"); tp.PaddingLeft = UDim.new(0, 10); tp.Parent = tabBtn

    local content = newFrame(self.Content, COL.bg, UDim2.fromScale(1,1), nil, 0, 92)
    content.Visible = false
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.fromScale(1,1)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = COL.accent
    scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ZIndex = 92
    scroll.Parent = content
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0,8); pad.PaddingBottom = UDim.new(0,8)
    pad.PaddingLeft = UDim.new(0,8); pad.PaddingRight = UDim.new(0,8)
    pad.Parent = scroll
    local ll = Instance.new("UIListLayout")
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Padding = UDim.new(0, 6)
    ll.Parent = scroll

    local tab = { Name = name, Button = tabBtn, Frame = content, Scroll = scroll, Order = 0 }

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(self.Tabs) do
            t.Frame.Visible = false
            t.Button.BackgroundColor3 = COL.bg
            t.Button.TextColor3 = COL.textDim
        end
        tab.Frame.Visible = true
        tabBtn.BackgroundColor3 = COL.accentDim
        tabBtn.TextColor3 = COL.text
        self.ActiveTab = tab
    end)

    self.Tabs[name] = tab
    if not self.ActiveTab then
        tab.Frame.Visible = true
        tabBtn.BackgroundColor3 = COL.accentDim
        tabBtn.TextColor3 = COL.text
        self.ActiveTab = tab
    end
    return tab
end

