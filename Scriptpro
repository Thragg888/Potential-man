local function stamStopInfinite()
    if STAM._thread then task.cancel(STAM._thread); STAM._thread = nil end
    if Sprinting and STAM._lossBackup ~= nil then
        pcall(function() Sprinting.StaminaLossDisabled = STAM._lossBackup end)
        STAM._lossBackup = nil
    end
