-- =========================================================
-- AUTO GENERATOR (fixed to match Forsaken Plus)
-- =========================================================
local AUTOGEN = { Enabled = false, Interval = 1.05, MaxDistance = 10, _thread = nil }
local function getIngameMap()
    local map = workspace:FindFirstChild("Map")
    map = map and map:FindFirstChild("Ingame")
    return map and map:FindFirstChild("Map")
end
local function autogenFireOnce()
    local map = getIngameMap()
    local myRoot = getMyRoot()
    if not map or not myRoot then return end
    local pos = myRoot.Position

    -- Forsaken Plus finds generators with a #Main child
    local gens
    pcall(function() gens = map:QueryDescendants("Model#Generator:has(#Main)") end)
    if not gens then
        gens = {}
        for _, obj in ipairs(map:GetChildren()) do
            if obj:IsA("Model") and (obj.Name == "Generator" or obj.Name == "FakeGenerator") then
                gens[#gens+1] = obj
            end
        end
    end

    for _, obj in ipairs(gens) do
        local prog = obj:FindFirstChild("Progress")
        local main = obj:FindFirstChild("Main")
        if prog and prog.Value ~= 100 and main
            and (main.Position - pos).Magnitude <= AUTOGEN.MaxDistance then
            local remotes = obj:FindFirstChild("Remotes")
            -- Forsaken Plus: RemoteEvent is a direct child of Remotes
            local re = remotes and remotes:FindFirstChildOfClass("RemoteEvent")
            -- Fallback: also try a child literally named "RE"
            if not re and remotes then
                local r = remotes:FindFirstChild("RE")
                if r and r:IsA("RemoteEvent") then re = r end
            end
            if re then
                pcall(function() re:FireServer() end)
            end
        end
    end
end
local function autogenLoop()
    if AUTOGEN._thread then pcall(task.cancel, AUTOGEN._thread); AUTOGEN._thread = nil end
    if not AUTOGEN.Enabled then return end
    AUTOGEN._thread = task.spawn(function()
        while AUTOGEN.Enabled do
            pcall(autogenFireOnce)
            local target = os.clock() + math.max(AUTOGEN.Interval, 0.1)
            while AUTOGEN.Enabled and os.clock() < target do
                RunService.Heartbeat:Wait()
            end
        end
        AUTOGEN._thread = nil
    end)
end

