local Misc_HideInjury = false
local Misc_DisableBlindness = false

local function applyInjuryTo(inst)
    if inst.Name == "redFlash" or inst.Name == "injuredVignette" then
        pcall(function() inst.Visible = not Misc_HideInjury end)
    end
end
local function applyBlindnessTo(inst)
    if inst.Name == "BlindnessBlur" and inst:IsA("BlurEffect") then
        pcall(function() inst.Enabled = not Misc_DisableBlindness end)
    elseif inst.Name == "HealthDesaturation" then
        pcall(function() inst.Enabled = not Misc_HideInjury end)
    end
end

Lighting.ChildAdded:Connect(applyBlindnessTo)
PlayerGui.DescendantAdded:Connect(applyInjuryTo)

local function reapplyMisc()
    for _, v in ipairs(Lighting:GetDescendants()) do applyBlindnessTo(v) end
    for _, v in ipairs(PlayerGui:GetDescendants()) do applyInjuryTo(v) end
end

