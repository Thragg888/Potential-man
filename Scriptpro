-- VEERONICA TAB
-- Wall trick: nearest-wall only · skips same wall · cooldown 0-10s
-- =========================================================
pcall(function()
    local V = {
        AutoTrick=false, AutoTrickThread=nil, SkateControl=false, AntiRebound=false,
        UnlimitedSk8=false, AutoFarmSk8=false, AutoFarmSk8Started=false, CustomStats=false,
        Sk8Everywhere=false, Sk8EverywhereThread=nil, AutoPhase=false, AutoPhaseThread=nil,
        Sk8Speed=1.15, Sk8TrickSpeed=1.42, Sk8BumpPower=11.9, Sk8TrickStamina=10, Sk8TrickCooldown=1,
        -- Wall-trick
        WallTrickEnabled=false, WallTrickThread=nil, WallTrickRadius=5,
        WallTrickCooldown=0.15, WallTrickLast=0, WallTrickMode="Button",
        WallTrickRequireSkate=true, WallTrickUseHighlight=false,
        WallTrickLastWall=nil,          -- tracks last wall instance so we don't re-click the same one
    }
    local VModule, VUtil

    local function veeModules()
        local assets = ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
        if not VModule then pcall(function() VModule = require(assets.Survivors.Veeronica.Behavior) end) end
        if not VUtil then pcall(function() VUtil = require(ReplicatedStorage.Modules.Utilities.Util) end) end
    end
    local function veeSetStat(k, val)
        if VModule then VModule[k] = val end
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "DisplayName") == "Veeronica" then t[k] = val end
            end
        end)
    end
    local function veeApplyStats()
        if not V.CustomStats then return end
        veeSetStat("Sk8Speed", V.Sk8Speed); veeSetStat("Sk8SpeedExhaust", V.Sk8Speed)
        veeSetStat("Sk8TrickAirborneSpeed", V.Sk8TrickSpeed)
        veeSetStat("Sk8BumpPower", V.Sk8BumpPower); veeSetStat("Sk8BumpChargedPower", V.Sk8BumpPower)
        veeSetStat("Sk8TrickStamina", V.Sk8TrickStamina); veeSetStat("Sk8TrickStaminaNerfed", V.Sk8TrickStamina)
        veeSetStat("Sk8TrickCooldown", V.Sk8TrickCooldown)
    end
    local function veeResetStats()
        veeSetStat("Sk8Speed", 1.15); veeSetStat("Sk8SpeedExhaust", 1.15)
        veeSetStat("Sk8TrickAirborneSpeed", 1.42)
        veeSetStat("Sk8BumpPower", 11.9); veeSetStat("Sk8BumpChargedPower", 15)
        veeSetStat("Sk8TrickStamina", 10); veeSetStat("Sk8TrickStaminaNerfed", 4)
        veeSetStat("Sk8TrickCooldown", 1)
    end
    local function veeIsVee()
        local c = lp.Character; if not c then return false end
        local name = c:GetAttribute("CharacterName") or c.Name
        return name == "Veeronica"
    end
    local function veeKillers()
        if KillersFolder then return KillersFolder end
        local p = workspace:FindFirstChild("Players")
        return p and p:FindFirstChild("Killers")
    end

    local veeATDebug = { result = "not run" }
    local function veeFindChaseHighlight(c)
        if not c then return nil, "no character" end
        local h = c:FindFirstChild("Highlight")
        if h and h:IsA("Highlight") and (h.Adornee == c or h.Adornee == nil) then
            return h, "char-direct"
        end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("Highlight") and (d.Adornee == c or d.Adornee == nil) then
                return d, "char-descendant"
            end
        end
        local parent = c.Parent
        if parent then
            for _, d in ipairs(parent:GetChildren()) do
                if d:IsA("Highlight") and d.Adornee == c then
                    return d, "parent-folder"
                end
            end
        end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, d in ipairs(hrp:GetChildren()) do
                if d:IsA("Highlight") then return d, "hrp" end
            end
        end
        for _, d in ipairs(workspace:GetChildren()) do
            if d:IsA("Highlight") and d.Adornee == c then
                return d, "workspace"
            end
        end
        local cam = workspace.CurrentCamera
        if cam then
            for _, d in ipairs(cam:GetChildren()) do
                if d:IsA("Highlight") and d.Adornee == c then
                    return d, "camera"
                end
            end
        end
        return nil, "no highlight found"
    end
    local function veeHighlighted(c)
        local h, where = veeFindChaseHighlight(c)
        veeATDebug.result = h and ("HIT: " .. tostring(where)) or "no highlight found"
        return h ~= nil
    end

    -- =====================================================
    -- Wall detection: 8 outward rays within radius.
    -- Returns ONLY the NEAREST horizontal wall.
    -- =====================================================
    local function veeWallCheck()
        local myRoot = getMyRoot()
        if not myRoot then return false, nil end
        local R = math.clamp(V.WallTrickRadius or 5, 1, 10)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local exclude = { lp.Character }
        local pf = workspace:FindFirstChild("Players")
        if pf then table.insert(exclude, pf) end
        params.FilterDescendantsInstances = exclude
        local origin = myRoot.Position

        -- Ray sweep: keep only the NEAREST wall
        local nearestInst, nearestDist = nil, math.huge
        for i = 0, 7 do
            local a = math.rad(i * 45)
            local dir = Vector3.new(math.cos(a), 0, math.sin(a)) * R
            local r = workspace:Raycast(origin, dir, params)
            if r and r.Instance and math.abs(r.Normal.Y) < 0.6 then
                local d = (r.Position - origin).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearestInst = r.Instance
                end
            end
        end

        -- Fallback overlap (irregular meshes): still keep only nearest
        if not nearestInst then
            local op = OverlapParams.new()
            op.FilterType = Enum.RaycastFilterType.Exclude
            op.FilterDescendantsInstances = exclude
            local parts = workspace:GetPartBoundsInRadius(origin, R * 0.6, op)
            for _, p in ipairs(parts) do
                if p:IsA("BasePart") and p.CanCollide and p.Size.Y >= math.min(p.Size.X, p.Size.Z) then
                    local d = (p.Position - origin).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearestInst = p
                    end
                end
            end
        end

        if nearestInst then return true, nearestInst end
        return false, nil
    end

    -- =====================================================
    -- Fire the stam / sprint UI button (Forsaken Plus style).
    -- =====================================================
    local function veeFireStamButton()
        local pg = lp:FindFirstChild("PlayerGui"); if not pg then return false end
        local targets = {}
        local main = pg:FindFirstChild("MainUI")
        if main then
            for _, n in ipairs({ "SprintingButton", "StaminaButton", "SprintButton" }) do
                local b = main:FindFirstChild(n)
                if b and b:IsA("GuiButton") then table.insert(targets, b) end
            end
            local ac = main:FindFirstChild("AbilityContainer")
            if ac then
                for _, n in ipairs({ "Sprint", "Stamina", "Sk8", "Skate" }) do
                    local b = ac:FindFirstChild(n)
                    if b and b:IsA("GuiButton") then table.insert(targets, b) end
                end
            end
        end
        if #targets == 0 and main then
            for _, d in ipairs(main:GetDescendants()) do
                if d:IsA("GuiButton") then
                    local n = d.Name:lower()
                    if n:find("sprint") or n:find("stam") or n:find("skate") or n == "sk8" then
                        table.insert(targets, d)
                    end
                end
            end
        end
        for _, b in ipairs(targets) do
            if firesignalF then
                if pcall(firesignalF, b.MouseButton1Click) then return true end
            end
            if getconnections then
                local any = false
                pcall(function()
                    for _, c in pairs(getconnections(b.MouseButton1Down)) do
                        pcall(function() c:Fire() end); any = true
                    end
                end)
                pcall(function()
                    for _, c in pairs(getconnections(b.Activated)) do
                        pcall(function() c:Fire() end); any = true
                    end
                end)
                if any then return true end
            end
            local ok = pcall(function()
                local cx = b.AbsolutePosition.X + b.AbsoluteSize.X * 0.5
                local cy = b.AbsolutePosition.Y + b.AbsoluteSize.Y * 0.5
                VIM:SendMouseButtonEvent(cx, cy, 0, true,  game, 1)
                task.wait(0.03)
                VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            end)
            if ok then return true end
        end
        return false
    end

    -- =====================================================
    -- Do the trick input. Prefers stam button; also fires Space.
    -- =====================================================
    local function veeDoTrickInput()
        local fired = false
        if V.WallTrickMode == "Button" or V.WallTrickMode == "Both" then
            fired = veeFireStamButton()
        end
        local isPC = (not UIS.TouchEnabled) or UIS.MouseEnabled
        if isPC and (V.WallTrickMode == "Key" or V.WallTrickMode == "Both" or not fired) then
            local ok = pcall(function()
                VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, false)
                task.wait(0.03)
                VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, false)
            end)
            if ok then return end
            if type(keypress) == "function" and type(keyrelease) == "function" then
                pcall(function()
                    keypress(Enum.KeyCode.Space)
                    task.wait(0.03)
                    keyrelease(Enum.KeyCode.Space)
                end)
                return
            end
            pcall(function()
                VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                task.wait(0.03)
                VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
        else
            local pg = lp:FindFirstChild("PlayerGui")
            local m  = pg and pg:FindFirstChild("MainUI")
            local b  = m and m:FindFirstChild("SprintingButton")
            if b and getconnections then
                for _, c in pairs(getconnections(b.MouseButton1Down)) do pcall(function() c:Fire() end) end
                task.wait(0.05)
                for _, c in pairs(getconnections(b.MouseButton1Up)) do pcall(function() c:Fire() end) end
                for _, c in pairs(getconnections(b.Activated)) do pcall(function() c:Fire() end) end
            end
        end
    end

    local function veeIsSkating()
        if not V.WallTrickRequireSkate then return true end
        local c = lp.Character; if not c then return false end
        local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
        return hrp:FindFirstChild("SkatePointer") ~= nil
    end

    local function veeAutoTrickStart()
        if V.AutoTrickThread then pcall(task.cancel, V.AutoTrickThread); V.AutoTrickThread = nil end
        if not V.AutoTrick then return end
        V.AutoTrickThread = task.spawn(function()
            while V.AutoTrick do
                RunService.Heartbeat:Wait()
                if not V.AutoTrick then break end

                local c = lp.Character
                if not c or not veeIsVee() then continue end
                if not veeIsSkating() then continue end

                local hasWall, wallInst
                if V.WallTrickUseHighlight and veeHighlighted(c) then
                    hasWall = true
                    wallInst = nil
                else
                    hasWall, wallInst = veeWallCheck()
                end

                if not hasWall then
                    -- No wall → clear memory so the same wall can retrigger later
                    V.WallTrickLastWall = nil
                    continue
                end

                -- Same wall as last time? Skip until it changes
                if wallInst and V.WallTrickLastWall == wallInst then
                    continue
                end

                if os.clock() - (V.WallTrickLast or 0) >= (V.WallTrickCooldown or 0.15) then
                    V.WallTrickLast = os.clock()
                    V.WallTrickLastWall = wallInst
                    pcall(veeDoTrickInput)
                end
            end
        end)
    end

    local function veeSkateCtrl(v)
        veeModules()
        local val = v and 6.5 or 0.65
        if VModule then VModule.Sk8TurnControl = val end
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "Sk8TurnControl") ~= nil then t.Sk8TurnControl = val end
            end
        end)
    end

    local veeARInstalled = false
    local function veeInstallAR()
        if veeARInstalled or not hookmetamethod or not getnamecallmethod then return end
        veeARInstalled = true
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if not V.AntiRebound then return old(self, ...) end
            if getnamecallmethod() == "FireServer" and self == RemoteEvent then
                local a = {...}
                local first = tostring(a[1] or "")
                local pn = lp.Name
                if veeIsVee() then
                    if first == pn .. "SkateRebound" then return end
                    if first == pn .. "StopSkate" and type(a[2]) == "table" then
                        for _, x in ipairs(a[2]) do
                            if typeof(x) == "Instance" then
                                pcall(function()
                                    RemoteEvent:FireServer(pn .. "StopSkate", { buffer.fromstring("\"Manual\"") })
                                end)
                                return
                            end
                        end
                    end
                end
            end
            return old(self, ...)
        end)
    end

    local veeUSk8 = false
    local function veeInstallUSk8()
        if veeUSk8 then return end
        veeUSk8 = true
        RunService.Heartbeat:Connect(function()
            if not V.UnlimitedSk8 or not Sprinting then return end
            local c = lp.Character; if not c then return end
            local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            if hrp:FindFirstChild("SkatePointer") then Sprinting.Stamina = Sprinting.MaxStamina end
        end)
    end

    local function veeFarmStart()
        if V.AutoFarmSk8Started then return end
        V.AutoFarmSk8Started = true
        task.spawn(function()
            while true do
                if V.AutoFarmSk8 and RemoteEvent then
                    pcall(function() RemoteEvent:FireServer(lp.Name .. "SkateTrick", {}) end)
                    task.wait(0.5)
                else
                    task.wait(0.1)
                end
            end
        end)
    end

    local function veeBypass(t)
        if type(t) ~= "table" then return end
        local s = t.Sk8; if type(s) ~= "table" or s.__bypassed then return end
        local cb = s.Callback; if type(cb) ~= "function" then return end
        s.__origCallback = cb; s.__bypassed = true
        s.Callback = function(...)
            local a = {...}; if a[3] == "BAD" then a[3] = nil end
            return cb(table.unpack(a))
        end
    end
    local function veeRestore(t)
        if type(t) ~= "table" then return end
        local s = t.Sk8; if type(s) ~= "table" or not s.__bypassed then return end
        if s.__origCallback then s.Callback = s.__origCallback; s.__origCallback = nil end
        s.__bypassed = nil
    end
    local function veeGetActor()
        veeModules()
        if not VUtil or type(VUtil.GetActor) ~= "function" then return nil end
        local ok, r = pcall(VUtil.GetActor, VUtil, lp)
        return (ok and type(r) == "table") and r or nil
    end
    local function veeSetEverywhere(v)
        veeModules()
        if v then
            if VModule and VModule.Abilities then veeBypass(VModule.Abilities) end
            local a = veeGetActor()
            if a then
                if a.Behavior and a.Behavior.Abilities then veeBypass(a.Behavior.Abilities) end
                if a.State then a.State.InZone = true end
            end
            pcall(function() if VUtil then VUtil:ToggleLockForAbilityIcon("Sk8", "NoCharges", false) end end)
            if V.Sk8EverywhereThread then pcall(task.cancel, V.Sk8EverywhereThread) end
            V.Sk8EverywhereThread = task.spawn(function()
                while task.wait(0.5) do
                    if not V.Sk8Everywhere then break end
                    if VModule and VModule.Abilities then veeBypass(VModule.Abilities) end
                    local a = veeGetActor()
                    if a then
                        if a.Behavior and a.Behavior.Abilities then veeBypass(a.Behavior.Abilities) end
                        if a.State then a.State.InZone = true end
                    end
                    pcall(function() if VUtil then VUtil:ToggleLockForAbilityIcon("Sk8", "NoCharges", false) end end)
                end
            end)
        else
            if V.Sk8EverywhereThread then pcall(task.cancel, V.Sk8EverywhereThread); V.Sk8EverywhereThread = nil end
            if VModule and VModule.Abilities then veeRestore(VModule.Abilities) end
            local a = veeGetActor()
            if a and a.Behavior and a.Behavior.Abilities then veeRestore(a.Behavior.Abilities) end
        end
    end

    local function veeAutoPhase(v)
        if V.AutoPhaseThread then pcall(task.cancel, V.AutoPhaseThread); V.AutoPhaseThread = nil end
        if not v then return end
        local Network
        pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end)
        V.AutoPhaseThread = task.spawn(function()
            while task.wait(0.5) do
                if not V.AutoPhase then break end
                if not Network then pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end) end
                local kf = veeKillers()
                if Network and veeIsVee() and kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        if not V.AutoPhase then break end
                        local h = k:FindFirstChildOfClass("Humanoid")
                        if h and h.Health > 0 then
                            pcall(function()
                                Network:FireServerConnection(lp.Name .. "SkatePhase", "REMOTE_EVENT", k)
                            end)
                            task.wait((VModule and VModule.Sk8PhaseTime or 3) + 0.6)
                        end
                    end
                end
            end
        end)
    end

