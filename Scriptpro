local lastBlockFire = 0
local BLOCK_METHOD = nil          -- "signal" | "remote" | nil
local SIGNAL_AVAILABLE = firesignalF ~= nil

local function fireBlock()
    local now = tick()
    if now - lastBlockFire < 0.02 then return false end
    lastBlockFire = now

    if BLOCK_METHOD == "signal" and SIGNAL_AVAILABLE then
        local btn = getBlockButton()
        if btn then
            pcall(firesignalF, btn.MouseButton1Click)
            return true
        end
        BLOCK_METHOD = nil
    end

    if BLOCK_METHOD == "remote" then
        if RemoteEvent then
            pcall(function() RemoteEvent:FireServer("UseActorAbility", {BLOCK_BUF}) end)
            return true
        end
        BLOCK_METHOD = nil
    end

    if SIGNAL_AVAILABLE then
        local btn = getBlockButton()
        if btn then
            if pcall(firesignalF, btn.MouseButton1Click) then
                BLOCK_METHOD = "signal"
                return true
            end
        end
    end
    if RemoteEvent then
        if pcall(function() RemoteEvent:FireServer("UseActorAbility", {BLOCK_BUF}) end) then
            BLOCK_METHOD = "remote"
            return true
        end
    end
    return false
end

