    local now = tick()
    if lastSoundFire[sound] and now - lastSoundFire[sound] < 0.04 then return end
    lastSoundFire[sound] = now
    local id = sound.SoundId and tostring(sound.SoundId):match("(%d+)")
    if not id or not TRIGGER_SOUNDS[id] then return end
    if soundNameIsBlocked(sound) then return end
    if BEHEAD_IDS[id] and IGNORE_BEHEAD then return end

    local killer = sound:FindFirstAncestorOfClass("Model")
    if not killer then return end
    local pf = Workspace:FindFirstChild("Players")
    local kf = pf and pf:FindFirstChild("Killers")
    if not kf or killer.Parent ~= kf then return end

    _G.SCPHub_LastLoggedID = id
    if LOG_IDS then print("[SCP Hub] Sound: " .. id .. " | Killer: " .. killer.Name) end

    local atk = getActiveM1(killer)

    if BoxCfg.Enabled and BoxCfg.AppearMode == "M1" then
        spawnM1Boxes(killer, "sound:" .. id, atk)
    end

    if not (AB_Cfg.Enabled or HMT.Enabled) then return end
    if not AB_Cfg.SoundTrigger then return end
    if not isSurvivor() or hasHelplessEffect() then return end

    task.spawn(tryBlock, killer, atk or "SoundFallback")
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local conn = sound.Played:Connect(function() onSoundTrigger(sound) end)
    sound.Destroying:Once(function()
        hookedSounds[sound] = nil; lastSoundFire[sound] = nil
        pcall(function() conn:Disconnect() end)
    end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end

