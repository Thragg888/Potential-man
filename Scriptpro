local ChanceAimbot = {
    Enabled = false, LockTime = 1.5, PredMin = 2, PredMax = 3,
    StrafeLeadMult = 1.0, TurnLeadMult = 1.0, FireRemote = true,
    _isLocking = false, _lockUntil = 0, _currentTarget = nil,
    _lastTrigger = 0, _hooked = {}, _lastSampleAt = 0,
    _lastPos = nil, _lastLook = nil, _angVel = 0, _strafeVel = 0,
}
local CHANCE_KILLER_NAMES = {
    ["jason"]=true, ["c00lkidd"]=true, ["johndoe"]=true, ["1x1x1x1"]=true,
    ["noli"]=true, ["slasher"]=true, ["nosferatu"]=true, ["azure"]=true,
    ["coolkid"]=true, ["coolkidd"]=true, ["sixer"]=true, ["666"]=true,
    ["guest666"]=true, ["doombringer"]=true, ["zombie king"]=true, ["azurewrath"]=true,
}
local CHANCE_ABILITY_KEYWORDS = {
    "oneshot","one_shot","one.shot","one-shot","one shot","oneshots",
    "1shot","1_shot","1-shot","flintlock","flint_lock","flint.lock",
    "flint-lock","flint lock","chanceoneshot","chance_oneshot","chance-oneshot",
    "chanceflintlock","chance_flintlock","chance-flintlock","chance flintlock",
}
local function chanceIsKillerName(name)
    name = string.lower(tostring(name or ""))
    if CHANCE_KILLER_NAMES[name] then return true end
    for k in pairs(CHANCE_KILLER_NAMES) do if name:find(k, 1, true) then return true end end
    return false
end
local function chanceGetNearestKiller()
    local my = getMyRoot(); if not my then return nil end
    local bestRoot, bestD = nil, math.huge
    local function check(model)
        if not model or not chanceIsKillerName(model.Name) then return end
        local r = model:FindFirstChild("HumanoidRootPart")
        local h = model:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 then return end
        local d = (my.Position - r.Position).Magnitude
        if d < bestD then bestD = d; bestRoot = r end
    end
    local folder = workspace:FindFirstChild("Players")
    local killers = folder and folder:FindFirstChild("Killers")
    if killers then for _, k in ipairs(killers:GetChildren()) do check(k) end end
    if not bestRoot then
        for _, m in ipairs(workspace:GetChildren()) do if m:IsA("Model") then check(m) end end
    end
    return bestRoot
end
local function chanceMatchesAbility(btn)
    local blobs = {}
    pcall(function()
        table.insert(blobs, string.lower(tostring(btn.Name or "")))
        if btn:IsA("TextButton") or btn:IsA("TextLabel") then table.insert(blobs, string.lower(tostring(btn.Text or ""))) end
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                table.insert(blobs, string.lower(tostring(d.Text or "")))
                table.insert(blobs, string.lower(tostring(d.Name or "")))
            end
        end
        if btn.Parent then table.insert(blobs, string.lower(tostring(btn.Parent.Name or ""))) end
    end)
    for _, blob in ipairs(blobs) do
        blob = blob:gsub("%s+", " ")
        for _, kw in ipairs(CHANCE_ABILITY_KEYWORDS) do
            if blob:find(kw, 1, true) then return true end
        end
    end
    return false
end
local function chanceYawDelta(prevLook, curLook)
    local a = Vector3.new(prevLook.X, 0, prevLook.Z)
    local b = Vector3.new(curLook.X, 0, curLook.Z)
    if a.Magnitude < 1e-4 or b.Magnitude < 1e-4 then return 0 end
    a = a.Unit; b = b.Unit
    local dot = math.clamp(a:Dot(b), -1, 1)
    local cross = a:Cross(b).Y
    return math.acos(dot) * (cross >= 0 and 1 or -1)
end
local function chanceSampleTarget(root, now)
    if not root or not root.Parent then return end
    local dt = now - (ChanceAimbot._lastSampleAt or 0)
    if dt < 0.016 then return end
    ChanceAimbot._lastSampleAt = now
    local look = root.CFrame.LookVector
    local vel  = root.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    if ChanceAimbot._lastLook and dt > 0 then
        local yawRate = chanceYawDelta(ChanceAimbot._lastLook, look) / dt
        ChanceAimbot._angVel = ChanceAimbot._angVel * 0.65 + yawRate * 0.35
        local rightV = root.CFrame.RightVector
        local rightH = Vector3.new(rightV.X, 0, rightV.Z)
        if rightH.Magnitude > 1e-4 then
            local strafe = horizVel:Dot(rightH.Unit)
            ChanceAimbot._strafeVel = ChanceAimbot._strafeVel * 0.65 + strafe * 0.35
        end
    end
    ChanceAimbot._lastPos = root.Position
    ChanceAimbot._lastLook = look
end
local function chancePredictPosition(root)
    if not root then return nil end
    local pos = root.Position
    local vel = root.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local speed = horizVel.Magnitude
    if speed > 200 then return pos end
    local baseLead = ChanceAimbot.PredMin + (ChanceAimbot.PredMax - ChanceAimbot.PredMin) * math.clamp(speed / 28, 0, 1)
    local predicted = pos
    if speed > 1.2 then predicted = pos + horizVel.Unit * baseLead end
    local rightV = root.CFrame.RightVector
    local rightH = Vector3.new(rightV.X, 0, rightV.Z)
    if rightH.Magnitude < 1e-4 then return predicted end
    local rightDir = rightH.Unit
    local strafe = ChanceAimbot._strafeVel or 0
    if math.abs(strafe) > 0.5 then
        predicted = predicted + rightDir * math.clamp(strafe * 0.18 * (ChanceAimbot.StrafeLeadMult or 1.0), -6, 6)
    end
    local angVel = ChanceAimbot._angVel or 0
    if math.abs(angVel) > 0.5 then
        predicted = predicted + rightDir * math.clamp(angVel * 2.5 * (ChanceAimbot.TurnLeadMult or 1.0), -5, 5)
    end
    return predicted
end
local function chanceDoAimlock(root)
    local me = getMyRoot()
    if not me or not root or not root.Parent then return end
    local aimAt = chancePredictPosition(root); if not aimAt then return end
    local myPos = me.Position
    me.AssemblyAngularVelocity = Vector3.zero
    me.CFrame = CFrame.new(myPos, Vector3.new(aimAt.X, myPos.Y, aimAt.Z))
end
local function chanceStartAimlock()
    if os.clock() - ChanceAimbot._lastTrigger < 0.12 then return end
    local root = chanceGetNearestKiller(); if not root then return end
    ChanceAimbot._lastTrigger = os.clock()
    ChanceAimbot._isLocking = true
    ChanceAimbot._lockUntil = os.clock() + ChanceAimbot.LockTime
    ChanceAimbot._currentTarget = root
    ChanceAimbot._lastSampleAt = 0
    ChanceAimbot._lastPos = nil; ChanceAimbot._lastLook = nil
    ChanceAimbot._angVel = 0; ChanceAimbot._strafeVel = 0
    chanceDoAimlock(root)
end
local function chanceHookButton(btn)
    if not btn or ChanceAimbot._hooked[btn] then return end
    if not (btn:IsA("GuiButton") or btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
    if not chanceMatchesAbility(btn) then return end
    ChanceAimbot._hooked[btn] = true
    local function fire() if not ChanceAimbot.Enabled then return end; chanceStartAimlock() end
    pcall(function() btn.Activated:Connect(fire) end)
    pcall(function() btn.MouseButton1Click:Connect(fire) end)
    pcall(function() btn.MouseButton1Down:Connect(fire) end)
    pcall(function() btn.TouchTap:Connect(fire) end)
    pcall(function()
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then fire() end
        end)
    end)
end
local function chanceScanButtons()
    pcall(function()
        local pg = lp:FindFirstChild("PlayerGui"); if not pg then return end
        for _, b in ipairs(pg:GetDescendants()) do chanceHookButton(b) end
    end)
end
task.spawn(function()
    while true do
        if ChanceAimbot.Enabled then chanceScanButtons(); task.wait(0.6)
        else task.wait(0.5) end
    end
end)
lp.CharacterAdded:Connect(function()
    ChanceAimbot._isLocking = false; ChanceAimbot._lockUntil = 0
    ChanceAimbot._currentTarget = nil; ChanceAimbot._hooked = {}
    ChanceAimbot._lastPos = nil; ChanceAimbot._lastLook = nil
    ChanceAimbot._angVel = 0; ChanceAimbot._strafeVel = 0
    task.wait(1.2)
