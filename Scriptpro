local KillerUtil = {
    ParryEnabled  = false,
    AimEnabled    = false,
    AimMode       = "HRP+Camera",
    AimPart       = "Head",
    AimMaxRange   = 500,
    M1AimDuration = 0.5,
    M1UseInput    = true,
    M1UseAnim     = true,
    M1UseSound    = true,
    AbilityMap    = {
        ["slasher"]  = "RagingPace",
        ["johndoe"]  = "DigitalFootprint",
        ["john"]     = "DigitalFootprint",
    },
    _animConns = {}, _parryCooldown = 0.15, _lastParryAt = 0,
    _inputConn = nil, _aimUntil = 0, _lastM1At = 0, _m1Cooldown = 0.05,
}
local KILLER_PARRY_ANIMS = {}
for id in pairs(M1_ANIM_IDS) do KILLER_PARRY_ANIMS[id] = true end

local function killerAbilityFromCharName()
    local char = lp.Character; if not char then return nil end
    local raw = tostring(char:GetAttribute("CharacterName") or char.Name or "")
    local normalized = string.lower(raw:gsub("%s+", ""))
    for kw, ability in pairs(KillerUtil.AbilityMap) do
        if normalized:find(kw, 1, true) then return ability end
    end
    return nil
end
local function fireKillerAbility(abilityName)
    if not abilityName or not RemoteEvent then return end
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { abilityName }) end)
    pcall(function() RemoteEvent:FireServer("UseActorAbility", abilityName) end)
end
local function killerParryOnAnim(animId)
    if not KillerUtil.ParryEnabled or not isKiller() then return end
    if not KILLER_PARRY_ANIMS[animId] then return end
    local now = tick()
    if now - KillerUtil._lastParryAt < KillerUtil._parryCooldown then return end
    KillerUtil._lastParryAt = now
    local ability = killerAbilityFromCharName()
    if ability then fireKillerAbility(ability) end
end
local function killerParryOnSound(soundId)
    if not KillerUtil.ParryEnabled or not isKiller() then return end
    if not TRIGGER_SOUNDS[soundId] then return end
    local now = tick()
    if now - KillerUtil._lastParryAt < KillerUtil._parryCooldown then return end
    KillerUtil._lastParryAt = now
    local ability = killerAbilityFromCharName()
    if ability then fireKillerAbility(ability) end
end
local function killerStartAimWindow()
    if not KillerUtil.AimEnabled or not isKiller() then return end
    local now = tick()
    if now - KillerUtil._lastM1At < KillerUtil._m1Cooldown then return end
    KillerUtil._lastM1At = now
    KillerUtil._aimUntil = now + KillerUtil.M1AimDuration
end
local function killerOnM1Anim(animId)
    if not M1_ANIM_IDS[animId] then return end
    if KillerUtil.M1UseAnim then killerStartAimWindow() end
end
local function killerOnM1Sound(soundId)
    if KillerUtil.M1UseSound and TRIGGER_SOUNDS[soundId] then killerStartAimWindow() end
end
local function bindKillerHooks(char)
    if not char then return end
    for _, c in ipairs(KillerUtil._animConns) do pcall(function() c:Disconnect() end) end
    KillerUtil._animConns = {}
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then
        task.delay(0.5, function() if char.Parent and isKiller() then bindKillerHooks(char) end end)
        return
    end
    table.insert(KillerUtil._animConns, animator.AnimationPlayed:Connect(function(track)
        local anim = track and track.Animation; if not anim then return end
        local id = tostring(anim.AnimationId):match("(%d+)"); if not id then return end
        killerParryOnAnim(id); killerOnM1Anim(id)
    end))
    local function hookS(s)
        if not s:IsA("Sound") then return end
        table.insert(KillerUtil._animConns, s.Played:Connect(function()
            local id = tostring(s.SoundId):match("(%d+)"); if not id then return end
            killerParryOnSound(id); killerOnM1Sound(id)
        end))
    end
    for _, d in ipairs(char:GetDescendants()) do hookS(d) end
    table.insert(KillerUtil._animConns, char.DescendantAdded:Connect(hookS))
end
local function bindKillerInput()
    if KillerUtil._inputConn then pcall(function() KillerUtil._inputConn:Disconnect() end); KillerUtil._inputConn = nil end
    KillerUtil._inputConn = UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if not KillerUtil.AimEnabled or not isKiller() or not KillerUtil.M1UseInput then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            killerStartAimWindow()
        end
    end)
end
bindKillerInput()
lp.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    if isKiller() then bindKillerHooks(c) end
end)
if lp.Character and isKiller() then bindKillerHooks(lp.Character) end
local function kAimFindNearestSurvivor()
    local myRoot = getMyRoot(); if not myRoot or not SurvivorsFolder then return nil end
    local best, bestDist = nil, KillerUtil.AimMaxRange or 500
    for _, s in ipairs(SurvivorsFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestDist = s, d end
            end
        end
    end
    return best
end
local function kAimPickTargetPart(survivor)
    if not survivor then return nil end
    local aimPart = survivor:FindFirstChild(KillerUtil.AimPart or "Head")
    if aimPart and aimPart:IsA("BasePart") then return aimPart end
    return survivor:FindFirstChild("HumanoidRootPart")
end
RunService:BindToRenderStep("WindHubKillerAim", Enum.RenderPriority.Camera.Value + 3, function()
    if not KillerUtil.AimEnabled or not isKiller() then return end
    if tick() > KillerUtil._aimUntil then return end
    local survivor = kAimFindNearestSurvivor(); if not survivor then return end
    local aimPart = kAimPickTargetPart(survivor); if not aimPart then return end
    local myRoot = getMyRoot(); if not myRoot then return end
    local targetPos = aimPart.Position
    local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
    if KillerUtil.AimMode == "Camera" or KillerUtil.AimMode == "HRP+Camera" then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
    end
    if KillerUtil.AimMode == "HRP" or KillerUtil.AimMode == "HRP+Camera" then
        myRoot.CFrame = CFrame.new(myRoot.Position, flat)
    end
end)

