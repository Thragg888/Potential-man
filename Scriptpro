-- =========================================================
-- Plus-style block firing — RACE (single attempt, fallback on error)
-- Preferred method is cached; flips only if the current one errors.
-- Only ONE method fires per trigger.
-- =========================================================
local lastBlockFire = 0
local lastPunchFire = 0
local PUNCH_COOLDOWN = 0.08

local CFG = {
    AutoBlockEnabled = false,
    BlockCooldown    = 27,
    BlockDelay       = 0,
    WallCheck        = true,
    SoundTrigger     = true,
    PunchAfterBlock  = false,
    PunchDelay       = 0.12,
}

-- Preferred block method: nil (unknown) | "signal" | "remote"
local BLOCK_METHOD = nil

local function trySignalBlock()
    if not firesignalF then return false end
    if not MainUI or not MainUI:FindFirstChild("AbilityContainer") then return false end
    local btn = MainUI.AbilityContainer:FindFirstChild("Block")
    if not btn or not btn:IsA("GuiButton") then return false end
    local ok = pcall(firesignalF, btn.MouseButton1Click)
    return ok
end

local function tryRemoteBlock()
    if not RemoteEvent then return false end
    local ok = pcall(function()
        RemoteEvent:FireServer("UseActorAbility", { BLOCK_BUF })
    end)
    if ok then return true end
    -- Backup arg shape
    ok = pcall(function()
        RemoteEvent:FireServer("UseActorAbility", "Block")
    end)
    return ok
end

local function firePunch()
    if not RemoteEvent then return end
    local now = tick()
    if now - lastPunchFire < PUNCH_COOLDOWN then return end
    lastPunchFire = now

    if firesignalF and MainUI and MainUI:FindFirstChild("AbilityContainer") then
        local btn = MainUI.AbilityContainer:FindFirstChild("Punch")
        if btn and btn:IsA("GuiButton") then
            if pcall(firesignalF, btn.MouseButton1Click) then return end
        end
    end
    pcall(function() RemoteEvent:FireServer("UseActorAbility", { PUNCH_BUF }) end)
end

local function fireBlock()
    local now = tick()
    if now - lastBlockFire < (CFG.BlockCooldown or 0.05) then return false end
    lastBlockFire = now

    local fired = false

    if BLOCK_METHOD == "signal" then
        fired = trySignalBlock()
        if not fired then
            BLOCK_METHOD = "remote"
            fired = tryRemoteBlock()
        end
    elseif BLOCK_METHOD == "remote" then
        fired = tryRemoteBlock()
        if not fired then
            BLOCK_METHOD = "signal"
            fired = trySignalBlock()
        end
    else
        -- First ever call — signal is the UI/fastest path, try it first
        fired = trySignalBlock()
        if fired then
            BLOCK_METHOD = "signal"
        else
            fired = tryRemoteBlock()
            if fired then BLOCK_METHOD = "remote" end
        end
    end

    if fired and CFG.PunchAfterBlock then
        task.delay(CFG.PunchDelay, function()
            pcall(firePunch)
        end)
    end

    return fired
end

