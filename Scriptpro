local function fireInteraction(obj, args)
    if not obj or not obj.Parent then return false end
    local fired = false
    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp and type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, pp); fired = true
    end
    local cd = obj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and type(fireclickdetector) == "function" then
        pcall(fireclickdetector, cd); fired = true
    end
    for _, fname in ipairs({"Remotes", "RemoteEvents", "Events", "Remote"}) do
        local folder = obj:FindFirstChild(fname)
        if folder then
            for _, re in ipairs(folder:GetChildren()) do
                if re:IsA("RemoteEvent") then
                    if args then
                        pcall(function() re:FireServer(table.unpack(args)) end)
                    else
                        pcall(function() re:FireServer() end)
                    end
                    fired = true
                end
            end
        end
    end
    local re = obj:FindFirstChildWhichIsA("RemoteEvent")
    if re then
        if args then
            pcall(function() re:FireServer(table.unpack(args)) end)
        else
            pcall(function() re:FireServer() end)
        end
        fired = true
    end
    return fired
end

local SKILL_UI = { ui = nil, lastScan = 0, lastPress = 0 }

local function findSkillCheckUI()
    if SKILL_UI.ui and SKILL_UI.ui.Parent and SKILL_UI.ui.Visible then return SKILL_UI.ui end
    SKILL_UI.ui = nil
    local now = tick()
    if now - SKILL_UI.lastScan < 0.04 then return nil end
    SKILL_UI.lastScan = now
    if not PlayerGui then return nil end
    for _, sg in ipairs(PlayerGui:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled then
            for _, d in ipairs(sg:GetDescendants()) do
                if d:IsA("GuiObject") and d.Visible then
                    local n = normalizeName(d.Name)
                    if n:find("skillcheck", 1, true)
                       or n:find("needle", 1, true)
                       or (n:find("skill", 1, true) and n:find("check", 1, true)) then
                        SKILL_UI.ui = d
                        return d
                    end
                end
            end
        end
    end
    return nil
end

local function pressSkillKey()
    local now = tick()
    if now - SKILL_UI.lastPress < 0.05 then return end
    SKILL_UI.lastPress = now
    pcall(function()
        VIM:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
        task.wait(0.03)
        VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

local function handleSkillCheck()
    local ui = findSkillCheckUI()
    if not ui then return false end
    if AUTOGEN.SkillCheckSpamMode then pressSkillKey(); return true end

    local needle, zone
    for _, d in ipairs(ui:GetDescendants()) do
        local n = normalizeName(d.Name)
        if not needle and (n:find("needle") or n:find("pointer") or n:find("marker")) then
            needle = d
        end
        if not zone and (n:find("zone") or n:find("target") or n:find("success") or n:find("hit")) then
            zone = d
        end
    end

    if needle and zone then
        if needle.Rotation ~= nil and zone.Rotation ~= nil then
            local nr = needle.Rotation % 360
            local zr = zone.Rotation % 360
            local zs = (zone.Size and math.abs(zone.Size.X.Scale * 360)) or 30
            local diff = math.abs((nr - zr + 180) % 360 - 180)
            if diff <= math.max(zs / 2, 8) then pressSkillKey() end
            return true
        end
        if needle.AbsolutePosition and zone.AbsolutePosition then
            local np = needle.AbsolutePosition.X + needle.AbsoluteSize.X / 2
            local zp = zone.AbsolutePosition.X
            local zw = zone.AbsoluteSize.X
            if np >= zp and np <= zp + zw then pressSkillKey() end
            return true
        end
    end

    local btn = ui:FindFirstChildWhichIsA("TextButton", true)
             or ui:FindFirstChildWhichIsA("ImageButton", true)
    if btn and firesignalF then
        pcall(firesignalF, btn.MouseButton1Click); return true
    end
    pressSkillKey()
    return true
end

local PUZZLE_TYPE_CACHE = setmetatable({}, { __mode = "k" })

local function getPuzzleType(gen)
    if not gen or not gen.Parent then return "unknown" end
    local cached = PUZZLE_TYPE_CACHE[gen]
    if cached and tick() - cached.time < 5 then return cached.type end

    local attr = gen:GetAttribute("PuzzleType") or gen:GetAttribute("Puzzle")
    if attr then
        local n = normalizeName(tostring(attr))
        local result
        if n:find("memory") then result = "memory"
        elseif n:find("gear") then result = "gear"
        elseif n:find("skill") or n:find("dbd") then result = "skillcheck"
        elseif n:find("basic") or n:find("simple") then result = "basic" end
        if result then
            PUZZLE_TYPE_CACHE[gen] = { type = result, time = tick() }
            return result
        end
    end

    local hasGear, hasCard, hasSkillMarker = false, false, false
    for _, d in ipairs(gen:GetDescendants()) do
        local n = normalizeName(d.Name)
        if not hasGear and (n:find("gear") or n:find("cog") or n:find("wheel") or n:find("ratchet")) then hasGear = true end
        if not hasCard and (n:find("card") or n:find("memory") or n:find("tile") or n:find("match")) then hasCard = true end
        if not hasSkillMarker and (n:find("skillcheck") or n:find("needle")) then hasSkillMarker = true end
        if hasGear and hasCard and hasSkillMarker then break end
    end

    local result
    if hasGear then result = "gear"
    elseif hasCard then result = "memory"
    elseif hasSkillMarker then result = "skillcheck"
    else result = "basic" end
    PUZZLE_TYPE_CACHE[gen] = { type = result, time = tick() }
    return result
end

local MEMORY = { Known = {}, LastClick = 0, ClickCooldown = 0.35 }

local function isCardLike(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    local n = normalizeName(obj.Name)
    if n:find("card", 1, true) or n:find("tile", 1, true)
       or n:find("memory", 1, true) or n:find("puzzlecard", 1, true) then
        return true
    end
    return obj:FindFirstChildWhichIsA("ClickDetector", true) ~= nil
        or obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
end

local function getCardIdentity(obj)
    for _, attr in ipairs({"Value", "Symbol", "Icon", "CardValue", "Match", "Type"}) do
        local a = obj:GetAttribute(attr)
        if a ~= nil then return tostring(a) end
    end
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("StringValue") or child:IsA("IntValue") then
            local n = normalizeName(child.Name)
            if n:find("value") or n:find("symbol") or n:find("icon") or n:find("type") then
                return tostring(child.Value)
            end
        elseif child:IsA("Decal") then
            return tostring(child.Texture)
        elseif child:IsA("ImageLabel") and child.Image ~= "" then
            return tostring(child.Image)
        end
    end
    return nil
end

local function collectCards(root, origin, radius)
    local out = {}
    for _, d in ipairs(root:GetDescendants()) do
        if isCardLike(d) and d.Parent then
            local p
            if d:IsA("BasePart") then p = d.Position
            elseif d:IsA("Model") then
                local prim = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                if prim then p = prim.Position end
            end
            if p and (p - origin).Magnitude <= radius then out[#out+1] = d end
        end
    end
    return out
end

local function tickMemoryPuzzle(root, origin)
    local cards = collectCards(root, origin, AUTOGEN.MaxDistance)
    if #cards < 2 then return false end
    local now = tick()
    if now - MEMORY.LastClick < MEMORY.ClickCooldown then return true end

    for i = 1, #cards - 1 do
        local a = cards[i]
        local aId = getCardIdentity(a) or MEMORY.Known[tostring(a)]
        if aId then
            for j = i + 1, #cards do
                local b = cards[j]
                local bId = getCardIdentity(b) or MEMORY.Known[tostring(b)]
                if bId == aId then
                    fireInteraction(a)
                    task.delay(0.15, function() fireInteraction(b) end)
                    MEMORY.Known[tostring(a)] = nil
                    MEMORY.Known[tostring(b)] = nil
                    MEMORY.LastClick = now
                    if AUTOGEN.Debug then print("[AG] Memory match:", tostring(aId)) end
                    return true
                end
            end
        end
    end

    local unknowns = {}
    for _, c in ipairs(cards) do
        if not MEMORY.Known[tostring(c)] and not getCardIdentity(c) then
            unknowns[#unknowns+1] = c
        end
    end
    if #unknowns >= 2 then
        local a, b = unknowns[1], unknowns[2]
        MEMORY.LastClick = now
        fireInteraction(a)
        task.delay(0.2, function()
            local va = getCardIdentity(a)
            if va then MEMORY.Known[tostring(a)] = va end
            task.wait(0.3)
            fireInteraction(b)
            task.delay(0.2, function()
                local vb = getCardIdentity(b)
                if vb then MEMORY.Known[tostring(b)] = vb end
            end)
        end)
        if AUTOGEN.Debug then print("[AG] Memory flip") end
        return true
    end
    return false
end

local GEAR = { LastFire = 0, FireInterval = 0.25 }

local function tickGearPuzzle(root, origin)
    local gears = {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Model") or d:IsA("BasePart") then
            local n = normalizeName(d.Name)
            if n:find("gear") or n:find("cog") or n:find("wheel") then
                local p = d:IsA("BasePart") and d
                       or (d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart"))
                if p and (p.Position - origin).Magnitude <= AUTOGEN.MaxDistance then
                    gears[#gears+1] = d
                end
            end
        end
    end
    if #gears == 0 then return false end

    local now = tick()
    if now - GEAR.LastFire < GEAR.FireInterval then return true end
    GEAR.LastFire = now

    for _, g in ipairs(gears) do
        local fired = false
        for _, re in ipairs(g:GetDescendants()) do
            if re:IsA("RemoteEvent") then
                local rn = normalizeName(re.Name)
                if rn:find("rotate") or rn:find("turn") or rn:find("spin") then
                    pcall(function() re:FireServer(AUTOGEN.RotateDirection) end)
                    fired = true
                end
            end
        end
        if not fired then fireInteraction(g, {AUTOGEN.RotateDirection}) end
    end
    return true
end

