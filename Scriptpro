local function setProgress(pct, status)
    Loading.Progress = math.clamp(tonumber(pct) or Loading.Progress, 0, 100)
    if Loading.GUI and Loading.GUI.Parent then
        if Loading.Bar then
            safeTween(Loading.Bar, TweenInfo.new(0.25, Enum.EasingStyle.Quad),
                { Size = UDim2.fromScale(Loading.Progress / 100, 1) })
        end
        if Loading.Pct then pcall(function() Loading.Pct.Text = math.floor(Loading.Progress) .. "%" end) end
        if Loading.Status and status then pcall(function() Loading.Status.Text = tostring(status) end) end
    end
end

local function finishLoading()
    if Loading.Done then return end
    setProgress(100, "Ready!")
    local elapsed = tick() - Loading.StartTime
    if elapsed < Loading.MinDisplayTime then task.wait(Loading.MinDisplayTime - elapsed) end
    Loading.Done = true
    local gui = Loading.GUI; Loading.GUI = nil
    if not gui or not gui.Parent then return end
    pcall(function()
        local ti = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("Frame") then safeTween(d, ti, { BackgroundTransparency = 1 })
            elseif d:IsA("TextLabel") or d:IsA("TextButton") then
                safeTween(d, ti, { TextTransparency = 1, TextStrokeTransparency = 1, BackgroundTransparency = 1 })
            elseif d:IsA("ImageLabel") then safeTween(d, ti, { ImageTransparency = 1 }) end
        end
        task.wait(0.7)
        if gui and gui.Parent then gui:Destroy() end
    end)
end

