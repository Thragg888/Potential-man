-- =========================================================
-- CHANCE AIMLOCK — rewritten (no lag + strafe/turn prediction)
-- =========================================================
ChanceAimbot = {
    Enabled = false,
    LockTime = 0.9,
    PredMin = 2,
    PredMax = 3,
    StrafeLeadMult = 1.0,
    TurnLeadMult = 1.0,
    FireRemote = true,
    _isLocking = false,
    _lockUntil = 0,
    _currentTarget = nil,
    _targetReacquireAt = 0,
    _lastTrigger = 0,
    _hooked = {},
    _buttonConn = nil,
    _lastSampleAt = 0,
    _lastPos = nil,
    _lastLook = nil,
    _angVel = 0,
    _strafeVel = 0,
}

local CHANCE_KILLER_NAMES = {
    ["jason"]=true, ["c00lkidd"]=true, ["johndoe"]=true, ["1x1x1x1"]=true,
    ["noli"]=true, ["slasher"]=true, ["nosferatu"]=true, ["azure"]=true,
    ["coolkid"]=true, ["coolkidd"]=true, ["sixer"]=true, ["666"]=true,
    ["guest666"]=true, ["doombringer"]=true, ["zombie king"]=true, ["azurewrath"]=true,
}
local CHANCE_ABILITY_KEYWORDS = {
    "oneshot","one_shot","one.shot","one-shot","one shot","oneshots","1shot","1_shot","1-shot",
    "flintlock","flint_lock","flint.lock","flint-lock","flint lock","flint",
    "chancegun","chance_gun","chance-gun","chance gun","chanceshot","chance_shot",
    "chance-shot","chance shot","chanceflintlock","chance_flintlock","chance-flintlock",
    "gun","shot","shoot","pistol","revolver","chanceoneshot","chance_oneshot","chance-oneshot",
}

local function chanceIsKillerName(name)
    name = string.lower(tostring(name or ""))
    if CHANCE_KILLER_NAMES[name] then return true end
    for k in pairs(CHANCE_KILLER_NAMES) do
        if name:find(k, 1, true) then return true end
    end
    return false
end

local function chanceGetNearestKiller()
    local my = getMyRoot()
    if not my then return nil end
    local bestRoot, bestD = nil, math.huge
    local function check(model)
        if not model or not chanceIsKillerName(model.Name) then return end
        local r = model:FindFirstChild("HumanoidRootPart")
        local h = model:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 then return end
        local d = (my.Position - r.Position).Magnitude
        if d < bestD then bestD = d; bestRoot = r end
    end
    local folder = workspace:FindFirstChild("Players")
    local killers = folder and folder:FindFirstChild("Killers")
    if killers then for _, k in ipairs(killers:GetChildren()) do check(k) end end
    if not bestRoot then
        for _, m in ipairs(workspace:GetChildren()) do if m:IsA("Model") then check(m) end end
    end
    return bestRoot
end

local function chanceMatchesAbility(btn)
    local blobs = {}
    pcall(function()
        table.insert(blobs, string.lower(tostring(btn.Name or "")))
        if btn:IsA("TextButton") or btn:IsA("TextLabel") then
            table.insert(blobs, string.lower(tostring(btn.Text or "")))
        end
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                table.insert(blobs, string.lower(tostring(d.Text or "")))
                table.insert(blobs, string.lower(tostring(d.Name or "")))
            end
        end
        if btn.Parent then table.insert(blobs, string.lower(tostring(btn.Parent.Name or ""))) end
    end)
    for _, blob in ipairs(blobs) do
        blob = blob:gsub("%s+", " ")
        for _, kw in ipairs(CHANCE_ABILITY_KEYWORDS) do
            if blob:find(kw, 1, true) then
                if kw == "shot" or kw == "gun" or kw == "shoot" then
                    if blob:find("oneshot", 1, true) or blob:find("one shot", 1, true)
                       or blob:find("flint", 1, true) or blob:find("chance", 1, true)
                       or blob:find("pistol", 1, true) or blob:find("revolver", 1, true) then
                        return true
                    end
                else return true end
            end
        end
    end
    return false
end

local function chanceYawDelta(prevLook, curLook)
    local a = Vector3.new(prevLook.X, 0, prevLook.Z)
    local b = Vector3.new(curLook.X, 0, curLook.Z)
    if a.Magnitude < 1e-4 or b.Magnitude < 1e-4 then return 0 end
    a = a.Unit; b = b.Unit
    local dot   = math.clamp(a:Dot(b), -1, 1)
    local cross = a:Cross(b).Y
    return math.acos(dot) * (cross >= 0 and 1 or -1)
end

local function chanceSampleTarget(root, now)
    if not root or not root.Parent then return end
    local dt = now - (ChanceAimbot._lastSampleAt or 0)
    if dt < 0.03 then return end
    ChanceAimbot._lastSampleAt = now

    local look = root.CFrame.LookVector
    local vel  = root.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)

    if ChanceAimbot._lastLook and dt > 0 then
        local yawRate = chanceYawDelta(ChanceAimbot._lastLook, look) / dt
        ChanceAimbot._angVel = ChanceAimbot._angVel * 0.65 + yawRate * 0.35
        local rightV = root.CFrame.RightVector
        local rightH = Vector3.new(rightV.X, 0, rightV.Z)
        if rightH.Magnitude > 1e-4 then
            local strafe = horizVel:Dot(rightH.Unit)
            ChanceAimbot._strafeVel = ChanceAimbot._strafeVel * 0.65 + strafe * 0.35
        end
    end
    ChanceAimbot._lastPos = root.Position
    ChanceAimbot._lastLook = look
end

local function chancePredictPosition(root)
    if not root then return nil end
    local pos = root.Position
    local vel = root.AssemblyLinearVelocity
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local speed = horizVel.Magnitude
    if speed > 200 then return pos end

    local baseLead = ChanceAimbot.PredMin
        + (ChanceAimbot.PredMax - ChanceAimbot.PredMin) * math.clamp(speed / 28, 0, 1)

    local predicted = pos
    if speed > 1.2 then
        predicted = pos + horizVel.Unit * baseLead
    end

    local rightV = root.CFrame.RightVector
    local rightH = Vector3.new(rightV.X, 0, rightV.Z)
    if rightH.Magnitude < 1e-4 then return predicted end
    local rightDir = rightH.Unit

    local strafe = ChanceAimbot._strafeVel or 0
    if math.abs(strafe) > 0.5 then
        local lateral = math.clamp(strafe * 0.18 * (ChanceAimbot.StrafeLeadMult or 1.0), -6, 6)
        predicted = predicted + rightDir * lateral
    end

    local angVel = ChanceAimbot._angVel or 0
    if math.abs(angVel) > 0.5 then
        local turn = math.clamp(angVel * 2.5 * (ChanceAimbot.TurnLeadMult or 1.0), -5, 5)
        predicted = predicted + rightDir * turn
    end

    return predicted
end

local function chanceDoAimlock(root)
    local me = getMyRoot()
    if not me or not root or not root.Parent then return end
    local aimAt = chancePredictPosition(root)
    if not aimAt then return end
    local myPos = me.Position
    me.AssemblyAngularVelocity = Vector3.zero
    me.CFrame = CFrame.new(myPos, Vector3.new(aimAt.X, myPos.Y, aimAt.Z))
end

local function chanceStartAimlock()
    if os.clock() - ChanceAimbot._lastTrigger < 0.12 then return end
    local root = chanceGetNearestKiller()
    if not root then return end
    ChanceAimbot._lastTrigger = os.clock()
    ChanceAimbot._isLocking = true
    ChanceAimbot._lockUntil = os.clock() + ChanceAimbot.LockTime
    ChanceAimbot._currentTarget = root
    ChanceAimbot._targetReacquireAt = 0
    ChanceAimbot._lastSampleAt = 0
    ChanceAimbot._lastPos = nil
    ChanceAimbot._lastLook = nil
    ChanceAimbot._angVel = 0
    ChanceAimbot._strafeVel = 0
    chanceDoAimlock(root)
end

local function chanceHookButton(btn)
    if not btn or ChanceAimbot._hooked[btn] then return end
    if not (btn:IsA("GuiButton") or btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
    if not chanceMatchesAbility(btn) then return end
    ChanceAimbot._hooked[btn] = true
    local function fire()
        if not ChanceAimbot.Enabled then return end
        chanceStartAimlock()
    end
    pcall(function() btn.Activated:Connect(fire) end)
    pcall(function() btn.MouseButton1Click:Connect(fire) end)
    pcall(function() btn.MouseButton1Down:Connect(fire) end)
    pcall(function() btn.TouchTap:Connect(fire) end)
    pcall(function()
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                fire()
            end
        end)
    end)
end

local function chanceScanButtons()
    pcall(function()
        local pg = lp:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, b in ipairs(pg:GetDescendants()) do chanceHookButton(b) end
    end)
end

task.spawn(function()
    while true do
        if ChanceAimbot.Enabled then
            chanceScanButtons()
            task.wait(0.6)
        else
            task.wait(0.5)
        end
    end
end)

lp.CharacterAdded:Connect(function()
    ChanceAimbot._isLocking = false
    ChanceAimbot._lockUntil = 0
    ChanceAimbot._currentTarget = nil
    ChanceAimbot._hooked = {}
    ChanceAimbot._lastPos = nil
    ChanceAimbot._lastLook = nil
    ChanceAimbot._angVel = 0
    ChanceAimbot._strafeVel = 0
    task.wait(1.2)
    if ChanceAimbot.Enabled then chanceScanButtons() end
end)

RunService:BindToRenderStep("ChanceAimbot", Enum.RenderPriority.Camera.Value + 2, function()
    if not ChanceAimbot.Enabled then return end
    if not ChanceAimbot._isLocking then return end
    local now = os.clock()
    if now > ChanceAimbot._lockUntil then
        ChanceAimbot._isLocking = false
        ChanceAimbot._currentTarget = nil
        ChanceAimbot._lastPos = nil
        ChanceAimbot._lastLook = nil
        return
    end
    local root = ChanceAimbot._currentTarget
    if not root or not root.Parent or now >= ChanceAimbot._targetReacquireAt then
        root = chanceGetNearestKiller()
        ChanceAimbot._currentTarget = root
        ChanceAimbot._targetReacquireAt = now + 0.15
    end
    if not root or not root.Parent then return end
    chanceSampleTarget(root, now)
    chanceDoAimlock(root)
end)

-- =========================================================
-- STAB (Teleport | Lerp | Sticky)
-- =========================================================
STAB = {
    Enabled = false, MovementMode = "Teleport",
    TeleportDelay = 0.02, LerpSpeed = 40,
    BehindOffset = 3.45, StickDuration = 1.35,
    MaxRange = 60, Cooldown = 0.5,
    HookDaggerButton = true, FireRemote = true,
    _lastStab = 0, _active = false, _moveConn = nil, _extraConns = {},
    _savedAutoRotate = true, _animConn = nil, _buttonConn = nil,
    _placePart = nil, _savedPrimary = nil,
    _stickyKiller = nil, _stickyEnd = 0,
}
local DAGGER_ANIM_IDS = { ["100725497418533"]=true, ["89448354637442"]=true }
local function stabGetMyHRP() local c=lp.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function stabGetKillerHRP(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
end
local function stabGetNearestKiller()
    local myRoot = stabGetMyHRP()
    if not myRoot or not KillersFolder then return nil, nil end
    local best, bestHRP, bestDist = nil, nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = stabGetKillerHRP(k)
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestHRP, bestDist = k, hrp, d end
            end
        end
    end
    return best, bestHRP
end
local function stabTargetCF(killer)
    local kHRP = killer and killer:FindFirstChild("HumanoidRootPart")
    if not kHRP then return nil end
    return kHRP.CFrame * CFrame.new(0, 0, STAB.BehindOffset or 3.45)
end
function STAB.Stop()
    STAB._active = false
    if STAB._moveConn then
        pcall(function() STAB._moveConn:Disconnect() end)
        STAB._moveConn = nil
    end
    for _, c in ipairs(STAB._extraConns) do pcall(function() c:Disconnect() end) end
    STAB._extraConns = {}
    if STAB._placePart then
        pcall(function() STAB._placePart:Destroy() end)
        STAB._placePart = nil
    end
    local char = lp.Character
    if char and STAB._savedPrimary then
        pcall(function() char.PrimaryPart = STAB._savedPrimary end)
        STAB._savedPrimary = nil
    end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.AutoRotate = STAB._savedAutoRotate end) end
    STAB._stickyKiller = nil
end
local function stabStartDirect(killer, skipRemote)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    STAB.Stop()
    STAB._active = true
    STAB._stickyKiller = killer
    STAB._savedAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    STAB._stickyEnd = tick() + (STAB.StickDuration or 1.35)
    task.spawn(function()
        local delay = (STAB.MovementMode == "Teleport") and (STAB.TeleportDelay or 0) or 0
        if delay > 0 then task.wait(delay) end
        if not STAB._active then return end
        if not skipRemote and STAB.FireRemote and RemoteEvent then
            pcall(function() RemoteEvent:FireServer("UseActorAbility", { DAGGER_BUF }) end)
        end
        local lastT = tick()
        STAB._moveConn = RunService.RenderStepped:Connect(function()
            if not STAB._active then return end
            if tick() >= STAB._stickyEnd then STAB.Stop(); return end
            local now = tick()
            local dt = math.clamp(now - lastT, 0.001, 0.1)
            lastT = now
            local char2 = lp.Character
            local hrp2 = char2 and char2:FindFirstChild("HumanoidRootPart")
            local k = STAB._stickyKiller
            if not hrp2 or not k or not k.Parent then STAB.Stop(); return end
            local target = stabTargetCF(k)
            if not target then return end
            if STAB.MovementMode == "Teleport" then
                hrp2.CFrame = target
            else
                local delta = target.Position - hrp2.Position
                local dist = delta.Magnitude
                if dist < 0.05 then
                    hrp2.CFrame = target
                else
                    local step = math.min(dist, (STAB.LerpSpeed or 40) * dt)
                    local newPos = hrp2.Position + delta.Unit * step
                    hrp2.CFrame = CFrame.lookAt(newPos, newPos + target.LookVector)
                end
            end
            hrp2.AssemblyLinearVelocity  = Vector3.zero
            hrp2.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
end
local function stabStartSticky(killer, skipRemote)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    STAB.Stop()
    local place = Instance.new("Part")
    place.Name         = "ViltrumiteStickyAnchor"
    place.Size         = Vector3.new(5.5, 5.5, 5.5)
    place.Transparency = 1
    place.CanCollide   = false
    place.CanQuery     = false
    place.CanTouch     = false
    place.Anchored     = true
    place.Massless     = true
    place.Parent       = char
    STAB._savedPrimary = char.PrimaryPart
    char.PrimaryPart   = place
    STAB._placePart    = place
    STAB._stickyKiller = killer
    STAB._stickyEnd    = tick() + (STAB.StickDuration or 1.35)
    STAB._active       = true
    STAB._savedAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    local seed = stabTargetCF(killer)
    if seed then place.CFrame = seed end
    if not skipRemote and STAB.FireRemote and RemoteEvent then
        pcall(function() RemoteEvent:FireServer("UseActorAbility", { DAGGER_BUF }) end)
    end
    local function enforce()
        if not STAB._active then return end
        if tick() >= STAB._stickyEnd then STAB.Stop(); return end
        if not place.Parent or not char.Parent then STAB.Stop(); return end
        local k = STAB._stickyKiller
        local kHRP = k and k:FindFirstChild("HumanoidRootPart")
        if not kHRP then STAB.Stop(); return end
        local target = kHRP.CFrame * CFrame.new(0, 0, STAB.BehindOffset or 3.45)
        place.CFrame = target
        place.AssemblyLinearVelocity  = Vector3.zero
        place.AssemblyAngularVelocity = Vector3.zero
        if hrp.Parent then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
    STAB._extraConns = {
        RunService.PreRender:Connect(enforce),
        RunService.Heartbeat:Connect(enforce),
        RunService.Stepped:Connect(enforce),
    }
    STAB._moveConn = RunService.RenderStepped:Connect(enforce)
end
function STAB.Activate(force, skipRemote)
    if not force and not STAB.Enabled then return end
    if STAB._active then return end
    if tick() - STAB._lastStab < STAB.Cooldown then return end
    if getMyRole() ~= "Survivors" then return end
    local myHRP = stabGetMyHRP(); if not myHRP then return end
    local killer, kHRP = stabGetNearestKiller()
    if not killer or not kHRP then return end
    if (kHRP.Position - myHRP.Position).Magnitude > STAB.MaxRange then return end
    STAB._lastStab = tick()
    if STAB.MovementMode == "Sticky" then
        stabStartSticky(killer, skipRemote)
    else
        stabStartDirect(killer, skipRemote)
    end
end
_G.ViltrumiteStabActivate = STAB.Activate

local function stabBindAnimator()
    if STAB._animConn then pcall(function() STAB._animConn:Disconnect() end); STAB._animConn = nil end
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    STAB._animConn = animator.AnimationPlayed:Connect(function(track)
        if not STAB.Enabled then return end
        local a = track and track.Animation
        local id = a and tostring(a.AnimationId):match("%d+")
        if id and DAGGER_ANIM_IDS[id] then
            task.spawn(function() STAB.Activate(false, true) end)
        end
    end)
end
local function stabHookButton()
    if STAB._buttonConn then pcall(function() STAB._buttonConn:Disconnect() end); STAB._buttonConn = nil end
    if not STAB.HookDaggerButton then return end
    local function isDaggerButton(gui)
        if not gui or not gui:IsA("GuiButton") then return false end
        local n = string.lower(gui.Name)
        return n:find("dagger") or n:find("backstab") or n == "stab"
    end
    local function attach(gui)
        if not isDaggerButton(gui) then return end
        if gui:GetAttribute("ViltrumiteHooked") then return end
        gui:SetAttribute("ViltrumiteHooked", true)
        gui.Activated:Connect(function()
            if not STAB.Enabled then return end
            task.spawn(function() STAB.Activate(false, true) end)
        end)
    end
    for _, d in ipairs(lp.PlayerGui:GetDescendants()) do attach(d) end
    STAB._buttonConn = lp.PlayerGui.DescendantAdded:Connect(attach)
end
stabBindAnimator()
stabHookButton()
lp.CharacterAdded:Connect(function()
    STAB.Stop()
    task.wait(0.5)
    stabBindAnimator()
    stabHookButton()
end)

