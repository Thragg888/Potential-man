local ChanceAimbot = {
    Enabled = false, LockTime = 0.9, PredMin = 2, PredMax = 3,
    TurnLeadMult = 1.0, FireRemote = true,
    _isLocking = false, _lockUntil = 0, _currentTarget = nil,
