    local fired = false
    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp and type(fireproximityprompt) == "function" then pcall(fireproximityprompt, pp); fired = true end
    local cd = obj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and type(fireclickdetector) == "function" then pcall(fireclickdetector, cd); fired = true end
    for _, fname in ipairs({"Remotes", "RemoteEvents", "Events", "Remote"}) do 
        local folder = obj:FindFirstChild(fname)
        if folder then 
            for _, re in ipairs(folder:GetChildren()) do 
                if re:IsA("RemoteEvent") then 
                    if args then pcall(function() re:FireServer(table.unpack(args)) end) 
                    else pcall(function() re:FireServer() end) end
                    fired = true 
                end 
            end 
        end 
    end
    local re = obj:FindFirstChildWhichIsA("RemoteEvent")
    if re then 
        if args then pcall(function() re:FireServer(table.unpack(args)) end) 
        else pcall(function() re:FireServer() end) end
