local AB_Cfg = { Enabled=false, WallCheck=true, SoundTrigger=true, AnimTrigger=true }
local RAY_LOS = RaycastParams.new()
RAY_LOS.FilterType = Enum.RaycastFilterType.Exclude
RAY_LOS.IgnoreWater = true

local function performBlockCheck(killerModel)
    if not AB_Cfg.Enabled or not isSurvivor() or hasHelplessEffect() then return end
    if not killerModel or not killerModel.Parent then return end
    local kRoot = killerModel:FindFirstChild("HumanoidRootPart"); if not kRoot then return end
    local look = kRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-4 then return end
    flat = flat.Unit
    local cp = Instance.new("Part")
    cp.Anchored = true; cp.CanCollide = false; cp.CanTouch = false; cp.CanQuery = false
    cp.Massless = true; cp.CastShadow = false; cp.Transparency = 1
    cp.Size = Vector3.new(BoxCfg.Width, BoxCfg.Height, BoxCfg.Length)
    cp.CFrame = CFrame.lookAt(
        kRoot.Position + flat * (BoxCfg.Length * 0.5),
        kRoot.Position + flat * (BoxCfg.Length * 0.5 + 1))
    cp.Parent = Workspace
    local inBox = false
    if lp.Character then
        local p = OverlapParams.new()
        p.FilterType = Enum.RaycastFilterType.Include
        p.FilterDescendantsInstances = { lp.Character }
        inBox = #Workspace:GetPartsInPart(cp, p) > 0
    end
    cp:Destroy()
    if inBox and AB_Cfg.WallCheck then
        local mr = getMyRoot()
        if mr then
            RAY_LOS.FilterDescendantsInstances = { lp.Character, killerModel }
            if Workspace:Raycast(mr.Position, kRoot.Position - mr.Position, RAY_LOS) then inBox = false end
        end
    end
    if inBox then fireBlock() end
end

local function performAnimBlockCheck(killer, attackType)
    if not AB_Cfg.Enabled or not AB_Cfg.AnimTrigger then return end
    if not isSurvivor() or hasHelplessEffect() then return end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local qh = killer:FindFirstChild("QueryHitbox"); if not qh then return end
    local custom = CUSTOM_HITBOXES[attackType]
    local boxSize = custom and custom.Size or Vector3.new(5.2, 6, 5.65)
    local boxOffset = custom and custom.Offset or CFrame.new(0, 0, -3.5)
    local p = OverlapParams.new()
    p.FilterType = Enum.RaycastFilterType.Include
    p.MaxParts = 1
    for _ = 1, 12 do
        if hasHelplessEffect() or not lp.Character then return end
        local mh = lp.Character:FindFirstChild("QueryHitbox"); if not mh then return end
        p.FilterDescendantsInstances = { mh }
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.CastShadow = false
        part.Material = Enum.Material.ForceField
        part.Size = boxSize * 2.2
        part.CFrame = qh.CFrame * boxOffset
        part.Transparency = 1
        part.Parent = Workspace
        local hits = Workspace:GetPartsInPart(part, p)
        part:Destroy()
        if #hits > 0 then fireBlock(); return end
        task.wait(0.02)
    end
end

local killerAttackConns = setmetatable({}, { __mode = "k" })
local function hookKillerForAttack(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerAttackConns[killer] then return end
    local function tryHook()
