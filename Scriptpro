local Misc_HideInjury = false
local Misc_DisableBlindness = false

local injuryWasHidden = setmetatable({}, { __mode = "k" })
local blindnessWasHidden = setmetatable({}, { __mode = "k" })

local function applyInjuryTo(inst)
    if inst.Name == "redFlash" or inst.Name == "injuredVignette" then
        if Misc_HideInjury then
            pcall(function() inst.Visible = false end)
            injuryWasHidden[inst] = true
        elseif injuryWasHidden[inst] then
            pcall(function() inst.Visible = true end)
            injuryWasHidden[inst] = nil
        end
    elseif inst.Name == "HealthDesaturation" then
        if Misc_HideInjury then
            pcall(function() inst.Enabled = false end)
            injuryWasHidden[inst] = true
        elseif injuryWasHidden[inst] then
            pcall(function() inst.Enabled = true end)
            injuryWasHidden[inst] = nil
        end
    end
end
local function applyBlindnessTo(inst)
    if inst.Name == "BlindnessBlur" and inst:IsA("BlurEffect") then
        if Misc_DisableBlindness then
            pcall(function() inst.Enabled = false end)
            blindnessWasHidden[inst] = true
        elseif blindnessWasHidden[inst] then
            pcall(function() inst.Enabled = true end)
            blindnessWasHidden[inst] = nil
        end
    end
end
