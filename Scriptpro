local killerAttackConns = setmetatable({}, { __mode = "k" })
local killerM1Conns    = setmetatable({}, { __mode = "k" })

local function hookKillerForAttack(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerAttackConns[killer] then return end

    local function setup()
        if killerAttackConns[killer] then return false end
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end

        local conn = animator.AnimationPlayed:Connect(function(track)
            if not (AB_Cfg.Enabled or HMT.Enabled) then return end
            if not AB_Cfg.AnimTrigger then return end
            local atk = resolveM1Anim(track)
            if not atk then return end

            if BoxCfg.Enabled and BoxCfg.AppearMode == "M1" then
                spawnM1Boxes(killer, "anim", atk)
            end
            task.spawn(tryBlock, killer, atk)
        end)
        killerAttackConns[killer] = conn
        animator.Destroying:Once(function()
            if killerAttackConns[killer] == conn then
                pcall(function() conn:Disconnect() end)
                killerAttackConns[killer] = nil
            end
        end)
        return true
    end

    if setup() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function()
        if setup() then
            if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
        end
    end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and setup() then
            if c1 then c1:Disconnect() end; if c2 then c2:Disconnect() end
        end
    end)
end

local function hookKillerForM1(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerM1Conns[killer] then return end

    local function setup()
        if killerM1Conns[killer] then return false end
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end

        local conn = animator.AnimationPlayed:Connect(function(track)
            if not BoxCfg.Enabled or BoxCfg.AppearMode ~= "M1" then return end
            if AB_Cfg.AnimTrigger and (AB_Cfg.Enabled or HMT.Enabled) then return end -- avoid double
            local m1 = resolveM1Anim(track)
            if m1 then spawnM1Boxes(killer, "anim-only", m1) end
        end)
        killerM1Conns[killer] = conn
        animator.Destroying:Once(function()
            if killerM1Conns[killer] == conn then
                pcall(function() conn:Disconnect() end)
                killerM1Conns[killer] = nil
            end
        end)
        return true
    end

    if setup() then return end
    killer.ChildAdded:Connect(setup)
    killer.DescendantAdded:Connect(function(d) if d:IsA("Animator") then setup() end end)
end

