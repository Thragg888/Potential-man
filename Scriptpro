-- Block check (sound method)
-- =========================================================
local function performBlockCheck(killerModel)
    if not CFG.AutoBlockEnabled or not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return end

    local look = killerRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-4 then return end
    flat = flat.Unit

    local checkPart = Instance.new("Part")
    checkPart.Name = "WindHubBlockCheck"
    checkPart.Anchored = true
    checkPart.CanCollide = false
    checkPart.CanTouch = false
    checkPart.CanQuery = false
    checkPart.Massless = true
    checkPart.CastShadow = false
    checkPart.Material = Enum.Material.Neon
    checkPart.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    checkPart.CFrame = CFrame.lookAt(
        killerRoot.Position + flat * (FacingVisual.BoxLength * 0.5),
        killerRoot.Position + flat * (FacingVisual.BoxLength * 0.5 + 1)
    )
    checkPart.Transparency = 1
    checkPart.Parent = workspace

    local inBox = false
    if lp.Character then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { lp.Character }
        local parts = workspace:GetPartsInPart(checkPart, params)
        inBox = #parts > 0
    end
    checkPart:Destroy()

    if inBox and CFG.WallCheck then
        local myRoot = getMyRoot()
        if myRoot then
            local delta = killerRoot.Position - myRoot.Position
            RAY_LOS.FilterDescendantsInstances = { lp.Character, killerModel }
            if workspace:Raycast(myRoot.Position, delta, RAY_LOS) then
                inBox = false
            end
        end
    end

    if inBox then
        fireBlock()
        if HDT and HDT.Enabled and HDT.AutoTrigger then
            task.spawn(function() pcall(function() HDT_Trigger(false) end) end)
        end
    end
end

-- =========================================================
-- Block check (Forsaken Plus animation method)
-- =========================================================
local function performAnimationBlockCheck(killer, attackType)
    if not CFG.AutoBlockEnabled or not CFG.AnimTrigger then return end
    if not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killer or not killer.Parent then return end

    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local queryHitbox = killer:FindFirstChild("QueryHitbox")
    if not queryHitbox then return end

    local custom = CUSTOM_HITBOXES[attackType]
    local boxSize = custom and custom.Size or Vector3.new(5.2, 6, 5.65)
    local boxOffset = custom and custom.Offset or CFrame.new(0, 0, -3.5)

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.MaxParts = 1

    for _ = 1, 12 do
        if hasHelplessEffect() then return end
        if not lp.Character then return end
        local myHitbox = lp.Character:FindFirstChild("QueryHitbox")
        if not myHitbox then return end
        params.FilterDescendantsInstances = { myHitbox }

        local part = Instance.new("Part")
        part.Name = "WindHubAttackCheck"
        part.Anchored = true
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.CastShadow = false
        part.Material = Enum.Material.ForceField
        part.Size = boxSize * 2.2
        part.CFrame = queryHitbox.CFrame * boxOffset
        part.Transparency = 1
        part.Parent = workspace

        local hits = workspace:GetPartsInPart(part, params)
        part:Destroy()

        if #hits > 0 then
            fireBlock()
            if HDT and HDT.Enabled and HDT.AutoTrigger then
                task.spawn(function() pcall(function() HDT_Trigger(false) end) end)
            end
            return
        end
        task.wait(0.02)
    end
end

local killerAttackConns = setmetatable({}, { __mode = "k" })
local function hookKillerForAttack(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerAttackConns[killer] then return end
    local function tryHook()
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        killerAttackConns[killer] = animator.AnimationPlayed:Connect(function(track)
            if not CFG.AutoBlockEnabled or not CFG.AnimTrigger then return end
            if not isSurvivor() or hasHelplessEffect() then return end
            local anim = track and track.Animation; if not anim then return end
            local id = tostring(anim.AnimationId):match("(%d+)")
            local attackType = id and ATTACK_ANIM_MAP[id]
            if not attackType then return end
            task.spawn(function()
                pcall(performAnimationBlockCheck, killer, attackType)
            end)
        end)
        return true
    end
    if tryHook() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function()
        if tryHook() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
end

local lastAutoBlockByKiller = setmetatable({}, { __mode = "k" })
local AUTO_BLOCK_KILLER_DEBOUNCE = 0.06
local function tryAutoBlock(killerModel, soundId)
    if not CFG.AutoBlockEnabled then return end
    if not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killerModel or not killerModel.Parent then return end
    if IGNORE_BEHEAD and soundId and BEHEAD_SOUND_IDS[soundId] then return end
    local now = tick()
    local last = lastAutoBlockByKiller[killerModel]
    if last and now - last < AUTO_BLOCK_KILLER_DEBOUNCE then return end
    lastAutoBlockByKiller[killerModel] = now
    performBlockCheck(killerModel)
end

