-- =========================================================
local killerM1Conns = setmetatable({}, { __mode = "k" })
local function hookKillerForM1(killer)
    if not killer or not killer:IsA("Model") then return end
    if killerM1Conns[killer] then return end
    local function tryHook()
        local hum = killer:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return false end
        killerM1Conns[killer] = animator.AnimationPlayed:Connect(function(track)
            if not BoxCfg.Enabled then return end
            local anim = track and track.Animation; if not anim then return end
            local id = tostring(anim.AnimationId):match("(%d+)")
            if not id or not ATTACK_ANIM_MAP[id] then return end
            if BoxCfg.AppearMode == "M1" then
                spawnM1Box(killer)
            else
                -- Always mode - just refresh appearance (box already visible)
                local data = BoxCfg.boxes[killer]
                if data then applyLongBoxAppearance(data, killer) end
            end
        end)
        return true
    end
    if tryHook() then return end
    local c1, c2
    c1 = killer.ChildAdded:Connect(function() if tryHook() then
        if c1 then c1:Disconnect() end
        if c2 then c2:Disconnect() end
    end end)
    c2 = killer.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") and tryHook() then
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end
    end)
end

