}
local ESP_TRACK = setmetatable({}, { __mode = "k" })

local function espClear(m)
    local t = ESP_TRACK[m]; if not t then return end
    for _, o in pairs(t) do if o then pcall(function() o:Destroy() end) end end
    ESP_TRACK[m] = nil
end

local function espEnsure(m, cfg, isKiller, myHrp)
    if not m or not m.Parent then espClear(m); return end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then espClear(m); return end

    -- fully disabled → clear and return
    if not cfg.Enabled and not cfg.TextEnabled then
        if ESP_TRACK[m] then espClear(m) end
