        for _, s in ipairs(list) do
            local t = s:FindFirstChild("HumanoidRootPart")
            if t then
                local d = (t.Position - hrp.Position).Magnitude
                if AntiBS.Mode == "Around" then
                    if d <= AntiBS.Range then abInZone = true; if d < best then best=d; abTarget=s end
                    elseif not abTarget then abTarget = s end
                else
                    if d <= AntiBS.Range then
                        local look = hrp.CFrame.LookVector
                        local toT = t.Position - hrp.Position
                        local unit = toT.Magnitude > 0.05 and toT.Unit or -look
                        local ang = math.deg(math.acos(math.clamp((-look):Dot(unit), -1, 1)))
                        if ang <= AntiBS.Angle/2 then abInZone = true; if d<best then best=d; abTarget=s end
                        elseif not abTarget then abTarget = s end
                    elseif not abTarget then abTarget = s end
                end
            end
