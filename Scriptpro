                GENERATOR_HIGHLIGHTS[g] = hl
            end
        end
    end
    for g, hl in pairs(GENERATOR_HIGHLIGHTS) do
        if not seen[g] or not g.Parent then
            pcall(function() hl:Destroy() end); GENERATOR_HIGHLIGHTS[g] = nil
        end
    end
end
local ITEM_NAMES = { Medkit = Color3.fromRGB(255, 105, 180), BloxyCola = Color3.fromRGB(0, 150, 255) }
local ITEM_HIGHLIGHTS = setmetatable({}, { __mode = "k" })
local function scanItems()
    local seen = {}
    local function tryAdd(item)
        if not item:IsA("Tool") then return end
        local c = ITEM_NAMES[item.Name]; if not c then return end
        local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
        if not handle then return end
        seen[item] = true
        local hl = ITEM_HIGHLIGHTS[item]
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.Name = "SCPHubESPItem"; hl.Adornee = handle
            hl.FillColor = c; hl.OutlineColor = c
            hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = handle
            ITEM_HIGHLIGHTS[item] = hl
        else
            hl.Adornee = handle; hl.FillColor = c; hl.OutlineColor = c
        end
    end
    local map = workspace:FindFirstChild("Map")
    local ingame = map and map:FindFirstChild("Ingame")
    if ingame then
        for _, d in ipairs(ingame:GetDescendants()) do pcall(tryAdd, d) end
    end
    for _, d in ipairs(workspace:GetChildren()) do pcall(tryAdd, d) end
    for itm, hl in pairs(ITEM_HIGHLIGHTS) do
        if not seen[itm] or not itm.Parent then
            pcall(function() hl:Destroy() end); ITEM_HIGHLIGHTS[itm] = nil
        end
    end
end
