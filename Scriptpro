local AIM = {
    Enabled = false, AimMode = "Camera", Smooth = 1.0,
    PredictMode = "Both", PredictLead = 0.15, PingMult = 1.0,
    CurrentAbility = nil, CachedTargetHRP = nil, _aimUntil = 0,
}
local PING_ABILITIES = { AimGun = true, GunFire = true, GunExplode = true, GunFail = true }
local function getPing()
    local ok, v = pcall(function() return lp:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
    return ok and type(v) == "number" and v or 0
end
local function isPlayingSurvivor()
    if getMyRole() ~= "Survivors" then return false end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
local function updateCachedTarget()
    local myRoot = getRoot(lp.Character)
    if not myRoot or not KillersFolder then AIM.CachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(KillersFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    AIM.CachedTargetHRP = best
end
task.spawn(function() while true do task.wait(0.05); pcall(updateCachedTarget) end end)

local function isPingAbility(n) return n and PING_ABILITIES[n] == true end
local function predictHRP(hrp)
    if not hrp then return nil end
    if AIM.PredictMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end
    local velLead, pingLead = 0, 0
    if AIM.PredictMode == "Velocity" or AIM.PredictMode == "Both" then velLead = AIM.PredictLead end
    if isPingAbility(AIM.CurrentAbility)
        and (AIM.PredictMode == "Ping" or AIM.PredictMode == "Both") then
        pingLead = math.clamp(getPing() * 0.5 * AIM.PingMult, 0, 0.5)
    end
    return hrp.Position + vel * math.clamp(velLead + pingLead, 0, 0.75)
end
local function AimFor(duration, abilityName)
    AIM._aimUntil = tick() + (duration or 1.0)
    AIM.CurrentAbility = abilityName
end
local autoRotSaved = nil
local function restoreAutoRotate()
    if autoRotSaved == nil then return end
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = autoRotSaved end
    autoRotSaved = nil
end
local function disableAutoRotate()
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if autoRotSaved == nil then autoRotSaved = hum.AutoRotate end
    hum.AutoRotate = false
end
lp.CharacterAdded:Connect(function() autoRotSaved = nil end)

local function ballisticAim(targetPos, projSpeed, gravity)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetPos then return targetPos end
    local origin = myRoot.Position
    local delta = targetPos - origin
    local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
    if horiz < 0.1 then return targetPos end
    local vert = delta.Y
    local v2 = projSpeed * projSpeed
    local g = gravity or workspace.Gravity
    local disc = v2 * v2 - g * (g * horiz * horiz + 2 * vert * v2)
    if disc < 0 then
        return targetPos + Vector3.new(0, math.clamp(horiz * 0.15, 0, 20), 0)
    end
    local angle = math.atan2(v2 - math.sqrt(disc), g * horiz)
    return origin + Vector3.new(delta.X, 0, delta.Z).Unit * horiz
        + Vector3.new(0, horiz * math.tan(angle), 0)
end

local STUN_ABILITY_KEYS = {
    Punch = true, Slash = true, OneShot = true, AimGun = true,
    GunFire = true, CrystalPitch = true, Hatchet = true,
}
local ABILITY_LOCKS = {
    Punch=2.00, Slash=0.80, OneShot=1.20, AimGun=0.60,
    GunFire=1.20, CrystalPitch=1.40, Hatchet=0.95,
}
local DEFAULT_LOCK = 0.85
local ABILITY_AIM_PART = {
    Punch="Head", Slash="Head", OneShot="Head", AimGun="Head",
    GunFire="Head", CrystalPitch="Head", Hatchet="Head",
}
local BALLISTIC = { CrystalPitch = true }
local TRIGGER_WINDOW = 0.18
local STUN_ANIMS = {}
local STUN_BY_ABILITY = {}
local GUEST_PUNCH_ANIMS = {
    ["126830014841198"]="Punch", ["126355327951215"]="Punch", ["121086746534252"]="Punch",
}
local AbilityHook = {
    Enabled = true, Cooldown = 1.0, LockMultiplier = 1.0,
    _lastFire = 0, _animConn = nil, _registered = 0, _lastName = "", _lastSkin = "",
}
local function registerGuestPunchAnims()
    local lock = ABILITY_LOCKS.Punch or DEFAULT_LOCK
    local aimPart = ABILITY_AIM_PART.Punch or "Head"
    for id in pairs(GUEST_PUNCH_ANIMS) do
        STUN_ANIMS[id] = { Ability="Punch", Lock=lock, AimPart=aimPart, Ballistic=false }
        AbilityHook._registered += 1
    end
    STUN_BY_ABILITY.Punch = { AimPart=aimPart, Ballistic=false, Lock=lock }
end
local function extractAnimIds(v, out)
    out = out or {}
    if type(v) == "string" then
        local id = v:match("(%d+)"); if id then out[#out + 1] = id end
    elseif type(v) == "number" then out[#out + 1] = tostring(v)
    elseif type(v) == "table" then for _, x in pairs(v) do extractAnimIds(x, out) end end
    return out
end
local function getAnimsTable(cfg)
    if type(cfg) ~= "table" then return nil end
    if type(cfg.Animations) == "table" then return cfg.Animations end
    if type(cfg.Config) == "table" and type(cfg.Config.Animations) == "table" then
        return cfg.Config.Animations
    end
end
local function isStunAbility(n) return STUN_ABILITY_KEYS[n] == true end
local function registerAnimsFrom(anims)
    if not anims then return 0 end
    local count = 0
    for abilityName, animValue in pairs(anims) do
        if isStunAbility(abilityName) then
            local lock = ABILITY_LOCKS[abilityName] or DEFAULT_LOCK
            local aimPart = ABILITY_AIM_PART[abilityName] or "HumanoidRootPart"
            local ballistic = BALLISTIC[abilityName] or false
            for _, id in ipairs(extractAnimIds(animValue)) do
                STUN_ANIMS[id] = { Ability=abilityName, Lock=lock, AimPart=aimPart, Ballistic=ballistic }
                count += 1
            end
            STUN_BY_ABILITY[abilityName] = { AimPart=aimPart, Ballistic=ballistic, Lock=lock }
        end
    end
    return count
end
local function loadCharacterAnims()
    STUN_ANIMS = {}; STUN_BY_ABILITY = {}; AbilityHook._registered = 0
    local char = lp.Character
    if not char then return end
    local name = char:GetAttribute("CharacterName") or char.Name
    local skin = char:GetAttribute("SkinName") or ""
    if not name or name == "" then return end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    if not assets then return end
    pcall(function()
        local cfg = require(assets.Survivors[name].Config)
        AbilityHook._registered += registerAnimsFrom(getAnimsTable(cfg))
    end)
    if skin ~= "" then
        pcall(function()
            local cfg = require(assets.Skins.Survivors[name][skin].Config)
            AbilityHook._registered += registerAnimsFrom(getAnimsTable(cfg))
        end)
    end
    pcall(function()
        local beh = require(assets.Survivors[name].Behavior)
        if type(beh) == "table" and type(beh.Abilities) == "table" then
            for abilityName, entry in pairs(beh.Abilities) do
                if isStunAbility(abilityName) and type(entry) == "table" then
                    for _, animId in ipairs(extractAnimIds(entry.AnimationId or entry.Animation)) do
                        STUN_ANIMS[animId] = {
                            Ability = abilityName,
                            Lock = ABILITY_LOCKS[abilityName] or DEFAULT_LOCK,
                            AimPart = ABILITY_AIM_PART[abilityName] or "HumanoidRootPart",
                            Ballistic = BALLISTIC[abilityName] or false,
                        }
                        AbilityHook._registered += 1
                    end
                end
            end
        end
    end)
    registerGuestPunchAnims()
end
local function bindAnimWatch()
    if AbilityHook._animConn then
        pcall(function() AbilityHook._animConn:Disconnect() end)
        AbilityHook._animConn = nil
    end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then task.delay(0.4, bindAnimWatch) return end
    AbilityHook._animConn = animator.AnimationPlayed:Connect(function(track)
        if not AbilityHook.Enabled then return end
        local anim = track and track.Animation
        if not anim then return end
        local id = tostring(anim.AnimationId):match("(%d+)")
        local info = id and STUN_ANIMS[id]
        if not info then return end
        if track.TimePosition > TRIGGER_WINDOW then return end
        local now = tick()
        if now - (AbilityHook._lastFire or 0) < (AbilityHook.Cooldown or 1.0) then return end
        AbilityHook._lastFire = now
        AimFor(info.Lock * (AbilityHook.LockMultiplier or 1.0), info.Ability)
    end)
end
lp.CharacterAdded:Connect(function() task.wait(0.4); loadCharacterAnims(); bindAnimWatch() end)
task.spawn(function()
    if lp.Character then task.wait(0.4); loadCharacterAnims(); bindAnimWatch() end
end)
task.spawn(function()
    while true do
        task.wait(5)
        if lp.Character then
            local name = lp.Character:GetAttribute("CharacterName") or lp.Character.Name
            local skin = lp.Character:GetAttribute("SkinName") or ""
            if AbilityHook._registered == 0
                or name ~= AbilityHook._lastName
                or skin ~= AbilityHook._lastSkin then
                AbilityHook._lastName = name
                AbilityHook._lastSkin = skin
                loadCharacterAnims()
                bindAnimWatch()
            end
        end
    end
end)

RunService:BindToRenderStep("WindHubAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    local aimActive = AIM.Enabled or (tick() < (AIM._aimUntil or 0))
    if not isPlayingSurvivor()
        or not aimActive
        or not AIM.CachedTargetHRP
        or not AIM.CachedTargetHRP.Parent then
        restoreAutoRotate()
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local myRoot = getMyRoot()
    if not myRoot then
        restoreAutoRotate()
        if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
        return
    end
    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end
    if AIM.CurrentAbility and AIM.CachedTargetHRP.Parent then
        local killer = AIM.CachedTargetHRP.Parent
        local ov = STUN_BY_ABILITY[AIM.CurrentAbility]
        if ov then
            if ov.AimPart and ov.AimPart ~= "HumanoidRootPart" then
                local p = killer:FindFirstChild(ov.AimPart)
                if p and p:IsA("BasePart") then targetPos = p.Position end
            end
            if ov.Ballistic then targetPos = ballisticAim(targetPos, 80, workspace.Gravity) end
        end
    end
    local smooth = AIM.Smooth or 1.0
    local alpha
    if smooth >= 0.999 then
        alpha = 1
    else
        local speed = math.clamp(smooth * 30, 2, 60)
        alpha = 1 - math.exp(-dt * speed)
    end
    local mode = AIM.AimMode
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), alpha)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        disableAutoRotate()
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        local delta = flat - myRoot.Position
        if delta.Magnitude > 0.05 then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, flat), alpha)
        end
    else
        restoreAutoRotate()
    end
    if tick() >= (AIM._aimUntil or 0) then AIM.CurrentAbility = nil end
end)

