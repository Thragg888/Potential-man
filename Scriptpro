    PulseEnabled = false, PulseColor = Color3.fromRGB(80, 200, 255), PulseSpeed = 2, PulseAlpha = 0.35,
    CircleColor = Color3.fromRGB(80, 200, 255), CircleRadius = 12, CircleHeight = 0.35, CircleOffset = 3.45,
    boxes = {}, circles = {},
}
local OVERLAP = OverlapParams.new()
OVERLAP.FilterType = Enum.RaycastFilterType.Include
local function refreshOverlapFilter()
