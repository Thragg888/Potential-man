local FacingVisual = {
    BoxEnabled    = false,
    BoxWidth      = 12,
    BoxHeight     = 8,
    BoxLength     = 30,
    BoxColor      = Color3.fromRGB(255, 60, 60),
    BoxMaterial   = "Neon",
    BoxTransparency = 0.9,
    BoxOutlineTransparency = 1,
    AppearMode    = "M1",   -- default now M1-only
    M1FlashDuration = 0.45,
    M1FlashUntil  = setmetatable({}, { __mode = "k" }),

    CircleEnabled = false,
    CircleOffset  = 3.45,
    CircleRadius  = 12,
    CircleHeight  = 0.35,
    CircleColor   = Color3.fromRGB(80, 200, 255),

    boxes   = {},
    circles = {},
}

local function boxShouldShow(killer)
    if not FacingVisual.BoxEnabled then return false end
    if FacingVisual.AppearMode == "Always" then return true end
    local t = FacingVisual.M1FlashUntil[killer]
    return t and tick() < t
end

local function destroyBox(killer)
    local d = FacingVisual.boxes[killer]; if not d then return end
    if d.part and d.part.Parent then pcall(function() d.part:Destroy() end) end
    if d.highlight and d.highlight.Parent then pcall(function() d.highlight:Destroy() end) end
    if d.conn then pcall(function() d.conn:Disconnect() end) end
    FacingVisual.boxes[killer] = nil
end
local function destroyCircle(killer)
    local d = FacingVisual.circles[killer]; if not d then return end
    if d.adornment and d.adornment.Parent then pcall(function() d.adornment:Destroy() end) end
    FacingVisual.circles[killer] = nil
end
local function createCircle(killer)
    if not killer or not killer:IsA("Model") then return end
    if FacingVisual.circles[killer] then return end
    local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local adorn = Instance.new("CylinderHandleAdornment")
    adorn.Name = "SCPHubFacingCircle"
    adorn.Adornee = hrp; adorn.AlwaysOnTop = true; adorn.ZIndex = 2
    adorn.Radius = FacingVisual.CircleRadius
    adorn.Height = FacingVisual.CircleHeight
    adorn.Color3 = FacingVisual.CircleColor
    adorn.Transparency = 0.35
    adorn.Parent = hrp
    FacingVisual.circles[killer] = { adornment = adorn }
end

-- NOTE: when killer is nil (called from sliders), respect current mode by
-- checking AppearMode. In M1 mode we shouldn't flash a box just because a
-- slider moved -- so default to hidden when killer is nil in M1 mode.
local function applyBoxAppearance(data, killer)
    local part = data and data.part
    local hl   = data and data.highlight
    if not part or not part.Parent then return end
    local show
    if killer then
        show = boxShouldShow(killer)
    else
        show = FacingVisual.BoxEnabled and FacingVisual.AppearMode == "Always"
    end
    part.Color = FacingVisual.BoxColor
    part.Transparency = show and FacingVisual.BoxTransparency or 1
    local mat = Enum.Material.Neon
    pcall(function() mat = Enum.Material[FacingVisual.BoxMaterial] or Enum.Material.Neon end)
    part.Material = mat
    if hl and hl.Parent then
        hl.OutlineColor = FacingVisual.BoxColor
        hl.OutlineTransparency = show and (FacingVisual.BoxOutlineTransparency or 1) or 1
        hl.FillTransparency = 1
    end
end

local function createBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyBox(killer)
    local part = Instance.new("Part")
    part.Name = "SCPHubDetectionBox"
    part.Anchored = true; part.CanCollide = false; part.CanTouch = false
    part.Massless = true; part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = FacingVisual.BoxColor
    part.Transparency = 1
    part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    part.Parent = killer
    local hl = Instance.new("Highlight")
    hl.Name = "SCPHubDetectionHighlight"
    hl.FillTransparency = 1
    hl.OutlineColor = FacingVisual.BoxColor
    hl.OutlineTransparency = 1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = part
    hl.Parent = part
    local data = { part = part, highlight = hl, conn = nil }
    FacingVisual.boxes[killer] = data
    applyBoxAppearance(data, killer)
    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyBox(killer); return end
        local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then return end
        flat = flat.Unit
        part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
