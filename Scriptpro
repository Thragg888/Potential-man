-- =========================================================
-- AUTO BLOCK HITBOX LOGIC (EXACT REFERENCE COPY)
-- =========================================================
local function tryBlockWithHitbox(killer, attackName)
    if not AB_Cfg.Enabled then return end
    if not isSurvivor() or hasHelplessEffect() then return end
    if not Players:GetPlayerFromCharacter(killer) then return end

    local lname = string.lower(attackName)
    if not BlockableAttacks[lname] then return end

    local char = lp.Character
    local myHb = char and char:FindFirstChild("QueryHitbox")
    local qh = killer:FindFirstChild("QueryHitbox") or killer:WaitForChild("QueryHitbox", 0.5)
    if not myHb or not qh then return end

    if AB_Cfg.Debug then print("[AB] Checking hitbox for: " .. lname) end

    local custom = nil
    if lname == "golemslash" then
        custom = { Size = Vector3.new(6, 2, 7), Offset = CFrame.new(0,0,-5.5) }
    end

    local selfParams = OverlapParams.new()
    selfParams.MaxParts = 1
    selfParams.FilterType = Enum.RaycastFilterType.Include
    selfParams.FilterDescendantsInstances = { myHb }

    local hitboxesFolder = workspace:FindFirstChild("Hitboxes") or workspace

    -- Exact Reference: 12 iterations, 0.02s wait
    for i = 1, 12 do
        if not AB_Cfg.Enabled then break end
        if not char or not char.Parent or not qh or not qh.Parent then break end
        
        local part = Instance.new("Part")
        part.Name = "SCPHubBlockProbe"
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.ForceField
        part.Size = (custom and custom.Size or Vector3.new(5.2, 6, 5.65)) * 2.2
        part.CFrame = qh.CFrame * (custom and custom.Offset or CFrame.new(0,0,-3.5))
        part.Transparency = 1
        part.Parent = hitboxesFolder
        Debris:AddItem(part, 0.4)

        local hits = workspace:GetPartsInPart(part, selfParams)
        if #hits > 0 then
            if fireBlockNow() then
                if AB_Cfg.Debug then print("[AB] Blocked " .. lname .. " at step " .. i) end
                break
            end
        end
        task.wait(0.02)
    end
end

