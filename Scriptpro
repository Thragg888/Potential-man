    pcall(function() gens = map:QueryDescendants("Model#Generator:has(#Main)") end)
    if not gens then
        gens = {}
        for _, o in ipairs(map:GetChildren()) do
            if o:IsA("Model") and (o.Name == "Generator" or o.Name == "FakeGenerator") then
                gens[#gens+1] = o
            end
        end
