local function destroyBox(killer)
    local d = FacingVisual.boxes[killer]; if not d then return end
    if d.part and d.part.Parent then pcall(function() d.part:Destroy() end) end
    if d.highlight and d.highlight.Parent then pcall(function() d.highlight:Destroy() end) end
    if d.conn then pcall(function() d.conn:Disconnect() end) end
    FacingVisual.boxes[killer] = nil
end
local function destroyCircle(killer)
    local d = FacingVisual.circles[killer]; if not d then return end
    if d.adornment and d.adornment.Parent then pcall(function() d.adornment:Destroy() end) end
    FacingVisual.circles[killer] = nil
end
local function createCircle(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyCircle(killer)
    local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local adorn = Instance.new("CylinderHandleAdornment")
    adorn.Name = "WindHubFacingCircle"
    adorn.Adornee = hrp; adorn.AlwaysOnTop = true; adorn.ZIndex = 2
    adorn.Radius = FacingVisual.CircleRadius
    adorn.Height = FacingVisual.CircleHeight
    adorn.Color3 = FacingVisual.CircleColor
    adorn.Transparency = FacingVisual.VisualEnabled and 0.35 or 1
    adorn.Parent = hrp
    FacingVisual.circles[killer] = { adornment = adorn }
end
local function applyBoxAppearance(data)
    local part = data and data.part
    local hl   = data and data.highlight
    if not part or not part.Parent then return end
    local showBox = FacingVisual.VisualEnabled
        and (FacingVisual.ShapeMode == "Box" or FacingVisual.ShapeMode == "Both")
    part.Color = FacingVisual.BoxColor
    part.Transparency = showBox and (FacingVisual.BoxTransparency or 0.55) or 1
    local mat = Enum.Material.Neon
    pcall(function() mat = Enum.Material[FacingVisual.BoxMaterial] or Enum.Material.Neon end)
    part.Material = mat
    if FacingVisual.PulseEnabled and showBox then
        local t = tick() * FacingVisual.PulseSpeed
        local a = (math.sin(t) * 0.5 + 0.5) * FacingVisual.PulseAlpha
        part.Color = FacingVisual.PulseColor
        part.Transparency = 1 - a
    end
    if hl and hl.Parent then
        hl.OutlineColor = FacingVisual.BoxColor
        hl.OutlineTransparency = (showBox and FacingVisual.OutlineEnabled)
            and (FacingVisual.OutlineTransparency or 0) or 1
        if showBox and FacingVisual.FillEnabled then
            hl.FillColor = FacingVisual.FillColor
            hl.FillTransparency = FacingVisual.FillTransparency or 0.6
        else
            hl.FillTransparency = 1
        end
    end
end
local function createBox(killer)
    if not killer or not killer:IsA("Model") then return end
    destroyBox(killer)
    local part = Instance.new("Part")
    part.Name = "WindHubDetectionBox"
    part.Anchored = true; part.CanCollide = false; part.CanTouch = false
    part.Massless = true; part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = FacingVisual.BoxColor
    part.Transparency = FacingVisual.BoxTransparency
    part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    part.Parent = killer
    local hl = Instance.new("Highlight")
    hl.Name = "WindHubDetectionHighlight"
    hl.FillTransparency = 1
    hl.OutlineColor = FacingVisual.BoxColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = part
    hl.Parent = part
    local data = { part = part, highlight = hl, conn = nil }
    FacingVisual.boxes[killer] = data
    applyBoxAppearance(data)
    data.conn = RunService.Heartbeat:Connect(function()
        if not killer.Parent or not part.Parent then destroyBox(killer); return end
        local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 1e-4 then return end
        flat = flat.Unit
        part.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
        part.CFrame = CFrame.lookAt(
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5),
            hrp.Position + flat * (FacingVisual.BoxLength * 0.5 + 1))
        applyBoxAppearance(data)
    end)
end
