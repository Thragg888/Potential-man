local BLOCKABLE_ATTACKS = {
    ["slash"]=true, ["enragedslash"]=true, ["stab"]=true, ["attack"]=true,
    ["punch"]=true, ["swing"]=true, ["golemslash"]=true,
}
local CUSTOM_HITBOXES = {
