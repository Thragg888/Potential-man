-- =========================================================
-- VEERONICA TAB
-- =========================================================
do
    local VIM = game:GetService("VirtualInputManager")
    local V = { AutoTrick=false, AutoTrickThread=nil, SkateControl=false, AntiRebound=false,
        UnlimitedSk8=false, AutoFarmSk8=false, AutoFarmSk8Started=false, CustomStats=false,
        Sk8Everywhere=false, Sk8EverywhereThread=nil, AutoPhase=false, AutoPhaseThread=nil,
        Sk8Speed=1.15, Sk8TrickSpeed=1.42, Sk8BumpPower=11.9, Sk8TrickStamina=10, Sk8TrickCooldown=1 }
    local VModule, VUtil

    local function veeModules()
        local assets = ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
        if not VModule then pcall(function() VModule = require(assets.Survivors.Veeronica.Behavior) end) end
        if not VUtil then pcall(function() VUtil = require(ReplicatedStorage.Modules.Utilities.Util) end) end
    end
    local function veeSetStat(k, val)
        if VModule then VModule[k] = val end
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "DisplayName") == "Veeronica" then t[k] = val end
            end
        end)
    end
    local function veeApplyStats()
        if not V.CustomStats then return end
        veeSetStat("Sk8Speed", V.Sk8Speed); veeSetStat("Sk8SpeedExhaust", V.Sk8Speed)
        veeSetStat("Sk8TrickAirborneSpeed", V.Sk8TrickSpeed)
        veeSetStat("Sk8BumpPower", V.Sk8BumpPower); veeSetStat("Sk8BumpChargedPower", V.Sk8BumpPower)
        veeSetStat("Sk8TrickStamina", V.Sk8TrickStamina); veeSetStat("Sk8TrickStaminaNerfed", V.Sk8TrickStamina)
        veeSetStat("Sk8TrickCooldown", V.Sk8TrickCooldown)
    end
    local function veeResetStats()
        veeSetStat("Sk8Speed", 1.15); veeSetStat("Sk8SpeedExhaust", 1.15)
        veeSetStat("Sk8TrickAirborneSpeed", 1.42)
        veeSetStat("Sk8BumpPower", 11.9); veeSetStat("Sk8BumpChargedPower", 15)
        veeSetStat("Sk8TrickStamina", 10); veeSetStat("Sk8TrickStaminaNerfed", 4)
        veeSetStat("Sk8TrickCooldown", 1)
    end
    local function veeIsVee()
        local c = lp.Character; if not c then return false end
        return (c:GetAttribute("CharacterName") or c.Name) == "Veeronica"
    end
    local function veeHighlighted(c)
        local h = c and c:FindFirstChild("Highlight")
        return h ~= nil and h.Adornee == c
    end
    local function veeKillers()
        if KillersFolder then return KillersFolder end
        local p = workspace:FindFirstChild("Players")
        return p and p:FindFirstChild("Killers")
    end

    local function veeDoTrickInput()
        if not UIS.TouchEnabled or UIS.MouseEnabled then
            VIM:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        else
            local pg = lp:FindFirstChild("PlayerGui")
            local m  = pg and pg:FindFirstChild("MainUI")
            local b  = m and m:FindFirstChild("SprintingButton")
            if b and getconnections then
                for _, c in pairs(getconnections(b.MouseButton1Down)) do c:Fire() end
                task.wait(0.05)
                for _, c in pairs(getconnections(b.MouseButton1Up))   do c:Fire() end
                for _, c in pairs(getconnections(b.Activated))        do c:Fire() end
            end
        end
    end
    local function veeAutoTrickStart()
        if V.AutoTrickThread then pcall(task.cancel, V.AutoTrickThread); V.AutoTrickThread = nil end
        if not V.AutoTrick then return end
        V.AutoTrickThread = task.spawn(function()
            while task.wait() do
                if not V.AutoTrick then break end
                local c = lp.Character
                if c and veeIsVee() and veeHighlighted(c) then
                    pcall(veeDoTrickInput)
                    task.wait(0.1)
                end
            end
        end)
    end

    local function veeSkateCtrl(v)
        veeModules()
        local val = v and 6.5 or 0.65
        if VModule then VModule.Sk8TurnControl = val end
        pcall(function()
            for _, t in pairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "Sk8TurnControl") ~= nil then t.Sk8TurnControl = val end
            end
        end)
    end

    local veeARInstalled = false
    local function veeInstallAR()
        if veeARInstalled or not hookmetamethod or not getnamecallmethod then return end
        veeARInstalled = true
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if not V.AntiRebound then return old(self, ...) end
            if getnamecallmethod() == "FireServer" and self == RemoteEvent then
                local a = {...}
                local first = tostring(a[1] or "")
                local pn = lp.Name
                if veeIsVee() then
                    if first == pn .. "SkateRebound" then return end
                    if first == pn .. "StopSkate" and type(a[2]) == "table" then
                        for _, x in ipairs(a[2]) do
                            if typeof(x) == "Instance" then
                                pcall(function()
                                    RemoteEvent:FireServer(pn .. "StopSkate", { buffer.fromstring("\"Manual\"") })
                                end)
                                return
                            end
                        end
                    end
                end
            end
            return old(self, ...)
        end)
    end

    local veeUSk8 = false
    local function veeInstallUSk8()
        if veeUSk8 then return end
        veeUSk8 = true
        RunService.Heartbeat:Connect(function()
            if not V.UnlimitedSk8 or not Sprinting then return end
            local c = lp.Character; if not c then return end
            local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            if hrp:FindFirstChild("SkatePointer") then Sprinting.Stamina = Sprinting.MaxStamina end
        end)
    end

    local function veeFarmStart()
        if V.AutoFarmSk8Started then return end
        V.AutoFarmSk8Started = true
        task.spawn(function()
            while true do
                if V.AutoFarmSk8 and RemoteEvent then
                    pcall(function() RemoteEvent:FireServer(lp.Name .. "SkateTrick", {}) end)
                    task.wait(0.5)
                else
                    task.wait(0.1)
                end
            end
        end)
    end

    local function veeBypass(t)
        if type(t) ~= "table" then return end
        local s = t.Sk8; if type(s) ~= "table" or s.__bypassed then return end
        local cb = s.Callback; if type(cb) ~= "function" then return end
        s.__origCallback = cb; s.__bypassed = true
        s.Callback = function(...)
            local a = {...}; if a[3] == "BAD" then a[3] = nil end
            return cb(table.unpack(a))
        end
    end
    local function veeRestore(t)
        if type(t) ~= "table" then return end
        local s = t.Sk8; if type(s) ~= "table" or not s.__bypassed then return end
        if s.__origCallback then s.Callback = s.__origCallback; s.__origCallback = nil end
        s.__bypassed = nil
    end
    local function veeGetActor()
        veeModules()
        if not VUtil or type(VUtil.GetActor) ~= "function" then return nil end
        local ok, r = pcall(VUtil.GetActor, VUtil, lp)
        return (ok and type(r) == "table") and r or nil
    end
    local function veeSetEverywhere(v)
        veeModules()
        if v then
            if VModule and VModule.Abilities then veeBypass(VModule.Abilities) end
            local a = veeGetActor()
            if a then
                if a.Behavior and a.Behavior.Abilities then veeBypass(a.Behavior.Abilities) end
                if a.State then a.State.InZone = true end
            end
            pcall(function() if VUtil then VUtil:ToggleLockForAbilityIcon("Sk8", "NoCharges", false) end end)
            if V.Sk8EverywhereThread then pcall(task.cancel, V.Sk8EverywhereThread) end
            V.Sk8EverywhereThread = task.spawn(function()
                while task.wait(0.5) do
                    if not V.Sk8Everywhere then break end
                    if VModule and VModule.Abilities then veeBypass(VModule.Abilities) end
                    local a = veeGetActor()
                    if a then
                        if a.Behavior and a.Behavior.Abilities then veeBypass(a.Behavior.Abilities) end
                        if a.State then a.State.InZone = true end
                    end
                    pcall(function() if VUtil then VUtil:ToggleLockForAbilityIcon("Sk8", "NoCharges", false) end end)
                end
            end)
        else
            if V.Sk8EverywhereThread then pcall(task.cancel, V.Sk8EverywhereThread); V.Sk8EverywhereThread = nil end
            if VModule and VModule.Abilities then veeRestore(VModule.Abilities) end
            local a = veeGetActor()
            if a and a.Behavior and a.Behavior.Abilities then veeRestore(a.Behavior.Abilities) end
        end
    end

    local function veeAutoPhase(v)
        if V.AutoPhaseThread then pcall(task.cancel, V.AutoPhaseThread); V.AutoPhaseThread = nil end
        if not v then return end
        local Network
        pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end)
        V.AutoPhaseThread = task.spawn(function()
            while task.wait(0.5) do
                if not V.AutoPhase then break end
                if not Network then pcall(function() Network = require(ReplicatedStorage.Modules.Network.Network) end) end
                local kf = veeKillers()
                if Network and veeIsVee() and kf then
                    for _, k in ipairs(kf:GetChildren()) do
                        if not V.AutoPhase then break end
                        local h = k:FindFirstChildOfClass("Humanoid")
                        if h and h.Health > 0 then
                            pcall(function()
                                Network:FireServerConnection(lp.Name .. "SkatePhase", "REMOTE_EVENT", k)
                            end)
                            task.wait((VModule and VModule.Sk8PhaseTime or 3) + 0.6)
                        end
                    end
                end
            end
        end)
    end

    local VeeTab = Window:AddTab("Veeronica", "sparkles")
    local TR = VeeTab:AddLeftGroupbox("Tricks")
    TR:AddToggle("VAutoTrick", { Text="Auto Trick", Default=false, Callback=function(v) V.AutoTrick=v; veeAutoTrickStart() end })
    TR:AddToggle("VSkateCtrl", { Text="Skate Control", Default=false, Callback=function(v) V.SkateControl=v; veeSkateCtrl(v) end })
    TR:AddToggle("VARebound", { Text="Anti Rebound", Default=false, Callback=function(v) V.AntiRebound=v; if v then veeInstallAR() end end })
    TR:AddToggle("VUSk8",     { Text="Unlimited Sk8", Default=false, Callback=function(v) V.UnlimitedSk8=v; if v then veeInstallUSk8() end end })
    TR:AddToggle("VFarmSk8",  { Text="Auto Farm sk8", Default=false, Callback=function(v) V.AutoFarmSk8=v; if v then veeFarmStart() end end })
    TR:AddToggle("VAutoPhase",{ Text="Auto Phase", Default=false, Callback=function(v) V.AutoPhase=v; veeAutoPhase(v) end })

    local CS = VeeTab:AddRightGroupbox("Custom Stats")
    CS:AddToggle("VCStats", { Text="Enable Custom Stats", Default=false, Callback=function(v) V.CustomStats=v; if v then veeApplyStats() else veeResetStats() end end })
    CS:AddSlider("VSk8Spd",  { Text="Skate Speed", Min=1, Max=10, Default=1.15, Rounding=2, Callback=function(v) V.Sk8Speed=v; if V.CustomStats then veeSetStat("Sk8Speed", v); veeSetStat("Sk8SpeedExhaust", v) end end })
    CS:AddSlider("VTrkBoost",{ Text="Trick Boost Speed", Min=1, Max=15, Default=1.42, Rounding=2, Callback=function(v) V.Sk8TrickSpeed=v; if V.CustomStats then veeSetStat("Sk8TrickAirborneSpeed", v) end end })
    CS:AddSlider("VBump",    { Text="Bumper Knockback Power", Min=10, Max=150, Default=11.9, Rounding=1, Callback=function(v) V.Sk8BumpPower=v; if V.CustomStats then veeSetStat("Sk8BumpPower", v); veeSetStat("Sk8BumpChargedPower", v) end end })
    CS:AddSlider("VTrkStam", { Text="Stamina Per Trick", Min=0, Max=100, Default=10, Rounding=0, Callback=function(v) V.Sk8TrickStamina=v; if V.CustomStats then veeSetStat("Sk8TrickStamina", v); veeSetStat("Sk8TrickStaminaNerfed", v) end end })
    CS:AddSlider("VTrkCD",   { Text="Trick Cooldown", Min=0, Max=5, Default=1, Rounding=1, Callback=function(v) V.Sk8TrickCooldown=v; if V.CustomStats then veeSetStat("Sk8TrickCooldown", v) end end })

    local Rage = VeeTab:AddLeftGroupbox("Rage (100% ban risk)")
    Rage:AddToggle("VEverywhere", { Text="Sk8 Everywhere", Default=false, Callback=function(v) V.Sk8Everywhere=v; veeSetEverywhere(v) end })

    notify("Wind Hub v1", "Veeronica tab loaded")
end

