-- =========================================================
local ChanceAimbot = {
    Enabled=false, LockTime=0.9, PredMin=2, PredMax=3,
    TurnLeadMult=1.0, FireRemote=true,
    _isLocking=false, _lockUntil=0, _currentTarget=nil,
    _lastTrigger=0, _hooked={}, _velHistory={},
}
local CHANCE_KILLER_NAMES = {
    ["jason"]=true, ["c00lkidd"]=true, ["johndoe"]=true, ["1x1x1x1"]=true,
    ["noli"]=true, ["slasher"]=true, ["nosferatu"]=true, ["azure"]=true,
    ["coolkid"]=true, ["coolkidd"]=true, ["sixer"]=true, ["666"]=true,
    ["guest666"]=true, ["doombringer"]=true, ["zombie king"]=true, ["azurewrath"]=true,
}
local function chanceIsKillerName(name)
    name = string.lower(tostring(name or ""))
    if CHANCE_KILLER_NAMES[name] then return true end
    for k in pairs(CHANCE_KILLER_NAMES) do if name:find(k, 1, true) then return true end end
    return false
end
local function chanceGetNearestKiller()
    local my = getMyRoot(); if not my then return nil end
    local bestRoot, bestD = nil, math.huge
    local function check(model)
        if not model or not chanceIsKillerName(model.Name) then return end
        local r = model:FindFirstChild("HumanoidRootPart")
        local h = model:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health <= 0 then return end
        local d = (my.Position - r.Position).Magnitude
        if d < bestD then bestD = d; bestRoot = r end
    end
    local folder = workspace:FindFirstChild("Players")
    local killers = folder and folder:FindFirstChild("Killers")
    if killers then for _, k in ipairs(killers:GetChildren()) do check(k) end end
    if not bestRoot then
        for _, m in ipairs(workspace:GetChildren()) do if m:IsA("Model") then check(m) end end
    end
    return bestRoot
end
local function chanceSmoothedVelocity(root)
    if not root then return Vector3.zero end
    local v = root.AssemblyLinearVelocity
    local hist = ChanceAimbot._velHistory
    hist[#hist + 1] = v
    if #hist > 10 then table.remove(hist, 1) end
    local sum = Vector3.zero
    for i = 1, #hist do sum = sum + hist[i] end
    return sum / math.max(#hist, 1)
end
local function chancePredictPosition(root)
    if not root then return nil end
    local pos = root.Position
    local vel = chanceSmoothedVelocity(root)
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local speed = horiz.Magnitude
    if speed < 1.2 then return pos end
    local lead = ChanceAimbot.PredMin
        + (ChanceAimbot.PredMax - ChanceAimbot.PredMin) * math.clamp(speed / 28, 0, 1)
    local hist = ChanceAimbot._velHistory
    if #hist >= 3 then
        local a = hist[#hist - 2]
        local b = hist[#hist]
        local ah = Vector3.new(a.X, 0, a.Z)
        local bh = Vector3.new(b.X, 0, b.Z)
        if ah.Magnitude > 2 and bh.Magnitude > 2 and ah.Unit:Dot(bh.Unit) < 0.45 then
            lead = lead + 0.9 * (ChanceAimbot.TurnLeadMult or 1.0)
        end
    end
    return pos + horiz.Unit * lead
end
local function chanceDoAimlock(root)
    local me = getMyRoot()
    if not me or not root or not root.Parent then return end
    local aimAt = chancePredictPosition(root); if not aimAt then return end
    local myPos = me.Position
    me.AssemblyAngularVelocity = Vector3.zero
    local cf = CFrame.new(myPos, Vector3.new(aimAt.X, myPos.Y, aimAt.Z))
    me.CFrame = cf; me.CFrame = cf; me.CFrame = cf
end
local function chanceStartAimlock()
    if os.clock() - ChanceAimbot._lastTrigger < 0.12 then return end
    local root = chanceGetNearestKiller(); if not root then return end
    ChanceAimbot._lastTrigger = os.clock()
    ChanceAimbot._isLocking = true
    ChanceAimbot._lockUntil = os.clock() + ChanceAimbot.LockTime
    ChanceAimbot._currentTarget = root
    ChanceAimbot._velHistory = {}
    for _ = 1, 6 do chanceDoAimlock(root) end
end
RunService.RenderStepped:Connect(function()
    if not ChanceAimbot.Enabled or not ChanceAimbot._isLocking then return end
    local now = os.clock()
    if now > ChanceAimbot._lockUntil then
        ChanceAimbot._isLocking = false; ChanceAimbot._currentTarget = nil
        ChanceAimbot._velHistory = {}; return
    end
    local root = chanceGetNearestKiller()
    if root then ChanceAimbot._currentTarget = root end
    if ChanceAimbot._currentTarget and ChanceAimbot._currentTarget.Parent then
        chanceDoAimlock(ChanceAimbot._currentTarget)
        chanceDoAimlock(ChanceAimbot._currentTarget)
        chanceDoAimlock(ChanceAimbot._currentTarget)
        chanceDoAimlock(ChanceAimbot._currentTarget)
    end
end)

