    local Azure = { GrabEnabled=false, SpikesEnabled=false, AimSmooth=0.15, TargetRefresh=0.1,
        GrabWallCheck=true, SpikesWallCheck=true,
        _installed=false, _actorCache=nil, _targetCache=nil, _nextRefresh=0 }
    local function azureFindActor()
        if Azure._actorCache and Azure._actorCache.Rig and Azure._actorCache.Rig.Parent then return Azure._actorCache end
        local ok, Actors = pcall(function() return require(ReplicatedStorage.Modules.Gameplay.Actors) end)
        if not ok or type(Actors) ~= "table" then return nil end
        local list = Actors.CurrentActors
        if type(list) ~= "table" then return nil end
        local me
        for _, a in pairs(list) do
            if type(a) == "table" and a.Player == lp and a.Rig and a.Rig.Parent then me = a; break end
        end
        if me then Azure._actorCache = me end
        return me
    end
    local function azureFindTarget(myPos, maxDist)
        local best, bestD = nil, maxDist
        if not SurvivorsFolder then return nil end
        for _, s in ipairs(SurvivorsFolder:GetChildren()) do
            local t = s:FindFirstChild("HumanoidRootPart")
            local h = s:FindFirstChildOfClass("Humanoid")
            if t and h and h.Health > 0 and not s:GetAttribute("Undetectable") then
                local d = (t.Position - myPos).Magnitude
                if d <= bestD then bestD = d; best = t end
            end
        end
        return best
    end
    local function azureAim(dt)
        if not (Azure.GrabEnabled or Azure.SpikesEnabled) then return end
        local actor = azureFindActor()
        if not actor or not actor.Rig then return end
        local hrp = actor.Rig:FindFirstChild("HumanoidRootPart") or actor.Rig.PrimaryPart
        local hum = actor.Rig:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local mode
        if Azure.SpikesEnabled and actor.State and actor.State.ControllingGolem == false then mode = "Spikes"
        elseif Azure.GrabEnabled and actor.State and actor.State.GrabAimingSequence == true then mode = "Grab" end
        if not mode then return end
        local now = os.clock()
        if now >= Azure._nextRefresh or not Azure._targetCache then
            Azure._nextRefresh = now + Azure.TargetRefresh
            local maxD = mode == "Grab"
                and (actor.Config and actor.Config.Grab and actor.Config.Grab.HookRange or 60)
                or (actor.Config and actor.Config.GolemFissure and actor.Config.GolemFissure.Distance or 85)
            Azure._targetCache = azureFindTarget(hrp.Position, maxD)
        end
        local tgt = Azure._targetCache
        if not tgt or not tgt.Parent then return end
        local aimAt = tgt.Position + (tgt.AssemblyLinearVelocity or Vector3.zero) * 0.1
        local check = (mode == "Grab" and Azure.GrabWallCheck or mode == "Spikes" and Azure.SpikesWallCheck)
        if check then
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local pf = workspace:FindFirstChild("Players")
            rp.FilterDescendantsInstances = pf and { pf } or { actor.Rig }
            if workspace:Raycast(hrp.Position, aimAt - hrp.Position, rp) then return end
        end
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, aimAt), Azure.AimSmooth)
        if mode == "Spikes" then
            local flat = Vector3.new(aimAt.X, hrp.Position.Y, aimAt.Z)
            hrp.CFrame = CFrame.new(hrp.Position, flat)
        end
    end
    local function azureSetEnabled()
        if Azure._installed then
            if not (Azure.GrabEnabled or Azure.SpikesEnabled) then
                RunService:UnbindFromRenderStep("WindHubAzureAim")
                Azure._installed = false
            end
        elseif Azure.GrabEnabled or Azure.SpikesEnabled then
            RunService:BindToRenderStep("WindHubAzureAim", Enum.RenderPriority.Camera.Value + 1, azureAim)
            Azure._installed = true
        end
    end
