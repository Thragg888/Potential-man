-- helper — remove only OUR instances (via CollectionService tag)
local CollectionService = game:GetService("CollectionService")
local function clearTaggedForModel(model)
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsDescendantOf(model) or obj == model then
            pcall(function() obj:Destroy() end)
        end
    end
end
local function clearAllTagged()
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        pcall(function() obj:Destroy() end)
    end
end

local function espGetHRP(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) end

local function espMakeBox(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return end
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "WindHubESPBox"
    box.Adornee = hrp
    box.AlwaysOnTop = true
    box.ZIndex = 1
    box.Size = Vector3.new(2.2, 5.5, 2.2)
    box.Color3 = cfg.OutlineColor
    box.Transparency = 0.4
    box.Parent = hrp
    CollectionService:AddTag(box, ESP_TAG)
end
local function espMakeChams(model, cfg)
    -- Use our own Highlight but tag it so we don't collide with game Highlights
    local hl = Instance.new("Highlight")
    hl.Name = "WindHubESPChams"
    hl.Adornee = model
    hl.FillColor = cfg.FillColor
    hl.OutlineColor = cfg.OutlineColor
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    CollectionService:AddTag(hl, ESP_TAG)
end
local function espMakeBillboard(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return end
    local head = model:FindFirstChild("Head") or hrp
    local bb = Instance.new("BillboardGui")
    bb.Name = "WindHubESPBillboard"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = cfg.MaxDistance or 1000
    bb.Parent = head
    local label = Instance.new("TextLabel")
    label.Name = "ESPLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.SourceSansBold
    label.TextScaled = true
    label.TextColor3 = cfg.TextColor
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Text = ""
    label.Parent = bb
    CollectionService:AddTag(bb, ESP_TAG)
end
local function espMakeTracer(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return end
    local ad = Instance.new("LineHandleAdornment")
    ad.Name = "WindHubESPTracer"
    ad.Adornee = hrp
    ad.AlwaysOnTop = true
    ad.ZIndex = 0; ad.Thickness = 2
    ad.Color3 = cfg.TracerColor
    ad.Transparency = 0.3
    ad.Length = 0
    ad.Parent = hrp
    CollectionService:AddTag(ad, ESP_TAG)
end
local function espUpdateTracer(model, cfg)
    -- find our tracer
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsA("LineHandleAdornment") and obj.Adornee
            and (obj.Adornee == espGetHRP(model) or obj.Adornee:IsDescendantOf(model)) then
            local hrp = espGetHRP(model); if not hrp then return end
            local origin = hrp.Position
            local target = Camera.CFrame.Position + Camera.CFrame.LookVector * 1
            local dist = (target - origin).Magnitude
            obj.Length = dist
            obj.CFrame = CFrame.lookAt(origin, target) * CFrame.new(0, 0, -dist * 0.5)
            obj.Color3 = cfg.TracerColor
            return
        end
    end
end

local function espEnsureForModel(model, cfg)
    local hrp = espGetHRP(model); if not hrp then return end
    -- box
    local hasBox, hasChams, hasBB, hasTracer = false, false, false, false
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsDescendantOf(model) or obj == model then
            if obj:IsA("BoxHandleAdornment") then hasBox = true end
            if obj:IsA("Highlight") then hasChams = true end
            if obj:IsA("BillboardGui") then hasBB = true end
            if obj:IsA("LineHandleAdornment") then hasTracer = true end
        end
    end
    if cfg.Box and not hasBox then espMakeBox(model, cfg) end
    if cfg.Chams and not hasChams then espMakeChams(model, cfg) end
    if (cfg.Name or cfg.Distance) and not hasBB then espMakeBillboard(model, cfg) end
    if cfg.Tracer and not hasTracer then espMakeTracer(model, cfg) end

    -- update billboard text
    local myRoot = getMyRoot()
    local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        if obj:IsA("BillboardGui") and (obj:IsDescendantOf(model)) then
            local label = obj:FindFirstChild("ESPLabel")
            if label then
                local parts = {}
                if cfg.Name then table.insert(parts, model.Name) end
                if cfg.Distance then table.insert(parts, "[" .. math.floor(dist) .. " studs]") end
                label.Text = table.concat(parts, "\n")
                label.TextColor3 = cfg.TextColor
            end
            obj.MaxDistance = cfg.MaxDistance or 1000
        elseif obj:IsA("Highlight") and obj:IsDescendantOf(model) then
            obj.FillColor = cfg.FillColor
            obj.OutlineColor = cfg.OutlineColor
        elseif obj:IsA("BoxHandleAdornment") and obj:IsDescendantOf(model) then
            obj.Color3 = cfg.OutlineColor
        end
    end
    if cfg.Tracer then espUpdateTracer(model, cfg) end
end

local function espScanCategory(folder, cfg, excludeSelf)
    if not folder then return end
    local seen = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and not (excludeSelf and m == lp.Character) then
            seen[m] = true
            espEnsureForModel(m, cfg)
        end
    end
    -- remove tagged objects for models that are gone
    for _, obj in ipairs(CollectionService:GetTagged(ESP_TAG)) do
        local model = obj:FindFirstAncestorOfClass("Model")
        if model and not seen[model] then
            pcall(function() obj:Destroy() end)
        end
    end
end

