    local v = root.AssemblyLinearVelocity
    local hist = ChanceAimbot._velHistory
    hist[#hist + 1] = v
    if #hist > 10 then table.remove(hist, 1) end
    local sum = Vector3.zero
    for i = 1, #hist do sum = sum + hist[i] end
    return sum / math.max(#hist, 1)
end
local function chancePredictPosition(root)
    if not root then return nil end
    local pos = root.Position
    local vel = chanceSmoothedVelocity(root)
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local speed = horiz.Magnitude
    if speed < 1.2 then return pos end
    local lead = ChanceAimbot.PredMin
        + (ChanceAimbot.PredMax - ChanceAimbot.PredMin) * math.clamp(speed / 28, 0, 1)
    local hist = ChanceAimbot._velHistory
    if #hist >= 3 then
        local a = hist[#hist - 2]
        local b = hist[#hist]
        local ah = Vector3.new(a.X, 0, a.Z)
        local bh = Vector3.new(b.X, 0, b.Z)
        if ah.Magnitude > 2 and bh.Magnitude > 2 and ah.Unit:Dot(bh.Unit) < 0.45 then
            lead = lead + 0.9 * (ChanceAimbot.TurnLeadMult or 1)
        end
    end
    return pos + horiz.Unit * lead
end
local function chanceDoAimlock(root)
    local me = getMyRoot()
    if not me or not root or not root.Parent then return end
    local aimAt = chancePredictPosition(root); if not aimAt then return end
    local myPos = me.Position
    me.AssemblyAngularVelocity = Vector3.zero
    me.CFrame = CFrame.new(myPos, Vector3.new(aimAt.X, myPos.Y, aimAt.Z))
end
local function chanceStartAimlock()
    if os.clock() - ChanceAimbot._lastTrigger < 0.12 then return end
    local root = chanceGetNearestKiller(); if not root then return end
    ChanceAimbot._lastTrigger = os.clock()
    ChanceAimbot._isLocking = true
    ChanceAimbot._lockUntil = os.clock() + ChanceAimbot.LockTime
    ChanceAimbot._currentTarget = root
    ChanceAimbot._velHistory = {}
    chanceDoAimlock(root)
end
local function chanceHookButton(btn)
    if not btn or ChanceAimbot._hooked[btn] then return end
    if not btn:IsA("GuiButton") then return end
    local name = string.lower(btn.Name or "")
    if not (name:find("shoot", 1, true) or name:find("flint", 1, true)
         or name:find("gun", 1, true) or name:find("oneshot", 1, true)) then return end
    ChanceAimbot._hooked[btn] = true
    local conn = btn.MouseButton1Click:Connect(function()
        if ChanceAimbot.Enabled then chanceStartAimlock() end
    end)
    ChanceAimbot._conns[conn] = true
end
PlayerGui.DescendantAdded:Connect(function(d)
    if ChanceAimbot.Enabled then pcall(chanceHookButton, d) end
end)
local function chanceInitialScan()
    if not ChanceAimbot.Enabled or not PlayerGui then return end
    for _, b in ipairs(PlayerGui:GetDescendants()) do
        pcall(chanceHookButton, b)
    end
end
RunService.RenderStepped:Connect(function()
    if not ChanceAimbot.Enabled or not ChanceAimbot._isLocking then return end
    local now = os.clock()
    if now > ChanceAimbot._lockUntil then
        ChanceAimbot._isLocking = false; ChanceAimbot._currentTarget = nil
        ChanceAimbot._velHistory = {}; return
    end
    local root = chanceGetNearestKiller()
    if root then ChanceAimbot._currentTarget = root end
    if ChanceAimbot._currentTarget and ChanceAimbot._currentTarget.Parent then
        chanceDoAimlock(ChanceAimbot._currentTarget)
    end
end)

