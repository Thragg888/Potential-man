    local bg = Instance.new("Frame")
    bg.Name             = "BG"
    bg.Size             = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    bg.BorderSizePixel  = 0
    bg.Parent           = gui

    local fill = Instance.new("Frame")
    fill.Name             = "Fill"
    fill.Size             = UDim2.new(1, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 220, 60)
    fill.BorderSizePixel  = 0
    fill.Parent           = bg

    cfg._tracers[model] = cfg._tracers[model] or {}  -- not used for health, safe slot
    cfg._billboards[model] = cfg._billboards[model] or {}
    cfg._billboards[model].healthGui = gui
    cfg._billboards[model].healthFill = fill
end

local function espMakeTracer(model, cfg)
    -- Tracer is drawn in the update loop using Drawing if available, else
    -- falls back to a beam-like LineHandleAdornment from camera to HRP.
    local hrp = espGetHRP(model)
    if not hrp then return end
    local ad = Instance.new("LineHandleAdornment")
    ad.Name = "ViltrumiteESPTracer"
    ad.Adornee = hrp
    ad.AlwaysOnTop = true
    ad.ZIndex = 0
    ad.Thickness = 2
    ad.Color3 = cfg.TracerColor
    ad.Transparency = 0.3
    ad.Length = 0
    ad.Parent = hrp
    cfg._tracers[model] = { adornment = ad }
end

local function espUpdateTracer(model, cfg)
    local entry = cfg._tracers[model]
    if not entry or not entry.adornment then return end
    local ad = entry.adornment
    local hrp = espGetHRP(model)
    if not hrp or not Camera then return end
    -- Point the adornment from HRP toward the camera direction (visual line)
    local origin = hrp.Position
    local target = Camera.CFrame.Position + Camera.CFrame.LookVector * 1
    local delta  = target - origin
    local dist   = delta.Magnitude
    ad.Length    = dist
    ad.CFrame    = CFrame.lookAt(origin, target) * CFrame.new(0, 0, -dist * 0.5)
end

local function espRemoveEntry(model, cfg)
    local box = cfg._boxes[model]
    if box then pcall(function() box:Destroy() end); cfg._boxes[model] = nil end
    local chams = cfg._chams[model]
    if chams then pcall(function() chams:Destroy() end); cfg._chams[model] = nil end
    local bb = cfg._billboards[model]
    if bb then
        if bb.gui then pcall(function() bb.gui:Destroy() end) end
        if bb.healthGui then pcall(function() bb.healthGui:Destroy() end) end
        cfg._billboards[model] = nil
    end
    local tr = cfg._tracers[model]
    if tr and tr.adornment then pcall(function() tr.adornment:Destroy() end); cfg._tracers[model] = nil end
end

local function espClearAll(cfg)
    for m in pairs(cfg._boxes) do espRemoveEntry(m, cfg) end
    for m in pairs(cfg._chams) do espRemoveEntry(m, cfg) end
    for m in pairs(cfg._billboards) do espRemoveEntry(m, cfg) end
    for m in pairs(cfg._tracers) do espRemoveEntry(m, cfg) end
end

local function espApplyToModel(model, cfg)
    if not model or not model.Parent then return end
    if not espGetHRP(model) then return end
    espRemoveEntry(model, cfg)
    if cfg.Box then espMakeBox(model, cfg) end
    if cfg.Chams then espMakeChams(model, cfg) end
    if cfg.Name or cfg.Distance then espMakeBillboard(model, cfg) end
    if cfg.Health then espMakeHealthBar(model, cfg) end
    if cfg.Tracer then espMakeTracer(model, cfg) end
end

local function espUpdateModel(model, cfg)
    local hrp = espGetHRP(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local myRoot = getMyRoot()
    local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0

    -- Distance filter
    if dist > (cfg.MaxDistance or 500) then
        espRemoveEntry(model, cfg)
        return
    end

    -- Rebuild missing pieces on the fly
    if cfg.Box and not cfg._boxes[model] then espMakeBox(model, cfg) end
    if cfg.Chams and not cfg._chams[model] then espMakeChams(model, cfg) end
    if (cfg.Name or cfg.Distance) and not cfg._billboards[model] then espMakeBillboard(model, cfg) end
    if cfg.Health and (not cfg._billboards[model] or not cfg._billboards[model].healthGui) then
        espMakeHealthBar(model, cfg)
    end
    if cfg.Tracer and (not cfg._tracers[model] or not cfg._tracers[model].adornment) then
        espMakeTracer(model, cfg)
    end

    -- Text label
    local bb = cfg._billboards[model]
    if bb and bb.label then
        local parts = {}
        if cfg.Name then table.insert(parts, model.Name) end
        if cfg.Distance then table.insert(parts, "[" .. math.floor(dist) .. " studs]") end
        bb.label.Text = table.concat(parts, "\n")
        bb.label.TextColor3 = cfg.TextColor
        bb.gui.MaxDistance = cfg.MaxDistance or 500
    end

    -- Health bar
    if bb and bb.healthGui and bb.healthFill and hum then
        local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        bb.healthFill.Size = UDim2.new(ratio, 0, 1, 0)
        if ratio > 0.66 then
            bb.healthFill.BackgroundColor3 = Color3.fromRGB(0, 220, 60)
        elseif ratio > 0.33 then
            bb.healthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
        else
            bb.healthFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
        end
        bb.healthGui.MaxDistance = cfg.MaxDistance or 500
    end

    -- Tracer
    if cfg.Tracer and cfg._tracers[model] and cfg._tracers[model].adornment then
        cfg._tracers[model].adornment.Color3 = cfg.TracerColor
        espUpdateTracer(model, cfg)
    end

    -- Chams refresh colors
    if cfg._chams[model] then
        cfg._chams[model].FillColor = cfg.FillColor
        cfg._chams[model].OutlineColor = cfg.OutlineColor
        cfg._chams[model].FillTransparency = 1 - (cfg.FillAlpha or 0.5)
    end

    -- Box refresh colors
    if cfg._boxes[model] then
        cfg._boxes[model].Color3 = cfg.OutlineColor
    end
end

local function espScanCategory(folder, cfg, excludeSelf)
    if not folder then return end
    local seen = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            if not (excludeSelf and m == lp.Character) then
                seen[m] = true
                espUpdateModel(m, cfg)
            end
        end
    end
    for m in pairs(cfg._boxes) do if not seen[m] then espRemoveEntry(m, cfg) end end
    for m in pairs(cfg._chams) do if not seen[m] then espRemoveEntry(m, cfg) end end
    for m in pairs(cfg._billboards) do if not seen[m] then espRemoveEntry(m, cfg) end end
    for m in pairs(cfg._tracers) do if not seen[m] then espRemoveEntry(m, cfg) end end
end

