    if #gears == 0 then return false end

    local now = tick()
    if now - GEAR.LastFire < GEAR.FireInterval then return true end
    GEAR.LastFire = now

    for _, g in ipairs(gears) do
        local fired = false
        for _, re in ipairs(g:GetDescendants()) do
            if re:IsA("RemoteEvent") then
                local rn = normalizeName(re.Name)
