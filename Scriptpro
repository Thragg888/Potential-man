local HDT_Trigger
local HDT = {
    Enabled = false, AutoTrigger = true, Speed = 12, StopDistance = 2,
    DragDuration = 0.4, Cooldown = 27, MaxRange = 40,
    _dragId = 0, _dragging = false, _conn = nil,
    _lastFire = 0, _fireDebounce = 0.15, _cooldownUntil = 0,
}
local function startDrag(targetPart)
    if not targetPart or not targetPart.Parent then return end
    if hasHelplessEffect() then return end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if (targetPart.Position - hrp.Position).Magnitude <= HDT.StopDistance + 0.5 then return end
    HDT._dragId += 1
    local myId = HDT._dragId
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    HDT._dragging = true
    local saved = { walk = hum.WalkSpeed, jumpPower = hum.JumpPower, jumpHeight = hum.JumpHeight, auto = hum.AutoRotate }
    hum.WalkSpeed = 0
    pcall(function() hum.JumpPower = 0 end)
    pcall(function() hum.JumpHeight = 0 end)
    hum.AutoRotate = false
    local finished = false
    local function cleanup()
        if finished then return end
        finished = true
        if HDT._dragId ~= myId then return end
        HDT._dragging = false
        HDT._cooldownUntil = tick() + (HDT.Cooldown or 27)
        if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum and hum.Parent then
            pcall(function()
                hum.WalkSpeed = saved.walk
                hum.JumpPower = saved.jumpPower
                hum.JumpHeight = saved.jumpHeight
                hum.AutoRotate = saved.auto
            end)
        end
    end
    HDT._conn = RunService.Heartbeat:Connect(function(dt)
        if hasHelplessEffect() then cleanup(); return end
        if HDT._dragId ~= myId or not HDT._dragging then cleanup(); return end
        if not (char and char.Parent and targetPart and targetPart.Parent) then cleanup(); return end
        local myPos = hrp.Position
        local flat = Vector3.new(targetPart.Position.X, myPos.Y, targetPart.Position.Z)
        local delta = flat - myPos
        local dist = delta.Magnitude
        if dist <= HDT.StopDistance then cleanup(); return end
        local step = math.min(HDT.Speed * dt, dist - HDT.StopDistance)
        hrp.CFrame = CFrame.lookAt(myPos + delta.Unit * step, flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.delay(HDT.DragDuration or 0.4, function()
        if HDT._dragId == myId and HDT._dragging then cleanup() end
    end)
end
HDT_Trigger = function(force)
    if not force and not HDT.Enabled then return end
    if hasHelplessEffect() then return end
    if tick() < (HDT._cooldownUntil or 0) then return end
    if tick() - HDT._lastFire < HDT._fireDebounce then return end
    if HDT._dragging then return end
    local target = nearestKillerPart()
    if not target then return end
    local myRoot = getMyRoot()
    if myRoot then
        local d = (target.Position - myRoot.Position).Magnitude
        if d <= HDT.StopDistance + 0.5 then return end
        if d > HDT.MaxRange then return end
    end
    HDT._lastFire = tick()
    startDrag(target)
end
lp.CharacterAdded:Connect(function()
    HDT._dragId += 1; HDT._dragging = false; HDT._cooldownUntil = 0
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
end)

-- Block check (sound method)
local function performBlockCheck(killerModel)
    if not CFG.AutoBlockEnabled or not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return end

    local look = killerRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-4 then return end
    flat = flat.Unit

    local checkPart = Instance.new("Part")
    checkPart.Name = "SCPHubBlockCheck"
    checkPart.Anchored = true
    checkPart.CanCollide = false
    checkPart.CanTouch = false
    checkPart.CanQuery = false
    checkPart.Massless = true
    checkPart.CastShadow = false
    checkPart.Material = Enum.Material.Neon
    checkPart.Size = Vector3.new(FacingVisual.BoxWidth, FacingVisual.BoxHeight, FacingVisual.BoxLength)
    checkPart.CFrame = CFrame.lookAt(
        killerRoot.Position + flat * (FacingVisual.BoxLength * 0.5),
        killerRoot.Position + flat * (FacingVisual.BoxLength * 0.5 + 1)
    )
    checkPart.Transparency = 1
    checkPart.Parent = workspace

    local inBox = false
    if lp.Character then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances = { lp.Character }
        local parts = workspace:GetPartsInPart(checkPart, params)
        inBox = #parts > 0
    end
    checkPart:Destroy()

    if inBox and CFG.WallCheck then
        local myRoot = getMyRoot()
        if myRoot then
            local delta = killerRoot.Position - myRoot.Position
            RAY_LOS.FilterDescendantsInstances = { lp.Character, killerModel }
            if workspace:Raycast(myRoot.Position, delta, RAY_LOS) then
                inBox = false
            end
        end
    end

    if inBox then
        fireBlock()
        if HDT and HDT.Enabled and HDT.AutoTrigger then
            task.spawn(function() pcall(function() HDT_Trigger(false) end) end)
        end
    end
end

-- Block check (animation method)
local function performAnimationBlockCheck(killer, attackType)
    if not CFG.AutoBlockEnabled or not CFG.AnimTrigger then return end
    if not isSurvivor() then return end
    if hasHelplessEffect() then return end
    if not killer or not killer.Parent then return end

    local hum = killer:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local queryHitbox = killer:FindFirstChild("QueryHitbox")
    if not queryHitbox then return end

    local custom = CUSTOM_HITBOXES[attackType]
    local boxSize = custom and custom.Size or Vector3.new(5.2, 6, 5.65)
    local boxOffset = custom and custom.Offset or CFrame.new(0, 0, -3.5)

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.MaxParts = 1

    for _ = 1, 12 do
        if hasHelplessEffect() then return end
        if not lp.Character then return end
        local myHitbox = lp.Character:FindFirstChild("QueryHitbox")
        if not myHitbox then return end
        params.FilterDescendantsInstances = { myHitbox }

        local part = Instance.new("Part")
        part.Name = "SCPHubAttackCheck"
        part.Anchored = true
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.CastShadow = false
        part.Material = Enum.Material.ForceField
        part.Size = boxSize * 2.2
        part.CFrame = queryHitbox.CFrame * boxOffset
        part.Transparency = 1
        part.Parent = workspace

        local hits = workspace:GetPartsInPart(part, params)
        part:Destroy()

        if #hits > 0 then
            fireBlock()
            if HDT and HDT.Enabled and HDT.AutoTrigger then
                task.spawn(function() pcall(function() HDT_Trigger(false) end) end)
            end
            return
        end
        task.wait(0.02)
    end
end

