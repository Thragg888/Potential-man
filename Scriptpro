    local function qteInstanceHook()
        if QTE._hooked then return true end
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local k = assets and assets:FindFirstChild("Killers")
        local az = k and k:FindFirstChild("Azure")
        local cfg = az and az:FindFirstChild("Config")
        local cl = cfg and cfg:FindFirstChild("cl_WorkaroundModules")
        local mod = cl and cl:FindFirstChild("cl_ConstructQTE")
        if not mod then return false end
        local ok, res = pcall(require, mod)
        if not ok or type(res) ~= "table" or type(res.new) ~= "function" then return false end
        local oldNew = res.new
        res.new = function(a, b)
            local obj = oldNew(a, b)
            if obj then
                if QTE.Infinite then pcall(function() obj.FailedAttempts = -math.huge end) end
                if QTE.Auto and QTE.Method == "Instance" then
                    task.defer(function()
                        task.wait(0.12)
                        if QTE.Auto and QTE.Method == "Instance" and obj and type(obj.AddProgress) == "function" then
                            pcall(function() obj:AddProgress(100) end)
                        end
                    end)
                end
            end
            return obj
        end
        QTE._hooked = true
        return true
    end

