local function addSlider(tab, title, min, max, default, callback)
    local row = addRow(tab, title, 42)
    local vl = Instance.new("TextLabel")
    vl.BackgroundTransparency = 1
    vl.Font = Enum.Font.Gotham
    vl.TextSize = 11
    vl.TextColor3 = COL.textDim
    vl.TextXAlignment = Enum.TextXAlignment.Right
    vl.Text = tostring(default)
    vl.Position = UDim2.new(1, -56, 0, 6)
    vl.Size = UDim2.fromOffset(46, 16)
    vl.ZIndex = 2
    vl.Parent = row

    local track = Instance.new("TextButton")
    track.Position = UDim2.new(0, 10, 0, 26)
    track.Size = UDim2.new(1, -20, 0, 6)
    track.BackgroundColor3 = COL.trackOff
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = 3
    track.Parent = row
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1,0); tc.Parent = track
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / math.max(max - min, 0.001), 0, 1, 0)
    fill.BackgroundColor3 = COL.accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 4
    fill.Parent = track
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1,0); fc.Parent = fill

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local cur = min + (max - min) * pct
            cur = math.floor(cur * 100 + 0.5) / 100
            fill.Size = UDim2.new(pct, 0, 1, 0)
            vl.Text = tostring(cur)
            if callback then pcall(callback, cur) end
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
