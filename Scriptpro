            Sprinting.MaxStamina = STAM.SEMI_MAX
            Sprinting.StaminaLoss = STAM.SEMI_LOSS
            Sprinting.StaminaGain = STAM.SEMI_GAIN
            Sprinting.SprintSpeed = STAM.SEMI_SPRINT
            Sprinting.StaminaLossDisabled = false
        end)
    elseif mode == "Infinite" then
        stamStopInfinite()
        STAM._lossBackup = Sprinting.StaminaLossDisabled
        pcall(function() Sprinting.StaminaLossDisabled = true end)
        STAM._thread = task.spawn(function()
            while STAM.Mode == "Infinite" do
