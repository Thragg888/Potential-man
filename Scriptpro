    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = part
    FacingVisual.flashes[killer] = {
        part      = part,
        highlight = hl,
        expiresAt = tick() + (FacingVisual.FlashDuration or 0.4),
    }
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        local now = tick()
        for killer, f in pairs(FacingVisual.flashes) do
            local part = f.part
            if not part or not part.Parent or not killer.Parent then
                removeFlash(killer)
            elseif now >= f.expiresAt then
                removeFlash(killer)
            else
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if not hrp then removeFlash(killer) else
                    local look = hrp.CFrame.LookVector
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude >= 1e-4 then
                        flat = flat.Unit
                        part.CFrame = CFrame.lookAt(hrp.Position - flat * FacingVisual.FlashOffset, hrp.Position)
                    end
                    local remaining = f.expiresAt - now
                    local life = math.max(FacingVisual.FlashDuration or 0.4, 0.01)
                    local alpha = math.clamp(remaining / life, 0, 1)
                    f.highlight.FillTransparency    = 0.6 + (1 - 0.6) * (1 - alpha) * 0.9
                    f.highlight.OutlineTransparency = (1 - alpha) * 0.9
                end
            end
        end
    end
end)

