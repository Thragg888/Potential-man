-- Attack map
local BLOCKABLE_ATTACKS = { ["slash"]=true,["enragedslash"]=true,["stab"]=true,
    ["attack"]=true,["punch"]=true,["swing"]=true,["golemslash"]=true }
local CUSTOM_HITBOXES = { ["golemslash"]={Size=Vector3.new(6,2,7),Offset=CFrame.new(0,0,-5.5)} }
local ATTACK_ANIM_MAP = {}
local function collectAnimIds(v, out)
    if type(v) == "string" then local id = v:match("(%d+)"); if id then out[#out+1] = id end
    elseif type(v) == "number" then out[#out+1] = tostring(v)
    elseif type(v) == "table" then for _, x in pairs(v) do collectAnimIds(x, out) end end
end
local function buildAttackAnimMap()
    local assets = ReplicatedStorage:FindFirstChild("Assets"); if not assets then return end
    local killers = assets:FindFirstChild("Killers"); if not killers then return end
    for _, km in ipairs(killers:GetChildren()) do
        local cfg = km:FindFirstChild("Config")
        if cfg and cfg:IsA("ModuleScript") then
            local ok, data = pcall(require, cfg)
            if ok and type(data) == "table" then
                local anims = data.Animations or (data.Config and data.Config.Animations)
                if type(anims) == "table" then
                    for k, av in pairs(anims) do
                        local key = tostring(k):lower()
                        if BLOCKABLE_ATTACKS[key] then
                            local ids = {}; collectAnimIds(av, ids)
                            for _, id in ipairs(ids) do ATTACK_ANIM_MAP[id] = key end
                        end
                    end
                end
            end
        end
    end
end
