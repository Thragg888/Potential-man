local Sprinting = nil
pcall(function() Sprinting = require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)
local STAM = {
    Mode = "Regular", orig = nil,
    SEMI_MAX = 150, SEMI_LOSS = 4, SEMI_GAIN = 40, SEMI_SPRINT = 28,
    _thread = nil, _lossBackup = nil,
}
local function stamSnapshot()
    if not Sprinting or STAM.orig then return end
    STAM.orig = {
        MaxStamina = Sprinting.MaxStamina, StaminaLoss = Sprinting.StaminaLoss,
        StaminaGain = Sprinting.StaminaGain, SprintSpeed = Sprinting.SprintSpeed,
        StaminaLossDisabled = Sprinting.StaminaLossDisabled,
    }
end
local function stamStopInfinite()
    if STAM._thread then task.cancel(STAM._thread); STAM._thread = nil end
    if Sprinting and STAM._lossBackup ~= nil then
        pcall(function() Sprinting.StaminaLossDisabled = STAM._lossBackup end)
        STAM._lossBackup = nil
    end
end
local function stamSetMode(mode)
    STAM.Mode = mode
    if not Sprinting then return end
    if mode == "Regular" then
        stamStopInfinite()
        if STAM.orig then
            pcall(function()
                if STAM.orig.MaxStamina ~= nil then Sprinting.MaxStamina = STAM.orig.MaxStamina end
                if STAM.orig.StaminaLoss ~= nil then Sprinting.StaminaLoss = STAM.orig.StaminaLoss end
                if STAM.orig.StaminaGain ~= nil then Sprinting.StaminaGain = STAM.orig.StaminaGain end
                if STAM.orig.SprintSpeed ~= nil then Sprinting.SprintSpeed = STAM.orig.SprintSpeed end
                if STAM.orig.StaminaLossDisabled ~= nil then Sprinting.StaminaLossDisabled = STAM.orig.StaminaLossDisabled end
            end)
        end
    elseif mode == "Semi cheats" then
        stamStopInfinite()
        pcall(function()
            Sprinting.MaxStamina = STAM.SEMI_MAX
            Sprinting.StaminaLoss = STAM.SEMI_LOSS
            Sprinting.StaminaGain = STAM.SEMI_GAIN
            Sprinting.SprintSpeed = STAM.SEMI_SPRINT
            Sprinting.StaminaLossDisabled = false
        end)
    elseif mode == "Infinite" then
        stamStopInfinite()
        STAM._lossBackup = Sprinting.StaminaLossDisabled
        pcall(function() Sprinting.StaminaLossDisabled = true end)
        STAM._thread = task.spawn(function()
            while STAM.Mode == "Infinite" do
                pcall(function()
                    Sprinting.StaminaLossDisabled = true
                    if Sprinting.Stamina ~= nil and Sprinting.MaxStamina then Sprinting.Stamina = Sprinting.MaxStamina end
                end)
                task.wait(0.15)
            end
        end)
    end
end
if Sprinting then stamSnapshot() end

